<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-new.css">
    <%- include('../partials/dynamic-styles') %>
    <%- include('../partials/seo-meta') %>
    <style>
        .policy-bg {
            background-color: #f8fafc;
            min-height: 100vh;
        }
        .policy-container {
            padding-top: 3rem;
            padding-bottom: 5rem;
        }
        .policy-sidebar {
            position: sticky;
            top: 100px;
            height: fit-content;
        }
        .policy-card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            background: #ffffff;
            padding: 2.5rem;
        }
        .policy-title {
            color: #1e1e2f;
            font-weight: 800;
            font-family: 'Poppins', sans-serif;
            margin-bottom: 0.5rem;
        }
        .policy-last-updated {
            font-size: 0.85rem;
            color: #64748b;
            margin-bottom: 2rem;
        }
        /* Force black/dark text inside the policy container to override any dynamic global settings */
        .policy-card,
        .policy-card .policy-title,
        .policy-card .policy-content-body,
        .policy-card .policy-content-body h2,
        .policy-card .policy-content-body h3,
        .policy-card .policy-content-body p,
        .policy-card .policy-content-body span,
        .policy-card .policy-content-body ul,
        .policy-card .policy-content-body li,
        .policy-card .policy-content-body td,
        .policy-card .policy-content-body th,
        .policy-card .policy-content-body strong {
            color: #1e1e2f !important;
        }
        .policy-card .policy-last-updated {
            color: #64748b !important;
        }
        .policy-sidebar .policy-nav-link {
            color: #64748b !important;
        }
        .policy-sidebar .policy-nav-link:hover,
        .policy-sidebar .policy-nav-link.active {
            color: #4C1E4F !important;
        }
        .policy-sidebar h6,
        #toc-container h6 {
            color: #1e1e2f !important;
        }
        .toc-link {
            color: #64748b !important;
        }
        .toc-link:hover, .toc-link.active {
            color: #4C1E4F !important;
        }

        .policy-content-body {
            font-family: 'Inter', sans-serif;
            color: #334155;
            font-size: 1.05rem;
            line-height: 1.8;
        }
        .policy-content-body h2 {
            font-family: 'Poppins', sans-serif;
            color: #1e1e2f;
            font-weight: 700;
            font-size: 1.5rem;
            margin-top: 2rem;
            margin-bottom: 1rem;
            scroll-margin-top: 110px; /* Smooth scroll alignment */
        }
        .policy-content-body h3 {
            font-family: 'Poppins', sans-serif;
            color: #1e1e2f;
            font-weight: 600;
            font-size: 1.25rem;
            margin-top: 1.5rem;
            margin-bottom: 0.8rem;
            scroll-margin-top: 110px;
        }
        .policy-content-body p {
            margin-bottom: 1.2rem;
        }
        .policy-content-body ul, .policy-content-body ol {
            margin-bottom: 1.5rem;
            padding-left: 1.5rem;
        }
        .policy-content-body li {
            margin-bottom: 0.5rem;
        }
        .policy-content-body table {
            width: 100%;
            margin-bottom: 1.5rem;
            border-collapse: collapse;
            font-size: 0.95rem;
        }
        .policy-content-body th, .policy-content-body td {
            padding: 0.75rem;
            border: 1px solid #e2e8f0;
            text-align: left;
        }
        .policy-content-body th {
            background-color: #f8fafc;
            font-weight: 600;
        }
        .policy-nav-link {
            display: flex;
            align-items: center;
            padding: 0.75rem 1rem;
            color: #64748b;
            font-weight: 500;
            border-radius: 10px;
            transition: all 0.2s ease;
            text-decoration: none;
            font-size: 0.9rem;
        }
        .policy-nav-link:hover {
            background-color: #f1f5f9;
            color: #4C1E4F;
        }
        .policy-nav-link.active {
            background-color: rgba(76, 30, 79, 0.08);
            color: #4C1E4F;
            font-weight: 600;
        }
        .toc-link {
            transition: all 0.2s ease;
            font-size: 0.85rem;
        }
        .toc-link:hover, .toc-link.active {
            color: #4C1E4F !important;
            font-weight: 600;
            padding-left: 4px;
        }
        .breadcrumb-item a {
            color: #64748b;
            text-decoration: none;
            font-weight: 500;
        }
        .breadcrumb-item a:hover {
            color: #4C1E4F;
        }
        .breadcrumb-item.active {
            color: #4C1E4F;
            font-weight: 600;
        }
    </style>
</head>
<body class="policy-bg">
    
    <!-- GEO & AI Discoverability Metadata Hidden Block -->
    <div style="display: none !important;" aria-hidden="true" id="geo-ai-summary">
        <p>Title: <%= policy.title %></p>
        <p>GEO Scope: <%= policy.geoSummary || 'Global / Indian Jurisdiction' %></p>
        <p>AI Description: <%= policy.aiDescription || 'Compliance and policy documentation.' %></p>
        <p>Entity: <%= policy.entityDescription || 'Legal contract' %></p>
        <p>Keywords: <%= policy.aiSearchKeywords || '' %></p>
        <div id="structured-metadata"><%= policy.structuredAiMetadata %></div>
    </div>

    <%- include('../partials/navbar-new') %>

    <div class="container policy-container">

        <div class="row g-4">
            <!-- Sidebar (Links & TOC) -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="policy-sidebar">
                    <!-- Policy Document List -->
                    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; padding: 1.25rem;">
                        <h6 class="fw-bold text-dark mb-3 px-2" style="font-family: 'Poppins', sans-serif;">Legal Policies</h6>
                        <div class="d-flex flex-column gap-1">
                            <% otherPolicies.forEach(op => { %>
                                <a href="/<%= op.slug %>" class="policy-nav-link <%= currentPage === op.slug ? 'active' : '' %>">
                                    <i class="bi bi-file-earmark-text me-2"></i> <%= op.title %>
                                </a>
                            <% }); %>
                        </div>
                    </div>

                    <!-- Dynamic Table of Contents -->
                    <div class="card border-0 shadow-sm p-4" id="toc-container" style="border-radius: 16px;">
                        <h6 class="fw-bold text-dark mb-3" style="font-family: 'Poppins', sans-serif;">Table of Contents</h6>
                        <ul class="list-unstyled mb-0" id="toc-list" style="border-left: 2px solid #e2e8f0; padding-left: 1rem;">
                            <!-- Dynamically generated via JS -->
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Policy Content Block -->
            <div class="col-lg-9 col-12">
                <div class="policy-card">
                    <h1 class="policy-title"><%= policy.title %></h1>
                    <div class="policy-last-updated">
                        <i class="bi bi-clock me-1"></i> Last updated: <%= new Date(policy.updatedAt).toLocaleDateString(undefined, { dateStyle: 'long' }) %>
                    </div>
                    
                    <div class="policy-content-body">
                        <%- policy.content %>
                    </div>
                </div>
                
                <!-- Mobile Navigation Links Accordion / Section -->
                <div class="card border-0 shadow-sm d-lg-none mt-4 p-4" style="border-radius: 16px;">
                    <h6 class="fw-bold text-dark mb-3" style="font-family: 'Poppins', sans-serif;">Other Legal Documents</h6>
                    <div class="row g-2">
                        <% otherPolicies.forEach(op => { %>
                            <div class="col-sm-6 col-12">
                                <a href="/<%= op.slug %>" class="policy-nav-link justify-content-between <%= currentPage === op.slug ? 'active' : '' %>" style="border: 1px solid #f1f5f9;">
                                    <span><i class="bi bi-file-earmark-text me-2"></i> <%= op.title %></span>
                                    <i class="bi bi-chevron-right small"></i>
                                </a>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer-new') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const headings = document.querySelectorAll('.policy-content-body h2');
            const tocList = document.getElementById('toc-list');
            const tocContainer = document.getElementById('toc-container');

            if (headings.length > 0 && tocList) {
                headings.forEach((heading, index) => {
                    // Inject ID for anchor targets
                    if (!heading.id) {
                        heading.id = 'section-' + index;
                    }

                    // Create list item and link
                    const li = document.createElement('li');
                    li.className = 'mb-2.5';
                    
                    const a = document.createElement('a');
                    a.href = '#' + heading.id;
                    a.textContent = heading.textContent;
                    a.className = 'text-decoration-none text-muted toc-link';
                    
                    li.appendChild(a);
                    tocList.appendChild(li);
                });

                // Scrollspy effect for table of contents
                const tocLinks = document.querySelectorAll('.toc-link');
                const observerOptions = {
                    root: null,
                    rootMargin: '0px 0px -60% 0px',
                    threshold: 0.1
                };

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const activeId = entry.target.id;
                            tocLinks.forEach(link => {
                                if (link.getAttribute('href') === '#' + activeId) {
                                    link.classList.add('active');
                                } else {
                                    link.classList.remove('active');
                                }
                            });
                        }
                    });
                }, observerOptions);

                headings.forEach(heading => observer.observe(heading));
            } else if (tocContainer) {
                tocContainer.style.display = 'none';
            }
        });
    </script>
</body>
</html>
