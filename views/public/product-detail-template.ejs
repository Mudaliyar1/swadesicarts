<%- include('../partials/footer-new') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const modalEl = document.getElementById('inquiryAuthModal');
        if (!modalEl) return;
        
        const isUserLoggedIn = modalEl.dataset.isLoggedIn === 'true';
        const inquireBtn = document.querySelector('.sc-btn-inquire');
        
        if (inquireBtn && !isUserLoggedIn) {
            inquireBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const authModal = new bootstrap.Modal(modalEl);
                authModal.show();
            });
        }

        const optLoginFirst = document.getElementById('optLoginFirst');
        if (optLoginFirst) {
            optLoginFirst.addEventListener('click', function() {
                const targetUrl = optLoginFirst.getAttribute('data-redirect-url');
                if (targetUrl) window.location.href = targetUrl;
            });
        }

        const optDirectInquiry = document.getElementById('optDirectInquiry');
        if (optDirectInquiry) {
            optDirectInquiry.addEventListener('click', function() {
                const targetUrl = optDirectInquiry.getAttribute('data-redirect-url');
                if (targetUrl) window.location.href = targetUrl;
            });
        }

        // Auto-trigger Success or Error modals if they exist in the DOM
        const successModalEl = document.getElementById('successNotificationModal');
        if (successModalEl) {
            const successModal = new bootstrap.Modal(successModalEl);
            successModal.show();
        }

        const errorModalEl = document.getElementById('errorNotificationModal');
        if (errorModalEl) {
            const errorModal = new bootstrap.Modal(errorModalEl);
            errorModal.show();
        }

        // Interactive Star Rating Selector
        const stars = document.querySelectorAll('.rating-star');
        const ratingInput = document.getElementById('ratingInput');
        if (stars.length > 0 && ratingInput) {
            stars.forEach(star => {
                star.addEventListener('click', function() {
                    const value = parseInt(star.getAttribute('data-value'));
                    ratingInput.value = value;
                    stars.forEach((s, idx) => {
                        if (idx < value) {
                            s.classList.remove('bi-star');
                            s.classList.add('bi-star-fill');
                        } else {
                            s.classList.remove('bi-star-fill');
                            s.classList.add('bi-star');
                        }
                    });
                });
            });
        }

        // Form Submit Validation for Star Rating
        const reviewForm = document.querySelector('form[action="/reviews"]');
        if (reviewForm && ratingInput) {
            reviewForm.addEventListener('submit', function(e) {
                if (!ratingInput.value) {
                    e.preventDefault();
                    alert('Please select a star rating before submitting your review!');
                }
            });
        }

        // Edit Review Modal Populate & Interaction Logic
        const editReviewBtns = document.querySelectorAll('.edit-review-btn');
        const editReviewModalEl = document.getElementById('editReviewModal');
        if (editReviewBtns.length > 0 && editReviewModalEl) {
            const editReviewModal = new bootstrap.Modal(editReviewModalEl);
            const editReviewIdInput = document.getElementById('editReviewId');
            const editReviewCommentInput = document.getElementById('editReviewComment');
            const editRatingInput = document.getElementById('editRatingInput');
            const editStars = document.querySelectorAll('.edit-rating-star');
            
            editReviewBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const reviewId = btn.getAttribute('data-review-id');
                    const comment = btn.getAttribute('data-comment');
                    const rating = parseInt(btn.getAttribute('data-rating')) || 5;
                    
                    editReviewIdInput.value = reviewId;
                    editReviewCommentInput.value = comment;
                    editRatingInput.value = rating;
                    
                    // Highlight stars inside the edit modal
                    editStars.forEach((s, idx) => {
                        if (idx < rating) {
                            s.classList.remove('bi-star');
                            s.classList.add('bi-star-fill');
                        } else {
                            s.classList.remove('bi-star-fill');
                            s.classList.add('bi-star');
                        }
                    });
                    
                    // If open from inside another modal (like allReviewsModal), hide it first
                    const allReviewsModalEl = document.getElementById('allReviewsModal');
                    if (allReviewsModalEl) {
                        const allReviewsModal = bootstrap.Modal.getInstance(allReviewsModalEl);
                        if (allReviewsModal) allReviewsModal.hide();
                    }
                    
                    editReviewModal.show();
                });
            });

            // Interactive Star Selector for Edit Modal
            editStars.forEach(star => {
                star.addEventListener('click', function() {
                    const value = parseInt(star.getAttribute('data-value'));
                    editRatingInput.value = value;
                    editStars.forEach((s, idx) => {
                        if (idx < value) {
                            s.classList.remove('bi-star');
                            s.classList.add('bi-star-fill');
                        } else {
                            s.classList.remove('bi-star-fill');
                            s.classList.add('bi-star');
                        }
                    });
                });
            });
        }
    });
</script>
</body>
</html>
