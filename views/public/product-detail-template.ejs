<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/seo-meta') %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Poppins:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-new.css">

    <style>
    /* =========================================================
       SWADESI CARTS — PRODUCT DETAIL PAGE  v3  (2026 Premium)
       ========================================================= */

    /* 1. HARD RESET: Kill the admin heading colour override on this page */
    .sc-pd h1,
    .sc-pd h2,
    .sc-pd h3,
    .sc-pd h4,
    .sc-pd h5,
    .sc-pd h6,
    .sc-pd .sc-title,
    .sc-pd .sc-section-label {
        color: #111 !important;
        font-family: 'Poppins', sans-serif !important;
    }
    .sc-pd p,
    .sc-pd li,
    .sc-pd span:not(.badge):not(.sc-tag):not(.sc-price-val):not(.sc-cert):not(.sc-stock) {
        color: #444 !important;
    }

    /* 2. PAGE SHELL */
    .sc-pd {
        background: #f6f4f0;
        min-height: 100vh;
        padding-bottom: 4rem;
        padding-top: 18px; /* buffer for announcement bar above fixed navbar */
    }

    /* 3. BREADCRUMB BAR */
    .sc-breadbar {
        background: transparent;
        padding: 0.7rem 0 0.4rem;
        font-size: 0.78rem;
        position: relative;
        z-index: 10;
        font-weight: 500;
    }
    .sc-breadbar .breadcrumb { margin: 0; flex-wrap: nowrap; overflow: hidden; background: none; }
    .sc-breadbar .breadcrumb-item + .breadcrumb-item::before { content: '›'; color: #bbb !important; }
    /* Nuclear override — must beat navbar-new.ejs specificity */
    div.sc-breadbar a,
    div.sc-breadbar a:not(.btn),
    div.sc-breadbar .breadcrumb-item a {
        color: #4C1E4F !important;
        text-decoration: none !important;
        font-weight: 600 !important;
    }
    div.sc-breadbar a:hover,
    div.sc-breadbar .breadcrumb-item a:hover { text-decoration: underline !important; }
    div.sc-breadbar .breadcrumb-item,
    div.sc-breadbar .breadcrumb-item.active,
    div.sc-breadbar li {
        color: #888 !important;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
    }

    /* 4. MOBILE-ONLY HERO HEADER (above image on phones) */
    .sc-mob-header {
        padding: 1.2rem 0 0.75rem;
    }
    .sc-mob-header .sc-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: var(--primary, #4C1E4F);
        color: #fff !important;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 0.25rem 0.7rem;
        border-radius: 999px;
        margin-bottom: 0.6rem;
    }
    .sc-mob-header h1 {
        font-size: clamp(1.25rem, 5vw, 1.55rem);
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.3px;
        margin-bottom: 0.4rem;
    }
    .sc-mob-header .sc-tagline {
        font-size: 0.85rem;
        line-height: 1.55;
        color: #666 !important;
        margin: 0;
    }
    @media (min-width: 992px) { .sc-mob-header { display: none; } }

    /* 5. MEDIA BLOCK */
    .sc-media-card {
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 4px 30px rgba(0,0,0,0.07);
    }
    @media (min-width: 992px) {
        .sc-media-sticky { position: sticky; top: 82px; }
    }

    /* 6. INFO COLUMN — DESKTOP HEADER */
    .sc-desk-header { display: none; }
    @media (min-width: 992px) {
        .sc-desk-header { display: block; padding-bottom: 1rem; }
        .sc-desk-header .sc-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            background: var(--primary, #4C1E4F);
            color: #fff !important;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            margin-bottom: 0.75rem;
        }
        .sc-desk-header h1 {
            font-size: 2.1rem;
            font-weight: 800;
            line-height: 1.2;
            letter-spacing: -0.5px;
            margin-bottom: 0.5rem;
        }
        .sc-desk-header .sc-tagline {
            font-size: 0.95rem;
            line-height: 1.6;
            color: #666 !important;
            max-width: 42ch;
        }
    }

    /* 7. PRICE + STOCK CARD */
    .sc-price-card {
        background: #fff;
        border: 1.5px solid rgba(76,30,79,0.12);
        border-radius: 18px;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1rem;
        box-shadow: 0 2px 12px rgba(76,30,79,0.06);
    }

    .sc-price-label {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #999 !important;
        margin-bottom: 0.15rem;
    }
    .sc-price-val {
        font-family: 'Poppins', sans-serif;
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--primary, #4C1E4F) !important;
        line-height: 1;
        letter-spacing: -1px;
    }
    .sc-price-unit-text {
        font-size: 0.75rem;
        color: #aaa !important;
        font-weight: 500;
        margin-top: 0.15rem;
    }
    .sc-divider-v {
        width: 1px;
        height: 40px;
        background: #e5e7eb;
        flex-shrink: 0;
    }
    .sc-stock {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
    }
    .sc-stock.in  { background: #f0fdf4; color: #15803d !important; border: 1px solid #bbf7d0; }
    .sc-stock.out { background: #fff7ed; color: #c2410c !important; border: 1px solid #fed7aa; }
    .sc-moq-note {
        font-size: 0.73rem;
        color: #aaa !important;
        width: 100%;
        margin: 0;
        display: flex;
        align-items: flex-start;
        gap: 0.35rem;
    }

    /* 8. CTA ROW — the fixed button layout */
    .sc-cta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.6rem;
        margin-bottom: 1rem;
    }
    .sc-cta-grid .sc-btn-back {
        grid-column: 1 / -1; /* full width */
    }
    @media (min-width: 576px) {
        .sc-cta-grid {
            grid-template-columns: 1fr 1fr auto;
        }
        .sc-cta-grid .sc-btn-back {
            grid-column: auto;
        }
    }

    .sc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        font-size: 0.88rem;
        font-weight: 700;
        padding: 0.8rem 1rem;
        border-radius: 14px;
        border: none;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
        white-space: nowrap;
    }
    .sc-btn:hover { transform: translateY(-2px); }

    .sc-btn-inquire {
        background: var(--primary, #4C1E4F);
        color: #fff !important;
        box-shadow: 0 4px 18px rgba(76,30,79,0.22);
    }
    .sc-btn-inquire:hover {
        background: #3a1640;
        box-shadow: 0 8px 24px rgba(76,30,79,0.32);
        color: #fff !important;
    }
    .sc-btn-wa {
        background: #25D366;
        color: #fff !important;
        box-shadow: 0 4px 18px rgba(37,211,102,0.22);
    }
    .sc-btn-wa:hover {
        background: #1cb857;
        box-shadow: 0 8px 24px rgba(37,211,102,0.32);
        color: #fff !important;
    }
    .sc-btn-back {
        background: #fff;
        color: #555 !important;
        border: 1.5px solid #e0e0e0;
        box-shadow: none;
        padding: 0.75rem 1.1rem;
    }
    .sc-btn-back:hover {
        border-color: var(--primary, #4C1E4F);
        color: var(--primary, #4C1E4F) !important;
        box-shadow: none;
    }

    /* 9. CONTENT PANELS */
    .sc-panel {
        background: #fff;
        border-radius: 18px;
        border: 1px solid rgba(0,0,0,0.06);
        margin-bottom: 0.85rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        transition: box-shadow 0.2s ease;
    }
    .sc-panel:hover { box-shadow: 0 4px 24px rgba(0,0,0,0.08); }
    .sc-panel-head {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.9rem 1.25rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        background: #fafafa;
    }
    .sc-panel-head-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: var(--primary, #4C1E4F);
        color: #fff;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .sc-panel-title {
        font-size: 0.8rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.8px !important;
        text-transform: uppercase !important;
        color: #111 !important;
        margin: 0 !important;
        font-family: 'Poppins', sans-serif !important;
    }
    .sc-panel-body { padding: 1.1rem 1.25rem; }
    .sc-panel-body p {
        font-size: 0.88rem;
        line-height: 1.8;
        color: #444 !important;
        margin-bottom: 0.75rem;
    }
    .sc-panel-body p:last-child { margin-bottom: 0; }

    /* 10. FEATURE / BENEFIT LIST */
    .sc-feat-list { list-style: none; margin: 0; padding: 0; }
    .sc-feat-list li {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        padding: 0.55rem 0;
        border-bottom: 1px solid #f3f3f3;
        font-size: 0.87rem;
        color: #333 !important;
        line-height: 1.5;
    }
    .sc-feat-list li:last-child { border-bottom: none; }
    .sc-feat-icon {
        color: #22c55e !important;
        font-size: 1.05rem;
        margin-top: 0.06rem;
        flex-shrink: 0;
    }

    /* 11. CERTIFICATIONS */
    .sc-certs { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .sc-cert {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: linear-gradient(135deg, #f0fdf4, #dcfce7);
        border: 1px solid #86efac;
        color: #15803d !important;
        font-size: 0.74rem;
        font-weight: 600;
        padding: 0.32rem 0.75rem;
        border-radius: 999px;
    }

    /* 12. FAQ */
    .sc-faq .accordion-item {
        background: transparent;
        border: none;
        border-bottom: 1px solid #f0f0f0;
    }
    .sc-faq .accordion-item:last-child { border-bottom: none; }
    .sc-faq .accordion-button {
        background: transparent;
        font-size: 0.86rem;
        font-weight: 600;
        color: #111 !important;
        padding: 0.9rem 0;
        box-shadow: none;
    }
    .sc-faq .accordion-button:not(.collapsed) { color: var(--primary, #4C1E4F) !important; }
    .sc-faq .accordion-body {
        font-size: 0.84rem;
        color: #666 !important;
        padding: 0 0 1rem;
        line-height: 1.75;
    }

    /* 13. SHARE ROW */
    .sc-share {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding-top: 0.5rem;
        flex-wrap: wrap;
    }
    .sc-share-label { font-size: 0.75rem; color: #bbb !important; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; }
    .sc-share-btn {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        border: 1.5px solid #e5e7eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        color: #666 !important;
        text-decoration: none;
        transition: all 0.18s ease;
    }
    .sc-share-btn:hover {
        border-color: var(--primary, #4C1E4F);
        color: var(--primary, #4C1E4F) !important;
        transform: translateY(-2px);
    }

    /* ---- small screen tweaks ---- */
    @media (max-width: 575.98px) {
        .sc-price-val { font-size: 1.5rem; }
        .sc-panel-body { padding: 0.9rem 1rem; }
        .sc-panel-head { padding: 0.75rem 1rem; }
        .sc-btn { font-size: 0.82rem; padding: 0.72rem 0.8rem; border-radius: 12px; }
    }
    </style>
</head>
<body>

<%- include('../partials/navbar-new') %>

<div class="sc-pd">

<%
  const pageBase = type === 'tech' ? '/tech-packages' : '/' + type + '-products';
  const siteBaseUrl = (siteSettings && siteSettings.siteUrl) || 'https://swadesicarts.in';
  const pageUrl = (seo && seo.canonical) ? seo.canonical : siteBaseUrl + pageBase + '/' + (product.slug || product._id);
  const productFaqs = [
    { question: `What is ${product.title}?`, answer: product.shortDescription || product.fullDescription || product.title },
    { question: `Who should use ${product.title}?`, answer: type === 'tech' ? 'Businesses and individuals looking for practical, reliable tech services.' : 'Customers looking for authentic, high-quality products.' },
    { question: 'How do I place an inquiry?', answer: 'Tap the Inquire Now or WhatsApp button on this page to request pricing, delivery info, and availability.' }
  ];
  let wsNum = (siteSettings && siteSettings.whatsapp && siteSettings.whatsapp.number) || (siteSettings && siteSettings.footer && siteSettings.footer.phone) || '';
  let wsNumClean = wsNum.replace(/\D/g, '');
  let priceInfo = '';
  if (type === 'tech' && product.price) { priceInfo = ` | Price: ${product.price.displayText || '₹' + product.price}`; }
  else if (product.price) { priceInfo = ` | Price: ₹${product.price}${product.priceUnit ? ' / ' + product.priceUnit : ''}`; }
  let wsMsg = `Hello! I am interested in *${product.title}* (${product.category})${priceInfo}.\n\n${product.shortDescription || ''}\n\n🔗 ${pageUrl}\n\nKindly share pricing, delivery, and availability. Thank you!`;
  let wsUrl = wsNumClean ? `https://wa.me/${wsNumClean}?text=${encodeURIComponent(wsMsg)}` : null;
  let inquiryPath = type === 'tech' ? '/tech-packages/inquiry' : '/' + type + '-products/inquiry';
  let backPath   = type === 'tech' ? '/tech-packages' : '/' + type + '-products';
  let typeLabel  = type === 'tech' ? 'Tech Packages' : type.charAt(0).toUpperCase() + type.slice(1) + ' Products';

  /* price display helpers */
  const showTechPrice  = type === 'tech' && product.price && product.price.displayText;
  const showOtherPrice = type !== 'tech' && product.price;
  const showMoq        = product.minOrderQuantity;
  const showStock      = product.inStock !== undefined;
  const hasPriceCard   = showTechPrice || showOtherPrice || showMoq || showStock;
%>

<!-- GEO AI (hidden) -->
<div style="display:none" aria-hidden="true" id="geo-ai-summary">
    <p>Entity: <%= product.title %></p><p>Category: <%= product.category %></p>
    <p>Type: <%= type === 'tech' ? 'Service/Package' : 'Product' %></p>
    <p>Summary: <%= product.geoSummary || '' %></p>
</div>

<!-- BREADCRUMB -->
<div class="sc-breadbar">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="<%= pageBase %>"><%= typeLabel %></a></li>
                <li class="breadcrumb-item active"><%= product.title %></li>
            </ol>
        </nav>
    </div>
</div>

<div class="container">

    <!-- Flash Messages (Alerts) -->
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mt-3" role="alert" style="border-radius: 12px; background-color: #d1e7dd; color: #0f5132; font-family: 'Inter', sans-serif;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div style="font-weight: 500;"><%= success %></div>
            </div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mt-3" role="alert" style="border-radius: 12px; background-color: #f8d7da; color: #842029; font-family: 'Inter', sans-serif;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div style="font-weight: 500;"><%= error %></div>
            </div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- ═══ MOBILE HEADER (phones only) ═══ -->
    <div class="sc-mob-header">
        <div class="sc-tag"><i class="bi bi-tag-fill"></i>&nbsp;<%= product.category %></div>
        <h1><%= product.title %></h1>
        <% if (product.shortDescription) { %>
            <p class="sc-tagline"><%= product.shortDescription %></p>
        <% } %>
    </div>

    <!-- ═══ MAIN GRID ═══ -->
    <div class="row g-4">

        <!-- LEFT COL — image -->
        <div class="col-12 col-lg-6">
            <div class="sc-media-sticky">
                <div class="sc-media-card">
                    <%- include('../partials/media-carousel', { gallery: product.gallery, featuredImage: product.featuredImage }) %>
                </div>
            </div>
        </div>

        <!-- RIGHT COL — info -->
        <div class="col-12 col-lg-6">

            <!-- Desktop header -->
            <div class="sc-desk-header">
                <div class="sc-tag"><i class="bi bi-tag-fill"></i>&nbsp;<%= product.category %></div>
                <h1><%= product.title %></h1>
                <% if (product.shortDescription) { %>
                    <p class="sc-tagline"><%= product.shortDescription %></p>
                <% } %>
            </div>

            <!-- ─── Price card ─── -->
            <% if (hasPriceCard) { %>
            <div class="sc-price-card">
                <% if (showTechPrice) { %>
                    <div class="sc-price-block">
                        <div class="sc-price-label">Starting Price</div>
                        <div class="sc-price-val"><%= product.price.displayText %></div>
                    </div>
                <% } else if (showOtherPrice) { %>
                    <div class="sc-price-block">
                        <div class="sc-price-label">Price</div>
                        <div class="sc-price-val">₹<%= product.price %></div>
                        <% if (product.priceUnit) { %>
                            <div class="sc-price-unit-text">per <%= product.priceUnit %></div>
                        <% } %>
                    </div>
                <% } %>

                <% if ((showTechPrice || showOtherPrice) && (showStock || showMoq)) { %>
                    <div class="sc-divider-v"></div>
                <% } %>

                <% if (showMoq) { %>
                    <div class="sc-price-block">
                        <div class="sc-price-label">Min. Order</div>
                        <div class="sc-price-val" style="font-size:1.3rem;color:#B5A886 !important;"><%= product.minOrderQuantity %><% if(product.minOrderUnit){ %>&nbsp;<small style="font-size:0.9rem"><%= product.minOrderUnit %></small><% } %></div>
                    </div>
                <% } %>

                <% if (showStock) { %>
                    <span class="sc-stock <%= product.inStock ? 'in' : 'out' %>">
                        <i class="bi <%= product.inStock ? 'bi-check-circle-fill' : 'bi-x-circle-fill' %>"></i>
                        <%= product.inStock ? 'In Stock' : 'Out of Stock' %>
                        <% if (product.inStock && product.stockQuantity != null) { %>
                            &middot; <%= product.stockQuantity %> left
                        <% } %>
                    </span>
                <% } %>

                <% if (showMoq) { %>
                    <p class="sc-moq-note"><i class="bi bi-info-circle"></i> For quantities below the minimum order, pricing may vary — contact us for a custom quote.</p>
                <% } %>
            </div>
            <% } %>

            <!-- ─── CTA Buttons ─── -->
            <div class="sc-cta-grid">
                <!-- Primary Inquiry Form Button (Always goes to inquiry page) -->
                <a href="<%= inquiryPath %>?productId=<%= product._id %>" class="sc-btn sc-btn-inquire">
                    <i class="bi bi-chat-dots-fill"></i> Inquire Now
                </a>

                <!-- WhatsApp Button (Only shows if number is configured) -->
                <% if (wsNumClean) { %>
                    <a href="<%= wsUrl %>" target="_blank" rel="noopener" class="sc-btn sc-btn-wa">
                        <i class="bi bi-whatsapp"></i> WhatsApp
                    </a>
                <% } %>

                <a href="<%= backPath %>" class="sc-btn sc-btn-back">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>

            <!-- ─── Description ─── -->
            <div class="sc-panel">
                <div class="sc-panel-head">
                    <div class="sc-panel-head-icon"><i class="bi bi-file-text"></i></div>
                    <span class="sc-panel-title">Description</span>
                </div>
                <div class="sc-panel-body">
                    <% const paras = (product.fullDescription || '').split(/\r?\n/).filter(l => l.trim()); %>
                    <% if (paras.length > 1) { paras.forEach(p => { %><p><%= p %></p><% }); } else { %>
                        <p><%= product.fullDescription %></p>
                    <% } %>
                </div>
            </div>

            <!-- ─── Benefits & Features ─── -->
            <% if (product.benefits && product.benefits.length > 0) { %>
            <div class="sc-panel">
                <div class="sc-panel-head">
                    <div class="sc-panel-head-icon"><i class="bi bi-stars"></i></div>
                    <span class="sc-panel-title">Benefits &amp; Features</span>
                </div>
                <div class="sc-panel-body" style="padding-top:0.4rem;padding-bottom:0.4rem;">
                    <ul class="sc-feat-list">
                        <% product.benefits.forEach(b => { %>
                            <li><i class="bi bi-check-circle-fill sc-feat-icon"></i><span><%= b %></span></li>
                        <% }); %>
                    </ul>
                </div>
            </div>
            <% } %>

            <!-- ─── Features (tech) ─── -->
            <% if (product.features && product.features.length > 0) { %>
            <div class="sc-panel">
                <div class="sc-panel-head">
                    <div class="sc-panel-head-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                    <span class="sc-panel-title">Features</span>
                </div>
                <div class="sc-panel-body" style="padding-top:0.4rem;padding-bottom:0.4rem;">
                    <ul class="sc-feat-list">
                        <% product.features.forEach(f => { %>
                            <li><i class="bi bi-check-circle-fill sc-feat-icon"></i><span><%= f %></span></li>
                        <% }); %>
                    </ul>
                </div>
            </div>
            <% } %>

            <!-- ─── Certifications ─── -->
            <% if (product.certifications && product.certifications.length > 0) { %>
            <div class="sc-panel">
                <div class="sc-panel-head">
                    <div class="sc-panel-head-icon"><i class="bi bi-patch-check-fill"></i></div>
                    <span class="sc-panel-title">Certifications</span>
                </div>
                <div class="sc-panel-body">
                    <div class="sc-certs">
                        <% product.certifications.forEach(c => { %>
                            <span class="sc-cert"><i class="bi bi-shield-check"></i><%= c.name %></span>
                        <% }); %>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- ─── FAQ ─── -->
            <div class="sc-panel sc-faq">
                <div class="sc-panel-head">
                    <div class="sc-panel-head-icon"><i class="bi bi-question-circle-fill"></i></div>
                    <span class="sc-panel-title">FAQs</span>
                </div>
                <div class="sc-panel-body" style="padding-top:0;padding-bottom:0;">
                    <div class="accordion accordion-flush" id="scFaq">
                        <% productFaqs.forEach((faq, i) => { %>
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button <%= i === 0 ? '' : 'collapsed' %>" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#scFaq-<%= i %>">
                                    <%= faq.question %>
                                </button>
                            </h2>
                            <div id="scFaq-<%= i %>" class="accordion-collapse collapse <%= i === 0 ? 'show' : '' %>" data-bs-parent="#scFaq">
                                <div class="accordion-body"><%= faq.answer %></div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>

            <!-- ─── Product Reviews ─── -->
            <div class="sc-panel">
                <div class="sc-panel-head d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="sc-panel-head-icon"><i class="bi bi-star-fill" style="color: #ffc107 !important;"></i></div>
                        <span class="sc-panel-title">Customer Reviews</span>
                    </div>
                    <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { 
                        const avg = reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length;
                    %>
                        <span class="badge bg-dark text-white rounded-pill px-2.5 py-1" style="font-size: 0.8rem; background-color: #111111 !important; color: #ffffff !important;">
                            <i class="bi bi-star-fill me-1" style="color: #ffc107 !important;"></i><%= avg.toFixed(1) %> / 5.0
                        </span>
                    <% } %>
                </div>
                <div class="sc-panel-body">
                    <!-- Reviews list -->
                    <div class="sc-reviews-list mb-4">
                        <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
                            <% const displayedReviews = reviews.slice(0, 3); %>
                            <% displayedReviews.forEach(r => { %>
                                <div class="pb-3 mb-3 border-bottom" style="border-color: rgba(0, 0, 0, 0.05) !important;">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div class="fw-bold" style="font-size: 0.9rem; color: #111111 !important;"><%= r.userName %></div>
                                        <div style="font-size: 0.8rem; color: #ffc107 !important;">
                                            <% for(let i = 1; i <= 5; i++) { %>
                                                <i class="bi bi-star<%= i <= r.rating ? '-fill' : '' %>"></i>
                                            <% } %>
                                        </div>
                                    </div>
                                    <p class="mb-1" style="font-size: 0.85rem; line-height: 1.4; color: #444444 !important; word-wrap: break-word !important; word-break: break-word !important; white-space: pre-wrap !important;"><%= r.comment %></p>
                                    <small style="font-size: 0.75rem; color: #777777 !important;"><%= r.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></small>
                                    <% if (typeof isUserLoggedIn !== 'undefined' && isUserLoggedIn && typeof userId !== 'undefined' && String(r.userId) === String(userId)) { %>
                                        <button type="button" class="btn btn-link text-primary p-0 border-0 fw-bold ms-3 edit-review-btn" 
                                                data-review-id="<%= r._id %>" 
                                                data-comment="<%= r.comment %>" 
                                                data-rating="<%= r.rating %>"
                                                style="font-size: 0.75rem; text-decoration: none; vertical-align: baseline;">
                                            Edit
                                        </button>
                                        <form action="/reviews/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete your review?');">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="reviewId" value="<%= r._id %>">
                                            <input type="hidden" name="productId" value="<%= product._id %>">
                                            <input type="hidden" name="productType" value="<%= type %>">
                                            <button type="submit" class="btn btn-link text-danger p-0 border-0 fw-bold ms-2" style="font-size: 0.75rem; text-decoration: none; vertical-align: baseline;">
                                                Delete
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            <% }); %>

                            <% if (reviews.length > 3) { %>
                                <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-dark w-100 text-center py-2" data-bs-toggle="modal" data-bs-target="#allReviewsModal" style="font-size: 0.88rem; color: #111111 !important;">
                                    See More Reviews (<%= reviews.length - 3 %> more) <i class="bi bi-chevron-down ms-1"></i>
                                </button>
                            <% } %>
                        <% } else { %>
                            <div class="text-center py-4" style="font-size: 0.9rem; color: #777777 !important;">
                                <i class="bi bi-chat-right-text fs-2 mb-2 d-block" style="color: #999999 !important;"></i>
                                No reviews yet. Be the first to review this product!
                            </div>
                        <% } %>
                    </div>

                    <!-- Review Form / Login prompt -->
                    <div class="p-3 rounded-3 border" style="border-color: rgba(0,0,0,0.06) !important; background-color: #fcfcfc !important;">
                        <% if (typeof isUserLoggedIn !== 'undefined' && isUserLoggedIn) { %>
                            <h6 class="fw-bold mb-3" style="font-family: 'Poppins', sans-serif; font-size: 0.95rem; color: #111111 !important;">Write a Review</h6>
                            <form action="/reviews" method="POST" novalidate>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="productId" value="<%= product._id %>">
                                <input type="hidden" name="productType" value="<%= type %>">
                                
                                <div class="mb-3">
                                    <label class="form-label fw-semibold" style="font-size: 0.8rem; color: #444444 !important;">Rating *</label>
                                    <div class="d-flex gap-2 fs-5" id="starRatingSelector" style="cursor: pointer; color: #ffc107 !important;">
                                        <i class="bi bi-star rating-star" data-value="1"></i>
                                        <i class="bi bi-star rating-star" data-value="2"></i>
                                        <i class="bi bi-star rating-star" data-value="3"></i>
                                        <i class="bi bi-star rating-star" data-value="4"></i>
                                        <i class="bi bi-star rating-star" data-value="5"></i>
                                    </div>
                                    <input type="hidden" name="rating" id="ratingInput" value="" required>
                                </div>

                                <div class="mb-3">
                                    <label for="reviewComment" class="form-label fw-semibold" style="font-size: 0.8rem; color: #444444 !important;">Comment *</label>
                                    <textarea class="form-control form-control-sm text-dark bg-white border" id="reviewComment" name="comment" rows="3" placeholder="Tell us about your experience with this product (maximum 1000 characters)..." style="font-size: 0.85rem; color: #111111 !important;" maxlength="1000" required></textarea>
                                </div>

                                <button type="submit" class="btn btn-dark btn-sm fw-bold px-3 py-2 w-100 rounded-3" style="background-color: #111111 !important; color: #ffffff !important; border: none !important;">
                                    Submit Review
                                </button>
                            </form>
                        <% } else { %>
                            <div class="text-center py-2">
                                <p class="mb-3" style="font-size: 0.82rem; line-height: 1.4; color: #444444 !important;">You must be logged in to rate and comment on this product.</p>
                                <a href="/login?redirect=<%= encodeURIComponent(pageUrl) %>" class="btn btn-outline-dark btn-sm fw-bold px-4 py-2 rounded-3" style="border-color: #111111 !important; color: #111111 !important;">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Log In to Review
                                </a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- ─── Share ─── -->
            <div class="sc-share">
                <span class="sc-share-label">Share</span>
                <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(pageUrl) %>" target="_blank" rel="noopener" class="sc-share-btn" title="Facebook"><i class="bi bi-facebook"></i></a>
                <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(pageUrl) %>&text=<%= encodeURIComponent(product.title) %>" target="_blank" rel="noopener" class="sc-share-btn" title="Twitter / X"><i class="bi bi-twitter-x"></i></a>
                <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(pageUrl) %>" target="_blank" rel="noopener" class="sc-share-btn" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                <a href="https://wa.me/?text=<%= encodeURIComponent(product.title + ' — ' + pageUrl) %>" target="_blank" rel="noopener" class="sc-share-btn" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
            </div>

        </div><!-- /right col -->
    </div><!-- /row -->
</div><!-- /container -->
</div><!-- /sc-pd -->

<!-- Inquiry Authentication Decision Modal -->
<div class="modal fade" id="inquiryAuthModal" tabindex="-1" aria-labelledby="inquiryAuthModalLabel" aria-hidden="true" data-is-logged-in="<%= (typeof isUserLoggedIn !== 'undefined' && isUserLoggedIn) ? 'true' : 'false' %>">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; background: #ffffff !important; overflow: hidden; font-family: 'Inter', sans-serif;">
            <!-- Top visual accent line -->
            <div style="height: 6px; background: #000000;"></div>
            
            <div class="modal-header border-0 pt-4 px-4 pb-0 d-flex align-items-start justify-content-between">
                <div>
                    <h5 class="modal-title fw-bold inq-modal-title d-flex align-items-center gap-2" id="inquiryAuthModalLabel" style="font-family: 'Poppins', sans-serif; font-size: 1.35rem; letter-spacing: -0.3px;">
                        <i class="bi bi-shield-lock-fill" style="color: #000000;"></i>
                        Inquiry Options
                    </h5>
                    <p class="inq-modal-subtitle mb-0 mt-1" style="font-size: 0.82rem; line-height: 1.4;">Please select how you would like to proceed with your inquiry.</p>
                </div>
                <button type="button" class="btn-close shadow-none border-0" data-bs-dismiss="modal" aria-label="Close" style="font-size: 0.85rem; filter: grayscale(1) invert(0);"></button>
            </div>

            <div class="modal-body px-4 py-4">
                <div class="d-flex flex-column gap-3">
                    
                    <!-- Option 1: Login & Inquire (Recommended) -->
                    <div class="p-3 border rounded-3 position-relative" style="transition: all 0.22s ease; cursor: pointer;" id="optLoginFirst" data-redirect-url="/login?redirect=<%= encodeURIComponent(inquiryPath + '?productId=' + product._id) %>">
                        <!-- Recommended Badge (Black) -->
                        <span class="position-absolute top-0 end-0 translate-middle-y badge px-2.5 py-1 text-white fw-bold rounded-pill shadow-sm" style="font-size: 0.65rem; background-color: #000000 !important; text-transform: uppercase; letter-spacing: 0.6px; margin-right: 15px;">
                            <i class="bi bi-star-fill text-white"></i> Recommended
                        </span>
                        
                        <div class="d-flex gap-3">
                            <div class="flex-shrink-0 d-flex align-items-center justify-content-center bg-white rounded-circle shadow-sm" style="width: 44px; height: 44px; border: 1.5px solid rgba(0, 0, 0, 0.12);">
                                <i class="bi bi-person-badge-fill fs-5" style="color: #000000;"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-1 inq-modal-text" style="font-family: 'Poppins', sans-serif; font-size: 0.95rem;">Login / Register First</h6>
                                <p class="inq-modal-desc mb-3" style="font-size: 0.78rem; line-height: 1.45;">
                                    This automatically creates a support ticket in your account dashboard. You can track all responses, reply back, and view history directly inside Swadesi Carts.
                                </p>
                                <div class="btn btn-sm inq-btn-login px-3 py-2 w-100 rounded-3 d-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-box-arrow-in-right text-white"></i> Login &amp; Inquire
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Option 2: Direct Inquiry (Without Account) -->
                    <div class="p-3 border rounded-3" style="transition: all 0.22s ease; cursor: pointer;" id="optDirectInquiry" data-redirect-url="<%= inquiryPath %>?productId=<%= product._id %>">
                        <div class="d-flex gap-3">
                            <div class="flex-shrink-0 d-flex align-items-center justify-content-center bg-white rounded-circle shadow-sm" style="width: 44px; height: 44px; border: 1.5px solid rgba(0, 0, 0, 0.08);">
                                <i class="bi bi-envelope-open-fill fs-5 text-secondary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-1 inq-modal-text" style="font-family: 'Poppins', sans-serif; font-size: 0.95rem;">Direct Inquiry (Without Login)</h6>
                                <p class="inq-modal-desc mb-3" style="font-size: 0.78rem; line-height: 1.45;">
                                    Submit your inquiry directly. <strong class="inq-modal-danger">A support ticket will NOT be created</strong> in your dashboard. You will receive all replies and follow-ups only via email.
                                </p>
                                <div class="btn btn-sm inq-btn-guest px-3 py-2 w-100 rounded-3 d-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-arrow-right-short"></i> Proceed as Guest (Email Only)
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            
            <div class="modal-footer border-0 bg-light py-2.5 px-4 d-flex justify-content-between align-items-center">
                <span class="inq-modal-footer-text" style="font-size: 0.7rem;"><i class="bi bi-info-circle"></i> Highly recommended to log in for easy tracking.</span>
                <button type="button" class="btn btn-link text-decoration-none inq-modal-cancel fw-bold p-0" data-bs-dismiss="modal" style="font-size: 0.8rem; font-family: 'Poppins', sans-serif;">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Success Notification Modal -->
<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
<div class="modal fade" id="successNotificationModal" tabindex="-1" aria-labelledby="successNotificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 450px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; background: #ffffff !important; overflow: hidden; font-family: 'Inter', sans-serif;">
            <!-- Top visual accent line in green -->
            <div style="height: 6px; background: #22c55e;"></div>
            
            <div class="modal-body px-4 py-4 text-center">
                <!-- Large green success checkmark icon -->
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 72px; height: 72px; background-color: #f0fdf4 !important; border: 2px solid #bbf7d0;">
                    <i class="bi bi-check-circle-fill text-success fs-1"></i>
                </div>
                
                <h4 class="fw-bold text-dark mb-2" id="successNotificationModalLabel" style="font-family: 'Poppins', sans-serif; letter-spacing: -0.3px;">
                    Success!
                </h4>
                
                <p class="mb-4 inq-modal-desc" style="font-size: 0.88rem; line-height: 1.5; color: #444444 !important;">
                    <%= success %>
                </p>
                
                <button type="button" class="btn w-100 py-2.5 fw-bold rounded-3 text-white" data-bs-dismiss="modal" style="background-color: #22c55e; border: none; font-size: 0.9rem; transition: background-color 0.2s ease;" onmouseover="this.style.backgroundColor='#15803d'" onmouseout="this.style.backgroundColor='#22c55e'">
                    Got it, thanks!
                </button>
            </div>
        </div>
    </div>
</div>
<% } %>

<!-- Error Notification Modal -->
<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
<div class="modal fade" id="errorNotificationModal" tabindex="-1" aria-labelledby="errorNotificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 450px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; background: #ffffff !important; overflow: hidden; font-family: 'Inter', sans-serif;">
            <!-- Top visual accent line in red -->
            <div style="height: 6px; background: #dc3545;"></div>
            
            <div class="modal-body px-4 py-4 text-center">
                <!-- Large red error icon -->
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 72px; height: 72px; background-color: #fdf2f2 !important; border: 2px solid #fde8e8;">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                </div>
                
                <h4 class="fw-bold text-dark mb-2" id="errorNotificationModalLabel" style="font-family: 'Poppins', sans-serif; letter-spacing: -0.3px;">
                    Error
                </h4>
                
                <p class="mb-4 inq-modal-desc" style="font-size: 0.88rem; line-height: 1.5; color: #444444 !important;">
                    <%= error %>
                </p>
                
                <button type="button" class="btn w-100 py-2.5 fw-bold rounded-3 text-white" data-bs-dismiss="modal" style="background-color: #dc3545; border: none; font-size: 0.9rem; transition: background-color 0.2s ease;" onmouseover="this.style.backgroundColor='#bd2130'" onmouseout="this.style.backgroundColor='#dc3545'">
                    Close
                </button>
            </div>
        </div>
    </div>
<% } %>

<!-- View All Reviews Modal -->
<% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
<div class="modal fade" id="allReviewsModal" tabindex="-1" aria-labelledby="allReviewsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 600px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; background: #ffffff !important; overflow: hidden; font-family: 'Inter', sans-serif;">
            <div class="modal-header border-bottom px-4 py-3" style="border-color: rgba(0, 0, 0, 0.08) !important; background-color: #fafafa !important;">
                <h5 class="modal-title fw-bold" id="allReviewsModalLabel" style="font-family: 'Poppins', sans-serif; letter-spacing: -0.3px; color: #111111 !important; font-size: 1.1rem;">
                    All Customer Reviews (<%= reviews.length %>)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3" style="max-height: 450px;">
                <% reviews.forEach(r => { %>
                    <div class="pb-3 mb-3 border-bottom" style="border-color: rgba(0, 0, 0, 0.05) !important;">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div class="fw-bold" style="font-size: 0.9rem; color: #111111 !important;"><%= r.userName %></div>
                            <div style="font-size: 0.8rem; color: #ffc107 !important;">
                                <% for(let i = 1; i <= 5; i++) { %>
                                    <i class="bi bi-star<%= i <= r.rating ? '-fill' : '' %>"></i>
                                <% } %>
                            </div>
                        </div>
                        <p class="mb-1" style="font-size: 0.85rem; line-height: 1.4; color: #444444 !important; word-wrap: break-word !important; word-break: break-word !important; white-space: pre-wrap !important;"><%= r.comment %></p>
                        <small style="font-size: 0.75rem; color: #777777 !important;"><%= r.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></small>
                        <% if (typeof isUserLoggedIn !== 'undefined' && isUserLoggedIn && typeof userId !== 'undefined' && String(r.userId) === String(userId)) { %>
                            <button type="button" class="btn btn-link text-primary p-0 border-0 fw-bold ms-3 edit-review-btn" 
                                    data-review-id="<%= r._id %>" 
                                    data-comment="<%= r.comment %>" 
                                    data-rating="<%= r.rating %>"
                                    style="font-size: 0.75rem; text-decoration: none; vertical-align: baseline;">
                                Edit
                            </button>
                            <form action="/reviews/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete your review?');">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="reviewId" value="<%= r._id %>">
                                <input type="hidden" name="productId" value="<%= product._id %>">
                                <input type="hidden" name="productType" value="<%= type %>">
                                <button type="submit" class="btn btn-link text-danger p-0 border-0 fw-bold ms-2" style="font-size: 0.75rem; text-decoration: none; vertical-align: baseline;">
                                    Delete
                                </button>
                            </form>
                        <% } %>
                    </div>
                <% }); %>
            </div>
            <div class="modal-footer border-top px-4 py-3" style="border-color: rgba(0, 0, 0, 0.08) !important; background-color: #fafafa !important;">
                <button type="button" class="btn btn-dark btn-sm fw-bold px-4 py-2 rounded-3" data-bs-dismiss="modal" style="background-color: #111111 !important; color: #ffffff !important; border: none !important;">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
<% } %>

<!-- Edit Review Modal -->
<div class="modal fade" id="editReviewModal" tabindex="-1" aria-labelledby="editReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; background: #ffffff !important; overflow: hidden; font-family: 'Inter', sans-serif;">
            <div class="modal-header border-bottom px-4 py-3" style="border-color: rgba(0, 0, 0, 0.08) !important; background-color: #fafafa !important;">
                <h5 class="modal-title fw-bold" id="editReviewModalLabel" style="font-family: 'Poppins', sans-serif; letter-spacing: -0.3px; color: #111111 !important; font-size: 1.1rem;">
                    Edit Your Review
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/reviews/edit" method="POST" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="productId" value="<%= product._id %>">
                <input type="hidden" name="productType" value="<%= type %>">
                <input type="hidden" name="reviewId" id="editReviewId">
                
                <div class="modal-body px-4 py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 0.8rem; color: #444444 !important;">Rating *</label>
                        <div class="d-flex gap-2 fs-5" id="editStarRatingSelector" style="cursor: pointer; color: #ffc107 !important;">
                            <i class="bi bi-star edit-rating-star" data-value="1"></i>
                            <i class="bi bi-star edit-rating-star" data-value="2"></i>
                            <i class="bi bi-star edit-rating-star" data-value="3"></i>
                            <i class="bi bi-star edit-rating-star" data-value="4"></i>
                            <i class="bi bi-star edit-rating-star" data-value="5"></i>
                        </div>
                        <input type="hidden" name="rating" id="editRatingInput" required>
                    </div>

                    <div class="mb-3">
                        <label for="editReviewComment" class="form-label fw-semibold" style="font-size: 0.8rem; color: #444444 !important;">Comment *</label>
                        <textarea class="form-control text-dark bg-white border" id="editReviewComment" name="comment" rows="4" placeholder="Tell us about your experience..." style="font-size: 0.85rem; color: #111111 !important;" maxlength="1000" required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3" style="border-color: rgba(0, 0, 0, 0.08) !important; background-color: #fafafa !important;">
                    <button type="button" class="btn btn-outline-dark btn-sm fw-bold px-3 py-2 rounded-3" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-dark btn-sm fw-bold px-4 py-2 rounded-3" style="background-color: #111111 !important; color: #ffffff !important; border: none !important;">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

