<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <%- include('../partials/dynamic-styles') %>
    <style>
        /* ── Mobile-first product detail layout ── */
        .product-detail-header {
            padding: 1rem 0 0.5rem;
        }
        .product-detail-header .badge {
            font-size: 0.75rem;
            margin-right: 0.35rem;
        }
        .product-detail-header h1 {
            font-size: 1.45rem;
            line-height: 1.3;
        }
        .product-detail-header .product-price {
            font-size: 1.4rem;
        }

        /* Sticky inquiry CTA bar on mobile */
        @media (max-width: 991.98px) {
            .product-detail-header h1 { font-size: 1.25rem; }
            .carousel-sticky-wrap { position: sticky; top: 0; z-index: 10; background: #fff; padding-bottom: 0.25rem; }
            .detail-panels-wrap { padding-top: 0.75rem; }
        }

        @media (min-width: 992px) {
            .product-detail-header h1 { font-size: 1.75rem; }
            .mobile-only { display: none !important; }
            .carousel-sticky-wrap { position: static; }
        }
        @media (max-width: 991.98px) {
            .desktop-only { display: none !important; }
        }

        /* Breadcrumb compact on mobile */
        @media (max-width: 575.98px) {
            .breadcrumb { font-size: 0.78rem; }
            .breadcrumb-item + .breadcrumb-item::before { padding: 0 0.3rem; }
        }

        /* Force panel headings to black regardless of admin theme color */
        .detail-panel h5,
        .detail-panel h5.fw-bold,
        .inquiry-section h5,
        .inquiry-section h5.fw-bold {
            color: #1a1a1a !important;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <% if (success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <section class="py-3 py-lg-5">
        <div class="container">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/tech-packages">Tech Packages</a></li>
                    <li class="breadcrumb-item active text-truncate" style="max-width:160px;"><%= package.title %></li>
                </ol>
            </nav>

            <!-- ══════════════════════════════════════
                 MOBILE LAYOUT (< lg): Title → Image → Details → Form
                 DESKTOP LAYOUT (≥ lg): Image | Title+Details+Form
            ═══════════════════════════════════════ -->

            <!-- MOBILE: Header (badges + title + price) — shown ABOVE image on small screens -->
            <div class="product-detail-header mobile-only mb-2">
                <span class="badge bg-swadesi"><%= package.category %></span>
                <h1 class="fw-bold mt-2 mb-1"><%= package.title %></h1>
                <% if (package.price && package.price.displayText) { %>
                    <p class="text-swadesi fw-bold product-price mb-1"><%= package.price.displayText %></p>
                <% } %>
                <p class="text-muted small mb-0"><%= package.shortDescription %></p>
            </div>

            <div class="row g-4">
                <!-- LEFT: Image / Carousel -->
                <div class="col-12 col-lg-6">
                    <div class="carousel-sticky-wrap">
                        <%- include('../partials/media-carousel', { gallery: package.gallery, featuredImage: package.featuredImage }) %>
                    </div>
                </div>

                <!-- RIGHT: Info panel -->
                <div class="col-12 col-lg-6">

                    <!-- DESKTOP ONLY: Header inside right column -->
                    <div class="desktop-only">
                        <span class="badge bg-swadesi mb-2"><%= package.category %></span>
                        <h1 class="fw-bold mb-2"><%= package.title %></h1>
                        <% if (package.price && package.price.displayText) { %>
                            <p class="text-swadesi fs-4 fw-bold"><%= package.price.displayText %></p>
                        <% } %>
                        <p class="text-muted mb-4"><%= package.shortDescription %></p>
                    </div>

                    <!-- Features -->
                    <% if (package.features && package.features.length > 0) { %>
                        <div class="detail-panel mb-3">
                            <div class="card-body">
                                <h5 class="fw-bold mb-3" style="color:#000000 !important">Features</h5>
                                <ul class="list-unstyled mb-0">
                                    <% package.features.forEach(feature => { %>
                                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> <%= feature %></li>
                                    <% }); %>
                                </ul>
                            </div>
                        </div>
                    <% } %>

                    <!-- Description -->
                    <div class="detail-panel mb-3">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3" style="color:#000000 !important">Description</h5>
                            <p class="mb-0" style="white-space: pre-wrap;"><%= package.fullDescription %></p>
                        </div>
                    </div>

                    <!-- Inquiry Form -->
                    <div class="inquiry-section card border-swadesi shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3" style="color:#000000 !important">
                                <i class="bi bi-chat-dots text-swadesi"></i> Request Quote
                            </h5>
                            <form action="/tech-packages/inquiry" method="POST" id="inquiryForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="productId" value="<%= package._id %>">

                                <div class="mb-3">
                                    <label class="form-label">Name *</label>
                                    <input type="text" class="form-control" name="name" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Mobile Number *</label>
                                    <input type="tel" class="form-control" name="mobile" pattern="[0-9]{10}" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Email *</label>
                                    <input type="email" class="form-control" name="email" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Your Requirement *</label>
                                    <textarea class="form-control" name="requirement" rows="4" required></textarea>
                                </div>

                                <button type="submit" class="btn btn-swadesi w-100" id="submitBtn">
                                    <i class="bi bi-send"></i> Submit Inquiry
                                </button>
                            </form>
                        </div>
                    </div>

                </div><!-- /right col -->
            </div><!-- /row -->

        </div>
    </section>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
    <script>
        document.getElementById('inquiryForm').addEventListener('submit', function() {
            document.getElementById('submitBtn').innerHTML = '<span class="spinner-border spinner-border-sm"></span> Submitting...';
            document.getElementById('submitBtn').disabled = true;
        });
    </script>
</body>
</html>
