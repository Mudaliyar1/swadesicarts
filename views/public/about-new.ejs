<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-new.css">
    <%- include('../partials/dynamic-styles') %>
    <%- include('../partials/seo-meta') %>
</head>
<body>
    <!-- GEO Generative AI Optimization Summary -->
    <div style="display: none !important;" aria-hidden="true" id="geo-ai-summary">
        <p>Topic: <%= geo.conversationalTopic %></p>
        <p>Location: <%= geo.geoTarget %></p>
        <p>Entities: <%= geo.entities.join(', ') %></p>
        <p>Summary: <%= geo.pageSummary %></p>
    </div>

    <%- include('../partials/navbar-new') %>
    
    <!-- CUSTOM HERO SECTION (OUR STORY) -->
    <section class="about-hero-section">
        <div class="container">
            <div class="row align-items-center g-5 position-relative">
                <div class="col-lg-7 z-index-2">
                    <div class="about-hero-tag">OUR STORY &middot; हमारी कहानी</div>
                    <h1 class="about-hero-title">
                        Born in <span class="text-italic-gold">Bharat.</span><br>
                        Built for the World.
                    </h1>
                    <div class="about-hero-subtitle">लोकल से ग्लोबल तक</div>
                    <p class="about-hero-desc">
                        Swadeshi Carts is not just a business. It is a belief &mdash; that India's best products come from India's own soil, India's own farmers, and India's own artisans. We exist to bring that purity and trust to events, homes, and businesses across the country and beyond.
                    </p>
                </div>
                <div class="col-lg-5 text-center position-relative z-index-2">
                    <div class="about-hero-logo-wrapper">
                        <% if (siteSettings && siteSettings.logo && siteSettings.logo.url) { %>
                            <img src="<%= siteSettings.logo.url %>" alt="Swadesi Carts" class="about-hero-logo">
                        <% } else { %>
                            <div class="about-hero-logo-placeholder">Swadesi Carts</div>
                        <% } %>
                    </div>
                </div>
                <!-- Large Translucent Watermark -->
                <div class="about-hero-watermark">स्वदेशी</div>
            </div>
        </div>
    </section>

    <!-- LOCAL TO GLOBAL CARD SECTION -->
    <section class="local-global-wrapper">
        <div class="container">
            <div class="local-global-card">
                <div class="lg-card-side local-side">
                    <h2 class="lg-card-title" style="color: #0b132b !important;">लोकल से</h2>
                    <p class="lg-card-text" style="color: #0b132b !important;">
                        From the local &mdash; India's farms, artisans, and festivals. Every product begins with a story rooted in Indian soil and Indian hands.
                    </p>
                </div>
                <div class="lg-card-arrow">
                    <i class="bi bi-arrow-right d-none d-md-block"></i>
                    <i class="bi bi-arrow-down d-md-none"></i>
                </div>
                <div class="lg-card-side global-side">
                    <h2 class="lg-card-title" style="color: #0b132b !important;">ग्लोबल तक</h2>
                    <p class="lg-card-text" style="color: #0b132b !important;">
                        To the global &mdash; quality Indian products deserve the world's attention. We are building that path, one order at a time.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT SECTION 1 -->
    <section>
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h2>Who We Are</h2>
                    <% if (siteSettings && siteSettings.about && siteSettings.about.description) { %>
                        <% const paragraphs = siteSettings.about.description.split(/\r?\n/); %>
                        <% paragraphs.forEach(para => { %>
                            <% if (para.trim()) { %>
                                <p class="text-muted-custom fs-5 mb-3"><%= para %></p>
                            <% } %>
                        <% }) %>
                    <% } else { %>
                        <p class="text-muted-custom fs-5 mb-3">Swadesi Carts is a premium marketplace dedicated to bringing you the finest selection of seasonal products, professional tech services, and 100% certified organic items all in one convenient platform.</p>
                    <% } %>
                </div>
                <div class="col-lg-6">
                    <% if (siteSettings && siteSettings.about && siteSettings.about.image && siteSettings.about.image.url) { %>
                        <img src="<%= siteSettings.about.image.url %>" alt="About Us" class="img-fluid rounded-3 shadow-sm" style="border-radius: 16px; max-height: 400px; width: 100%; object-fit: cover;">
                    <% } else { %>
                        <div style="background: linear-gradient(135deg, var(--primary), var(--primary-light)); height: 400px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 8rem; opacity: 0.2;">
                            🌟
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- VALUES SECTION -->
    <% if (siteSettings && siteSettings.about && siteSettings.about.values && siteSettings.about.values.length > 0) { %>
    <section class="bg-light-custom">
        <div class="container">
            <div class="section-header">
                <h2><%= siteSettings.about.valuesHeading || 'Our Values' %></h2>
                <p><%= siteSettings.about.valuesSubheading || 'What drives us forward' %></p>
            </div>
            <div class="row g-4">
                <% siteSettings.about.values.forEach(value => { %>
                    <div class="col-md-6 col-lg-3">
                        <div class="card border-0 h-100">
                            <div class="card-body text-center">
                                <div class="feature-icon" style="margin-left: auto; margin-right: auto; font-size: 2.5rem;">
                                    <%= value.icon %>
                                </div>
                                <h5><%= value.title %></h5>
                                <p class="text-muted-custom mb-0"><%= value.description %></p>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>
    <% } %>



    <!-- TEAM SECTION -->
    <% if (siteSettings && siteSettings.about && siteSettings.about.teamMembers && siteSettings.about.teamMembers.filter(m => m.isActive).length > 0) { %>
    <section class="bg-light-custom">
        <div class="container">
            <div class="section-header">
                <h2><%= (siteSettings && siteSettings.about && siteSettings.about.teamHeading) ? siteSettings.about.teamHeading : 'Meet Our Team' %></h2>
                <p><%= (siteSettings && siteSettings.about && siteSettings.about.teamSubheading) ? siteSettings.about.teamSubheading : 'The people behind the excellence' %></p>
            </div>
            <div class="row g-4">
                <% siteSettings.about.teamMembers.filter(m => m.isActive).sort((a, b) => a.order - b.order).forEach(member => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="team-member-card">
                            <div class="team-member-image-wrapper">
                                <% if (member.image && member.image.url) { %>
                                    <img src="<%= member.image.url %>" alt="<%= member.name %>" class="team-member-image">
                                <% } else { %>
                                    <div class="team-member-image team-member-placeholder">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                <% } %>
                            </div>
                            <div class="team-member-info">
                                <h4 class="team-member-name"><%= member.name %></h4>
                                <p class="team-member-role"><%= member.role %></p>
                                <% if (member.bio) { %>
                                    <p class="team-member-bio"><%= member.bio %></p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- MD QUOTE & STATS SECTION (PLACED UNDER LAST PART OF ABOUT US) -->
    <section class="about-quote-banner" id="md-section">
        <div class="about-quote-content container">
            <p class="about-quote-text">
                "हम लोकल से शुरू करते हैं — और ग्लोबल तक जाते हैं। India's best products deserve the world's attention. That journey starts here, in Ahmedabad, with every order we fulfil."
            </p>
            <p class="about-quote-author">
                — Balram Yadav, Managing Director, Swadeshi Carts
            </p>
        </div>
    </section>

    <section class="about-stats-wrapper">
        <div class="container">
            <div class="about-stats-card">
                <div class="about-stats-row">
                    <div class="about-stat-col">
                        <div class="about-stat-number">3</div>
                        <div class="about-stat-label">Business verticals</div>
                    </div>
                    <div class="about-stat-col">
                        <div class="about-stat-number">48hr</div>
                        <div class="about-stat-label">Bulk quotation</div>
                    </div>
                    <div class="about-stat-col">
                        <div class="about-stat-number">Pan India</div>
                        <div class="about-stat-label">Delivery network</div>
                    </div>
                    <div class="about-stat-col">
                        <div class="about-stat-number">100%</div>
                        <div class="about-stat-label">Swadeshi sourced</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/footer-new') %>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
