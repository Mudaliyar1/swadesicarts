<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-new.css">
    <%- include('../partials/dynamic-styles') %>
    <%- include('../partials/seo-meta') %>
</head>
<body>
    <%- include('../partials/navbar-new') %>
    
    <!-- PAGE HEADER -->
    <section class="page-header">
        <div class="container">
            <h1><%= siteSettings && siteSettings.about ? siteSettings.about.mainHeading : 'About Swadesi Carts' %></h1>
            <p><%= siteSettings && siteSettings.about ? (siteSettings.about.headerDescription || siteSettings.about.description) : 'Your trusted partner for authentic products and professional solutions' %></p>
        </div>
    </section>

    <!-- ABOUT SECTION 1 -->
    <section>
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h2>Who We Are</h2>
                    <% if (siteSettings && siteSettings.about && siteSettings.about.description) { %>
                        <% const paragraphs = siteSettings.about.description.split(/\r?\n/); %>
                        <% paragraphs.forEach(para => { %>
                            <% if (para.trim()) { %>
                                <p class="text-muted-custom fs-5 mb-3"><%= para %></p>
                            <% } %>
                        <% }) %>
                    <% } else { %>
                        <p class="text-muted-custom fs-5 mb-3">Swadesi Carts is a premium marketplace dedicated to bringing you the finest selection of seasonal products, professional tech services, and 100% certified organic items all in one convenient platform.</p>
                    <% } %>
                </div>
                <div class="col-lg-6">
                    <% if (siteSettings && siteSettings.about && siteSettings.about.image && siteSettings.about.image.url) { %>
                        <img src="<%= siteSettings.about.image.url %>" alt="About Us" class="img-fluid rounded-3 shadow-sm" style="border-radius: 16px; max-height: 400px; width: 100%; object-fit: cover;">
                    <% } else { %>
                        <div style="background: linear-gradient(135deg, var(--primary), var(--primary-light)); height: 400px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 8rem; opacity: 0.2;">
                            🌟
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- VALUES SECTION -->
    <% if (siteSettings && siteSettings.about && siteSettings.about.values && siteSettings.about.values.length > 0) { %>
    <section class="bg-light-custom">
        <div class="container">
            <div class="section-header">
                <h2><%= siteSettings.about.valuesHeading || 'Our Values' %></h2>
                <p><%= siteSettings.about.valuesSubheading || 'What drives us forward' %></p>
            </div>
            <div class="row g-4">
                <% siteSettings.about.values.forEach(value => { %>
                    <div class="col-md-6 col-lg-3">
                        <div class="card border-0 h-100">
                            <div class="card-body text-center">
                                <div class="feature-icon" style="margin-left: auto; margin-right: auto; font-size: 2.5rem;">
                                    <%= value.icon %>
                                </div>
                                <h5><%= value.title %></h5>
                                <p class="text-muted-custom mb-0"><%= value.description %></p>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- STATS SECTION -->
    <section>
        <div class="container">
            <div class="row text-center">
                <div class="col-md-3">
                    <div class="stats-box">
                        <div class="stats-number"><%= (siteSettings && siteSettings.about && siteSettings.about.stats && siteSettings.about.stats.customers) ? siteSettings.about.stats.customers : '500+' %></div>
                        <div class="stats-label"><%= (siteSettings && siteSettings.about && siteSettings.about.stats && siteSettings.about.stats.customersLabel) ? siteSettings.about.stats.customersLabel : 'Happy Customers' %></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-box">
                        <div class="stats-number"><%= (siteSettings && siteSettings.about && siteSettings.about.stats && siteSettings.about.stats.products) ? siteSettings.about.stats.products : '1000+' %></div>
                        <div class="stats-label"><%= (siteSettings && siteSettings.about && siteSettings.about.stats && siteSettings.about.stats.productsLabel) ? siteSettings.about.stats.productsLabel : 'Products & Services' %></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-box">
                        <div class="stats-number"><%= (siteSettings && siteSettings.about && siteSettings.about.stats && siteSettings.about.stats.experience) ? siteSettings.about.stats.experience : '10+' %></div>
                        <div class="stats-label"><%= (siteSettings && siteSettings.about && siteSettings.about.stats && siteSettings.about.stats.experienceLabel) ? siteSettings.about.stats.experienceLabel : 'Years Experience' %></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-box">
                        <div class="stats-number"><%= (siteSettings && siteSettings.about && siteSettings.about.stats && siteSettings.about.stats.satisfaction) ? siteSettings.about.stats.satisfaction : '100%' %></div>
                        <div class="stats-label"><%= (siteSettings && siteSettings.about && siteSettings.about.stats && siteSettings.about.stats.satisfactionLabel) ? siteSettings.about.stats.satisfactionLabel : 'Satisfaction Guaranteed' %></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TEAM SECTION -->
    <% if (siteSettings && siteSettings.about && siteSettings.about.teamMembers && siteSettings.about.teamMembers.filter(m => m.isActive).length > 0) { %>
    <section class="bg-light-custom">
        <div class="container">
            <div class="section-header">
                <h2><%= (siteSettings && siteSettings.about && siteSettings.about.teamHeading) ? siteSettings.about.teamHeading : 'Meet Our Team' %></h2>
                <p><%= (siteSettings && siteSettings.about && siteSettings.about.teamSubheading) ? siteSettings.about.teamSubheading : 'The people behind the excellence' %></p>
            </div>
            <div class="row g-4">
                <% siteSettings.about.teamMembers.filter(m => m.isActive).sort((a, b) => a.order - b.order).forEach(member => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="team-member-card">
                            <div class="team-member-image-wrapper">
                                <% if (member.image && member.image.url) { %>
                                    <img src="<%= member.image.url %>" alt="<%= member.name %>" class="team-member-image">
                                <% } else { %>
                                    <div class="team-member-image team-member-placeholder">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                <% } %>
                            </div>
                            <div class="team-member-info">
                                <h4 class="team-member-name"><%= member.name %></h4>
                                <p class="team-member-role"><%= member.role %></p>
                                <% if (member.bio) { %>
                                    <p class="team-member-bio"><%= member.bio %></p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <%- include('../partials/footer-new') %>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
