                            <section class="bg-primary"
                                style="background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%) !important;">
                                <div class="container">
                                    <div class="text-center text-white scale-up">
                                        <h2 class="mb-3">Ready to Get Started?</h2>
                                        <p class="fs-5 mb-4">Join thousands of satisfied customers. Explore our wide
                                            range of products and services today.</p>
                                        <a href="/contact" class="btn btn-light btn-lg">Contact Us</a>
