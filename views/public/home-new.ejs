<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Poppins:wght@600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style-new.css">
    <%- include('../partials/dynamic-styles') %>
    <%- include('../partials/seo-meta') %>
    <style>
        /* Force product card text to brown as requested */
        .home-page .product-card .product-category,
        .home-page .product-card .product-card-title,
        .home-page .product-card .product-card-description,
        .home-page .product-card .product-price {
            color: #5C3A21 !important;
        }
        
        .home-page .product-card:hover .product-card-title {
            color: #8B4513 !important;
        }
        
        .home-page .product-card .product-badge {
            background: #8B4513 !important;
        }
        
        .home-page .product-card-footer .btn {
            border: 2px solid #5C3A21 !important;
            color: #5C3A21 !important;
            background: transparent !important;
        }
        
        .home-page .product-card-footer .btn:hover {
            background-color: #5C3A21 !important;
            color: #FFF !important;
        }
    </style>
</head>

<body class="home-page">
    <!-- GEO Generative AI Optimization Summary -->
    <div style="display: none !important;" aria-hidden="true" id="geo-ai-summary">
        <p>Topic: <%= geo.conversationalTopic %></p>
        <p>Location: <%= geo.geoTarget %></p>
        <p>Entities: <%= geo.entities.join(', ') %></p>
        <p>Summary: <%= geo.pageSummary %></p>
    </div>

    <!-- LOADING ANIMATION -->
    <div class="page-loader" id="pageLoader">
        <div class="loader-content">
            <!-- Animated Background -->
            <div class="loader-bg"></div>

            <!-- Bouncing Icons Container -->
            <div class="icons-container">
                <div class="bouncing-icon" data-icon="0">
                    <span class="emoji">💻</span>
                    <p class="category-name">Technology</p>
                </div>
                <div class="bouncing-icon" data-icon="1">
                    <span class="emoji">🥬</span>
                    <p class="category-name">Organic</p>
                </div>
                <div class="bouncing-icon" data-icon="2">
                    <span class="emoji">🌸</span>
                    <p class="category-name">Seasonal</p>
                </div>
            </div>

            <!-- Progress Indicator -->
            <div class="loader-progress">
                <div class="progress-bar"></div>
            </div>

            <!-- Brand Text -->
            <h1 class="loader-title">Swadesi Carts</h1>
            <p class="loader-subtitle">Nature's Finest Collection</p>
        </div>
    </div>

    <!-- VISITOR INFO MODAL -->
    <div class="visitor-modal" id="visitorModal">
        <div class="visitor-modal-content">
            <button class="visitor-modal-close" id="closeModal" title="Skip">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="visitor-modal-header">
                <h2>Welcome to Swadesi Carts! 👋</h2>
                <p>Help us personalize your experience</p>
            </div>
            <form id="visitorForm">
                <div class="visitor-form-group">
                    <label for="visitorName">
                        <i class="bi bi-person-fill"></i> Your Name *
                    </label>
                    <input type="text" id="visitorName" name="name" required placeholder="Enter your name">
                </div>
                <div class="visitor-form-group">
                    <label for="visitorEmail">
                        <i class="bi bi-envelope-fill"></i> Email Address *
                    </label>
                    <input type="email" id="visitorEmail" name="email" required placeholder="your.email@example.com">
                </div>
                <div class="visitor-form-group">
                    <label for="visitorMobile">
                        <i class="bi bi-telephone-fill"></i> Mobile Number *
                    </label>
                    <input type="tel" id="visitorMobile" name="mobile" required placeholder="+91 00000 00000"
                        pattern="[0-9+\s-]*">
                </div>
                <div class="visitor-form-group">
                    <label>
                        <i class="bi bi-heart-fill"></i> What brings you here? *
                    </label>
                    <div class="preference-cards">
                        <label class="preference-card">
                            <input type="radio" name="preference" value="seasonal" required>
                            <div class="preference-card-content">
                                <span class="preference-emoji">🌸</span>
                                <span class="preference-label">Seasonal Products</span>
                            </div>
                        </label>
                        <label class="preference-card">
                            <input type="radio" name="preference" value="tech" required>
                            <div class="preference-card-content">
                                <span class="preference-emoji">💻</span>
                                <span class="preference-label">Tech Services</span>
                            </div>
                        </label>
                        <label class="preference-card">
                            <input type="radio" name="preference" value="organic" required>
                            <div class="preference-card-content">
                                <span class="preference-emoji">🥬</span>
                                <span class="preference-label">Organic Products</span>
                            </div>
                        </label>
                    </div>
                </div>
                <button type="submit" class="visitor-submit-btn">
                    <span>Continue</span>
                    <i class="bi bi-arrow-right-circle-fill"></i>
                </button>
            </form>
        </div>
    </div>

    <%- include('../partials/navbar-new') %>

        <% const whatsappNumber=(siteSettings && siteSettings.whatsapp && siteSettings.whatsapp.number) || (siteSettings
            && siteSettings.contact && siteSettings.contact.phone) || (siteSettings && siteSettings.footer &&
            siteSettings.footer.phone) || '' ; const whatsappMessage=(siteSettings && siteSettings.whatsapp &&
            siteSettings.whatsapp.message) || '' ; const instagramUrl=(siteSettings && siteSettings.socialMedia &&
            siteSettings.socialMedia.instagram) || '' ; const visitorModalEnabled=(siteSettings &&
            siteSettings.visitorModal && siteSettings.visitorModal.enabled !==false) ? true : false;
            const websiteCarouselItems = (siteSettings && siteSettings.carousel ? siteSettings.carousel : []).filter(item => item && item.isActive !== false && item.media && item.media.url).sort((a, b) => (a.order || 0) - (b.order || 0));
            %>
            <!-- SPLIT HERO SECTION -->
            <section class="home-hero-section">
                <div class="container">
                    <div class="row align-items-center g-5">
                        <!-- Left Column: Static Brand Text -->
                        <div class="col-lg-6">
                            <div class="hero-brand-content animate-fade-in-left">
                                <span class="hero-tag-modern">
                                    IN PROUDLY INDIAN &middot; AHMEDABAD, GUJARAT
                                </span>
                                <h1 class="display-4 fw-bold mt-4 mb-3">
                                    Born in <span class="accent-text">Bharat.</span><br>
                                    Built for the <span class="serif-italic">World.</span>
                                </h1>
                                <div class="hero-subtitle-hindi mb-4">
                                    लोकल से ग्लोबल तक
                                </div>
                                <p class="hero-desc mb-4">
                                    India's Swadeshi supply network &mdash; organic products, seasonal festival supplies, and eco solutions delivered directly from Indian farms and artisans to events, homes and businesses across the nation.
                                </p>
                                <div class="d-flex gap-3 flex-wrap">
                                    <a href="/organic-products" class="btn btn-accent btn-lg px-4 py-3">Explore Products</a>
                                    <a href="/contact" class="btn btn-outline-light btn-lg px-4 py-3">Bulk Enquiry &rarr;</a>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Carousel -->
                        <div class="col-lg-6">
                            <div class="hero-carousel-container shadow-lg overflow-hidden animate-fade-in-right" style="border-radius: 24px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.15); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
                                <% if (websiteCarouselItems && websiteCarouselItems.length > 0) { %>
                                    <!-- Website Media Carousel (Admin Uploaded) -->
                                    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
                                        <div class="carousel-indicators" style="bottom: 10px;">
                                            <% websiteCarouselItems.forEach((item, index) => { %>
                                                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="<%= index %>" class="<%= index === 0 ? 'active' : '' %>" aria-current="<%= index === 0 ? 'true' : 'false' %>" aria-label="Slide <%= index + 1 %>"></button>
                                            <% }); %>
                                        </div>
                                        <div class="carousel-inner" style="height: 420px;">
                                            <% websiteCarouselItems.forEach((item, index) => { %>
                                                <% const mediaSrc = (item.media && item.media.transformedUrl) ? item.media.transformedUrl : (item.media && item.media.url ? item.media.url : ''); %>
                                                <div class="carousel-item <%= index === 0 ? 'active' : '' %>" style="height: 100%;">
                                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="position: relative; overflow: hidden; background: #000;">
                                                        <% if (item.media.type === 'video') { %>
                                                            <video class="d-block w-100 h-100" src="<%= mediaSrc %>" autoplay muted playsinline loop style="object-fit: contain; position: relative; z-index: 1;"></video>
                                                        <% } else { %>
                                                            <!-- Blurred bg for letterbox fill -->
                                                            <div style="position: absolute; inset: 0; background-image: url('<%= mediaSrc %>'); background-size: cover; background-position: center; filter: blur(18px) brightness(0.4); transform: scale(1.1); z-index: 0;"></div>
                                                            <!-- Full image, no crop -->
                                                            <img src="<%= mediaSrc %>" alt="<%= item.title || 'Slide' %>" class="d-block" style="max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; position: relative; z-index: 1;">
                                                        <% } %>
                                                        <% if (item.title) { %>
                                                            <div class="carousel-caption" style="background: rgba(0,0,0,0.55); border-radius: 12px; padding: 10px 15px; bottom: 30px; left: 10%; right: 10%; backdrop-filter: blur(5px); z-index: 2;">
                                                                <h5 class="m-0 fw-bold" style="font-size: 1.1rem; color: #fff;"><%= item.title %></h5>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>
                                        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" style="width: 40px; height: 40px; background: rgba(0,0,0,0.3); border-radius: 50%; top: 50%; transform: translateY(-50%); left: 15px; border: none; display: flex; align-items: center; justify-content: center;">
                                            <span class="carousel-control-prev-icon" aria-hidden="true" style="width: 16px; height: 16px;"></span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" style="width: 40px; height: 40px; background: rgba(0,0,0,0.3); border-radius: 50%; top: 50%; transform: translateY(-50%); right: 15px; border: none; display: flex; align-items: center; justify-content: center;">
                                            <span class="carousel-control-next-icon" aria-hidden="true" style="width: 16px; height: 16px;"></span>
                                        </button>
                                    </div>
                                <% } else { %>
                                    <!-- Fallback Emoji/Category Carousel -->
                                    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
                                        <div class="carousel-indicators" style="bottom: 10px;">
                                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
                                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
                                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
                                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="3"></button>
                                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="4"></button>
                                        </div>
                                        <div class="carousel-inner" style="height: 380px;">
                                            <!-- Slide 1: Organic -->
                                            <div class="carousel-item active" style="height: 100%;">
                                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                                    <div class="hero-emoji" style="font-size: 8rem; opacity: 0.9; line-height: 1; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.25)); animation: float 6s ease-in-out infinite;">🌿</div>
                                                    <div class="mt-2 text-white fw-bold text-uppercase tracking-wider" style="font-size: 0.85rem; background: rgba(0,0,0,0.2); padding: 6px 14px; border-radius: 50px; border: 1px solid rgba(255,255,255,0.1);">Organic Products</div>
                                                </div>
                                            </div>
                                            <!-- Slide 2: Tech -->
                                            <div class="carousel-item" style="height: 100%;">
                                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);">
                                                    <div class="hero-emoji" style="font-size: 8rem; opacity: 0.9; line-height: 1; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.25)); animation: float 6s ease-in-out infinite;">💻</div>
                                                    <div class="mt-2 text-white fw-bold text-uppercase tracking-wider" style="font-size: 0.85rem; background: rgba(0,0,0,0.2); padding: 6px 14px; border-radius: 50px; border: 1px solid rgba(255,255,255,0.1);">Tech Services</div>
                                                </div>
                                            </div>
                                            <!-- Slide 3: Seasonal -->
                                            <div class="carousel-item" style="height: 100%;">
                                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                                                    <div class="hero-emoji" style="font-size: 8rem; opacity: 0.9; line-height: 1; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.25)); animation: float 6s ease-in-out infinite;">🌸</div>
                                                    <div class="mt-2 text-white fw-bold text-uppercase tracking-wider" style="font-size: 0.85rem; background: rgba(0,0,0,0.2); padding: 6px 14px; border-radius: 50px; border: 1px solid rgba(255,255,255,0.1);">Seasonal Products</div>
                                                </div>
                                            </div>
                                            <!-- Slide 4: Quality -->
                                            <div class="carousel-item" style="height: 100%;">
                                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                                                    <div class="hero-emoji" style="font-size: 8rem; opacity: 0.9; line-height: 1; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.25)); animation: float 6s ease-in-out infinite;">💎</div>
                                                    <div class="mt-2 text-white fw-bold text-uppercase tracking-wider" style="font-size: 0.85rem; background: rgba(0,0,0,0.2); padding: 6px 14px; border-radius: 50px; border: 1px solid rgba(255,255,255,0.1);">Quality Certified</div>
                                                </div>
                                            </div>
                                            <!-- Slide 5: Delivery -->
                                            <div class="carousel-item" style="height: 100%;">
                                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                                                    <div class="hero-emoji" style="font-size: 8rem; opacity: 0.9; line-height: 1; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.25)); animation: float 6s ease-in-out infinite;">⚡</div>
                                                    <div class="mt-2 text-white fw-bold text-uppercase tracking-wider" style="font-size: 0.85rem; background: rgba(0,0,0,0.2); padding: 6px 14px; border-radius: 50px; border: 1px solid rgba(255,255,255,0.1);">Fast Delivery</div>
                                                </div>
                                            </div>
                                        </div>
                                        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" style="width: 40px; height: 40px; background: rgba(0,0,0,0.3); border-radius: 50%; top: 50%; transform: translateY(-50%); left: 15px; border: none; display: flex; align-items: center; justify-content: center;">
                                            <span class="carousel-control-prev-icon" aria-hidden="true" style="width: 16px; height: 16px;"></span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" style="width: 40px; height: 40px; background: rgba(0,0,0,0.3); border-radius: 50%; top: 50%; transform: translateY(-50%); right: 15px; border: none; display: flex; align-items: center; justify-content: center;">
                                            <span class="carousel-control-next-icon" aria-hidden="true" style="width: 16px; height: 16px;"></span>
                                        </button>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Chat with Us Capsule Button & Popup -->
            <div class="chat-popup-wrapper">
                <button class="chat-capsule-btn" id="chatCapsuleBtn" aria-label="Chat with us">
                    <i class="bi bi-chat-dots-fill"></i>
                    <span>Chat with us</span>
                </button>

                <div class="chat-popup" id="chatPopup">
                    <div class="chat-popup-content">
                        <button class="chat-popup-close" id="chatPopupClose" aria-label="Close">
                            <i class="bi bi-x-lg"></i>
                        </button>

                        <div class="chat-options">
                            <% if (whatsappNumber) { %>
                                <a href="#" class="chat-option whatsapp-option" id="whatsappLink"
                                    data-number="<%= whatsappNumber %>" data-message="<%= whatsappMessage %>"
                                    aria-label="Chat on WhatsApp">
                                    <div class="chat-option-icon">
                                        <i class="bi bi-whatsapp"></i>
                                    </div>
                                    <div class="chat-option-text">
                                        <span class="chat-option-title">WhatsApp</span>
                                        <span class="chat-option-desc">Chat directly</span>
                                    </div>
                                </a>
                                <% } %>

                                    <% if (instagramUrl) { %>
                                        <a href="<%= instagramUrl %>" target="_blank" rel="noopener"
                                            class="chat-option instagram-option" aria-label="Follow on Instagram">
                                            <div class="chat-option-icon">
                                                <i class="bi bi-instagram"></i>
                                            </div>
                                            <div class="chat-option-text">
                                                <span class="chat-option-title">Instagram</span>
                                                <span class="chat-option-desc">Follow us</span>
                                            </div>
                                        </a>
                                        <% } %>
                        </div>
                </div>
            </div>
        </div>

                            <!-- FEATURES SECTION -->
                            <section class="bg-light-custom">
                                <div class="container">
                                    <div class="section-header slide-up">
                                        <h2>Why Choose Swadesi Carts?</h2>
                                        <p>Excellence in every category</p>
                                    </div>
                                    <div class="row g-4">
                                        <div class="col-md-4 scroll-animate">
                                            <div class="text-center">
                                                <div class="feature-icon">
                                                    <i class="bi bi-shield-check"></i>
                                                </div>
                                                <h5>Authentic & Certified</h5>
                                                <p class="text-muted-custom">100% authentic products with proper
                                                    certifications and guarantees</p>
                                            </div>
                                        </div>
                                        <div class="col-md-4 scroll-animate">
                                            <div class="text-center">
                                                <div class="feature-icon">
                                                    <i class="bi bi-lightning-charge"></i>
                                                </div>
                                                <h5>Expert Services</h5>
                                                <p class="text-muted-custom">Professional tech solutions from
                                                    experienced developers</p>
                                            </div>
                                        </div>
                                        <div class="col-md-4 scroll-animate">
                                            <div class="text-center">
                                                <div class="feature-icon">
                                                    <i class="bi bi-truck"></i>
                                                </div>
                                                <h5>Fast Delivery</h5>
                                                <p class="text-muted-custom">Quick and reliable shipping to your
                                                    doorstep</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- SEASONAL PRODUCTS -->
                            <section>
                                <div class="container">
                                    <div class="section-header slide-up">
                                        <h2>Seasonal Products</h2>
                                        <p>Fresh and authentic seasonal items</p>
                                    </div>
                                    <% if (featuredSeasonal.length> 0) { %>
                                        <div class="row g-4">
                                            <% featuredSeasonal.forEach(product=> { %>
                                                <div class="col-md-6 col-lg-4 col-xl-3 scroll-animate">
                                                    <div class="card product-card">
                                                        <div class="product-image-wrapper">
                                                            <% if (product.featuredImage && product.featuredImage.url) {
                                                                %>
                                                                <img src="<%= product.featuredImage.url %>"
                                                                    alt="<%= product.title %>">
                                                                <% } else { %>
                                                                    <div
                                                                        style="background: linear-gradient(135deg, #e0e0e0, #f5f5f5); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 4rem; opacity: 0.3;">
                                                                        🛍️
                                                                    </div>
                                                                    <% } %>
                                                                        <span class="product-badge">New</span>
                                                        </div>
                                                        <div class="product-card-body">
                                                            <span class="product-category" style="color: #5C3A21 !important;">
                                                                <%= product.category %>
                                                            </span>
                                                            <h5 class="product-card-title" style="color: #5C3A21 !important;">
                                                                <%= product.title %>
                                                            </h5>
                                                            <p class="product-card-description" style="color: #5C3A21 !important;">
                                                                <%= product.shortDescription %>
                                                            </p>
                                                            <% if (product.price) { %>
                                                                <div class="product-price" style="color: #5C3A21 !important;">
                                                                    ₹<%= product.price %>
                                                                    <% if (product.priceUnit) { %>
                                                                        <span style="color: #5C3A21 !important; font-weight: 800;">/ <%= product.priceUnit %></span>
                                                                    <% } %>
                                                                </div>
                                                            <% } %>
                                                            <% if (product.minOrderQuantity) { %>
                                                                <div class="product-moq small text-muted-custom mb-2" style="font-size: 0.75rem;">
                                                                    <i class="bi bi-box-seam"></i> Min. Order: <%= product.minOrderQuantity %> <%= product.minOrderUnit %>
                                                                </div>
                                                            <% } %>
                                                            <div class="product-card-footer">
                                                                <a href="/seasonal-products/<%= product.slug %>"
                                                                    class="btn btn-primary">View Details</a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }); %>
                                        </div>
                                        <div class="text-center mt-4">
                                            <a href="/seasonal-products" class="btn btn-accent btn-lg">View All Seasonal
                                                Products</a>
                                        </div>
                                        <% } else { %>
                                            <div class="alert alert-info text-center"><i class="bi bi-info-circle"></i>
                                                Coming soon</div>
                                            <% } %>
                                </div>
                            </section>

                            <!-- TECH PACKAGES -->
                            <section class="bg-light-custom">
                                <div class="container">
                                    <div class="section-header slide-up">
                                        <h2>Tech Services & Packages</h2>
                                        <p>Professional development solutions</p>
                                    </div>
                                    <% if (featuredTech.length> 0) { %>
                                        <div class="row g-4">
                                            <% featuredTech.forEach(package=> { %>
                                                <div class="col-md-6 col-lg-4 col-xl-3 scroll-animate">
                                                    <div class="card product-card">
                                                        <div class="product-image-wrapper">
                                                            <% if (package.featuredImage && package.featuredImage.url) {
                                                                %>
                                                                <img src="<%= package.featuredImage.url %>"
                                                                    alt="<%= package.title %>">
                                                                <% } else { %>
                                                                    <div
