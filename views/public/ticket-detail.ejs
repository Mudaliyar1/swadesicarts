<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-new.css">
    <style>
        body, html { height: 100%; width: 100%; margin: 0; padding: 0; overflow: hidden; }
        .sc-page-bg { background: #dcd7d2; height: 100%; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; } /* Darker background for outside */
        
        .chat-container { width: 100%; max-width: 900px; height: 100%; display: flex; flex-direction: column; background: transparent; box-shadow: 0 0 30px rgba(0,0,0,0.1); }
        
        .chat-box { background: transparent; display: flex; flex-direction: column; flex: 1; height: 100%; overflow: hidden; }
        
        .chat-header { background: #008069; color: #ffffff; padding: 0.8rem 1.2rem; display: flex; justify-content: space-between; align-items: center; z-index: 10; flex-shrink: 0; }
        
        /* The chat background pattern */
        .chat-body { 
            padding: 2rem; 
            flex: 1; 
            overflow-y: auto; 
            background-color: #efeae2;
            background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 20.5V18H0v-2h20v-2H0v-2h20v-2H0V8h20V6H0V4h20V2H0V0h22v20h2V0h2v20h2V0h2v20h2V0h2v20h2V0h2v20h2v2H20v-1.5zM0 20h2v20H0V20zm4 0h2v20H4V20zm4 0h2v20H8V20zm4 0h2v20h-2V20zm4 0h2v20h-2V20zm4 4h20v2H20v-2zm0 4h20v2H20v-2zm0 4h20v2H20v-2zm0 4h20v2H20v-2z' fill='%23d8d3cc' fill-opacity='0.4' fill-rule='evenodd'/%3E%3C/svg%3E");
            display: flex; 
            flex-direction: column; 
            gap: 0.5rem; 
        }
        
        .chat-message { display: flex; flex-direction: column; max-width: 75%; margin-bottom: 0.5rem; }
        .chat-message.user { align-self: flex-end; align-items: flex-end; }
        .chat-message.admin { align-self: flex-start; align-items: flex-start; }
        
        .msg-bubble { 
            padding: 0.6rem 0.8rem 0.5rem 0.8rem; 
            font-size: 0.95rem; 
            line-height: 1.4; 
            word-wrap: break-word;
            box-shadow: 0 1px 0.5px rgba(11,20,26,.13);
            position: relative;
        }
        
        .msg-text { white-space: pre-wrap; margin-bottom: 2px; }
        
        /* User (Customer) sent this (WhatsApp Green) */
        .chat-message.user .msg-bubble { 
            background: #d9fdd3; color: #111b21; 
            border-radius: 8px 0 8px 8px; 
        }
        
        /* Admin sent this (WhatsApp White) */
        .chat-message.admin .msg-bubble { 
            background: #ffffff; color: #111b21; 
            border-radius: 0 8px 8px 8px;
        }

        /* The tiny tail on bubbles */
        .chat-message.user .msg-bubble::before {
            content: ''; position: absolute; top: 0; right: -8px; width: 0; height: 0; 
            border-top: 0 solid transparent; border-left: 8px solid #d9fdd3; border-bottom: 8px solid transparent;
        }
        .chat-message.admin .msg-bubble::before {
            content: ''; position: absolute; top: 0; left: -8px; width: 0; height: 0; 
            border-top: 0 solid transparent; border-right: 8px solid #ffffff; border-bottom: 8px solid transparent;
        }

        .msg-author-name { font-size: 0.75rem; font-weight: 600; margin-bottom: 2px; }
        .chat-message.admin .msg-author-name { color: #008069; }

        .msg-meta { font-size: 0.68rem; color: #667781; display: flex; align-items: center; justify-content: flex-end; margin-top: 4px; gap: 4px; float: right; margin-left: 15px; }
        .msg-bubble::after { content: ""; display: table; clear: both; }
        
        .chat-footer { padding: 1rem; background: #f0f2f5; border-radius: 0 0 12px 12px; display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
        .reply-box { border-radius: 8px; border: none; padding: 0.8rem 1.2rem; width: 100%; font-size: 1rem; resize: none; outline: none; background: #ffffff; height: 50px; overflow-y: hidden; }
        .reply-box:focus { box-shadow: 0 0 0 1px #008069; }
        
        .send-btn { width: 50px; height: 50px; border-radius: 50%; background: #008069; color: white; border: none; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; cursor: pointer; transition: background 0.2s; }
        .send-btn:hover { background: #016b58; }
        
        .sc-badge { font-size: 0.75rem; padding: 0.3rem 0.6rem; border-radius: 6px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; background: rgba(255,255,255,0.2); color: #fff; border: 1px solid rgba(255,255,255,0.4); }
        
        /* Custom Scrollbar */
        .chat-body::-webkit-scrollbar { width: 6px; }
        .chat-body::-webkit-scrollbar-track { background: transparent; }
        .chat-body::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.2); border-radius: 10px; }
        .bg-open { background: #e0e7ff; color: #3730a3; }
        .bg-pending { background: #fef3c7; color: #92400e; }
        .bg-resolved { background: #dcfce7; color: #166534; }
        .bg-closed { background: #f3f4f6; color: #374151; }

        /* Attachment styles */
        .attach-btn { width: 40px; height: 40px; border-radius: 50%; background: transparent; color: #54656f; border: none; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; cursor: pointer; transition: background 0.2s; flex-shrink: 0; }
        .attach-btn:hover { background: rgba(0,0,0,0.08); }
        .reply-area-wrap { flex: 1; display: flex; flex-direction: column; gap: 4px; }
        .attachment-preview-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 6px 0; }
        .att-preview-chip { display: flex; align-items: center; gap: 6px; background: rgba(0,128,105,0.1); border: 1px solid rgba(0,128,105,0.3); border-radius: 20px; padding: 4px 10px; font-size: 0.78rem; max-width: 160px; }
        .att-preview-chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .att-preview-chip .remove-att { cursor: pointer; color: #666; }
        .msg-attachments { display: flex; flex-direction: column; gap: 6px; margin-bottom: 4px; }
        .msg-attachment-img { max-width: 200px; max-height: 200px; border-radius: 8px; cursor: pointer; object-fit: cover; display: block; }
        .msg-attachment-video { max-width: 250px; border-radius: 8px; display: block; }
        .msg-attachment-pdf { display: flex; align-items: center; gap: 8px; text-decoration: none; color: #333; background: rgba(0,0,0,0.05); border-radius: 8px; padding: 8px 12px; }
        .msg-attachment-pdf:hover { background: rgba(0,0,0,0.1); }
        .upload-progress { font-size: 0.8rem; color: #008069; display: flex; align-items: center; gap: 6px; }

    </style>
</head>
<body>

<div class="sc-page-bg">
    <div class="chat-container">

        <% if (locals.success && locals.success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show m-0 rounded-0 flex-shrink-0" role="alert">
                <%= locals.success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (locals.error && locals.error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show m-0 rounded-0 flex-shrink-0" role="alert">
                <%= locals.error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="chat-box">
            <!-- WhatsApp style header -->
            <div class="chat-header px-2 px-sm-4 py-2">
                <div class="d-flex align-items-center gap-2" style="min-width: 0; flex: 1 1 auto;">
                    <a href="/tickets" class="text-white text-decoration-none d-flex align-items-center justify-content-center flex-shrink-0" style="font-size: 1.2rem; cursor: pointer; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
                        <i class="bi bi-arrow-left"></i> <span class="ms-1 d-none d-sm-inline-block" style="font-size: 1rem; font-weight: 500;">Back</span>
                    </a>
                    <div class="rounded-circle bg-white text-dark d-flex align-items-center justify-content-center d-none d-sm-flex" style="width: 40px; height: 40px; font-size: 1.2rem; flex-shrink: 0;">
                        <i class="bi bi-headset"></i>
                    </div>
                    <div style="min-width: 0; flex-shrink: 1;">
                        <h5 class="mb-0 fw-bold text-truncate" style="font-family:'Inter', sans-serif; font-size: 1.1rem;"><%= ticket.ticketNumber %></h5>
                        <div class="text-truncate" style="font-size: 0.8rem; opacity: 0.9; max-width: 200px;"><%= ticket.subject %></div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1 gap-sm-2 flex-shrink-0">
                    <span class="sc-badge"><%= ticket.status %></span>
                    <% if(ticket.productId) { %>
                        <a href="/<%= ticket.productType === 'tech' ? 'tech-packages' : ticket.productType + '-products' %>/<%= ticket.productId %>" class="btn btn-sm bg-white text-success rounded-2 px-2 px-sm-3 py-1 shadow-sm text-nowrap" style="font-size: 0.75rem; font-weight: 600;">View Product</a>
                    <% } %>
                </div>
            </div>
                    
                    <!-- Chat Body -->
                    <div class="chat-body" id="chatBody">
                        <div class="text-center mb-3">
                            <span class="badge" style="background: #e1f3fb; color: #435a64; font-weight: normal; padding: 6px 12px; box-shadow: 0 1px 1px rgba(0,0,0,0.05); font-size: 0.75rem;">
                                Ticket Created on <%= new Date(ticket.createdAt).toLocaleDateString([], { dateStyle: 'long' }) %>
                            </span>
                        </div>

                        <!-- Initial Message (User) -->
                        <div class="chat-message user">
                            <div class="msg-bubble">
                                <div class="msg-text"><%= ticket.description %></div>
                                <div class="msg-meta">
                                    <%= new Date(ticket.createdAt).toLocaleTimeString([], { timeStyle: 'short' }) %> <i class="bi bi-check-all text-primary ms-1" style="font-size: 1rem;"></i>
                                </div>
                            </div>
                        </div>

                        <% ticket.messages.forEach(msg => { %>
                            <div class="chat-message <%= msg.sender === 'user' ? 'user' : 'admin' %>">
                                <div class="msg-bubble">
                                    <% if (msg.sender === 'admin') { %>
                                        <div class="msg-author-name">Support Team</div>
                                    <% } %>
                                    <% if (msg.message) { %>
                                    <div class="msg-text"><%= msg.message %></div>
                                    <% } %>
                                    <% if (msg.attachments && msg.attachments.length > 0) { %>
                                    <div class="msg-attachments">
                                        <% msg.attachments.forEach(att => { %>
                                            <% if (att.fileType === 'image') { %>
                                                <a href="<%= att.url %>" target="_blank" rel="noopener noreferrer">
                                                    <img src="<%= att.url %>" alt="<%= att.filename %>" class="msg-attachment-img" loading="lazy">
                                                </a>
                                            <% } else if (att.fileType === 'video') { %>
                                                <video class="msg-attachment-video" controls preload="metadata">
                                                    <source src="<%= att.url %>">
                                                    Your browser does not support the video tag.
                                                </video>
                                            <% } else if (att.fileType === 'pdf') { %>
                                                <a href="https://docs.google.com/viewer?url=<%= encodeURIComponent(att.url) %>" target="_blank" rel="noopener noreferrer" class="msg-attachment-pdf">
                                                    <i class="bi bi-file-earmark-pdf-fill text-danger fs-4"></i>
                                                    <span><%= att.filename || 'document.pdf' %></span>
                                                </a>
                                            <% } %>
                                        <% }) %>
                                    </div>
                                    <% } %>
                                    <div class="msg-meta">
                                        <% if(msg.isEmailSync) { %><i class="bi bi-envelope"></i><% } %>
                                        <%= new Date(msg.createdAt).toLocaleTimeString([], { timeStyle: 'short' }) %>
                                        <% if (msg.sender === 'user') { %><i class="bi bi-check-all text-primary ms-1" style="font-size: 1rem;"></i><% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                        
                        <!-- Typing Indicator -->
                        <div id="typingIndicator" class="chat-message admin" style="display: none;">
                            <div class="msg-bubble text-muted fst-italic" style="padding: 0.4rem 0.8rem; background: rgba(255,255,255,0.8); font-size: 0.8rem;">
                                Support Team is typing...
                            </div>
                        </div>
                    </div>

                    <!-- Chat Footer -->
                    <% if (ticket.status !== 'closed') { %>
                        <form id="replyForm" action="/tickets/<%= ticket.ticketNumber %>/reply" method="POST" class="chat-footer" enctype="multipart/form-data">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="file" id="attachmentInput" name="attachments" multiple accept="image/*,video/*,application/pdf" style="display:none;">
                            <button type="button" id="attachBtn" class="attach-btn" title="Attach file">
                                <i class="bi bi-paperclip"></i>
                            </button>
                            <div class="reply-area-wrap">
                                <textarea id="messageInput" name="message" class="reply-box" placeholder="Type a message"></textarea>
                                <div id="attachmentPreview" class="attachment-preview-bar" style="display:none;"></div>
                            </div>
                            <button type="submit" class="send-btn">
                                <i class="bi bi-send-fill" style="margin-right: 2px; margin-top: 2px;"></i>
                            </button>
                        </form>
                    <% } else { %>
                        <div class="chat-footer justify-content-center py-3">
                            <span class="text-muted small"><i class="bi bi-lock-fill me-1"></i> You cannot reply to a closed ticket.</span>
                        </div>
                    <% } %>
                </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
    const ticketNumber = '<%= ticket.ticketNumber %>';
    const chatBody = document.getElementById('chatBody');
    const replyForm = document.getElementById('replyForm');
    const messageInput = document.getElementById('messageInput');
    const typingIndicator = document.getElementById('typingIndicator');
    const attachBtn = document.getElementById('attachBtn');
    const attachmentInput = document.getElementById('attachmentInput');
    const attachmentPreview = document.getElementById('attachmentPreview');
    
    // Auto-scroll chat to bottom
    const scrollToBottom = () => chatBody.scrollTop = chatBody.scrollHeight;
    scrollToBottom();
    
    // Socket.io Integration
    const socket = io();
    socket.emit('joinTicket', ticketNumber);

    // Render attachments HTML from socket message
    const renderAttachments = (attachments) => {
        if (!attachments || attachments.length === 0) return '';
        return `<div class="msg-attachments">${attachments.map(att => {
            if (att.fileType === 'image') {
                return `<a href="${att.url}" target="_blank" rel="noopener noreferrer"><img src="${att.url}" alt="${att.filename}" class="msg-attachment-img" loading="lazy"></a>`;
            } else if (att.fileType === 'video') {
                return `<video class="msg-attachment-video" controls preload="metadata"><source src="${att.url}">Your browser does not support the video tag.</video>`;
            } else if (att.fileType === 'pdf') {
                return `<a href="https://docs.google.com/viewer?url=${encodeURIComponent(att.url)}" target="_blank" rel="noopener noreferrer" class="msg-attachment-pdf"><i class="bi bi-file-earmark-pdf-fill text-danger fs-4"></i><span>${att.filename || 'document.pdf'}</span></a>`;
            }
            return '';
        }).join('')}</div>`;
    };
    
    // Handle incoming messages
    socket.on('newMessage', (msg) => {
        const isUser = msg.sender === 'user';
        const timeStr = new Date(msg.createdAt).toLocaleTimeString([], { timeStyle: 'short' });
        
        let html = `
            <div class="chat-message ${isUser ? 'user' : 'admin'}">
                <div class="msg-bubble">
                    ${!isUser ? '<div class="msg-author-name">Support Team</div>' : ''}
                    ${msg.message ? `<div class="msg-text">${msg.message}</div>` : ''}
                    ${renderAttachments(msg.attachments)}
                    <div class="msg-meta">
                        ${msg.isEmailSync ? '<i class="bi bi-envelope"></i>' : ''}
                        ${timeStr}
                        ${isUser ? '<i class="bi bi-check-all text-primary ms-1" style="font-size: 1rem;"></i>' : ''}
                    </div>
                </div>
            </div>
        `;
        
        typingIndicator.insertAdjacentHTML('beforebegin', html);
        scrollToBottom();
    });
    
    // Handle typing indicator
    socket.on('typing', (data) => {
        if (data.sender === 'admin') {
            typingIndicator.style.display = 'flex';
            scrollToBottom();
        }
    });
    
    socket.on('stopTyping', (data) => {
        if (data.sender === 'admin') {
            typingIndicator.style.display = 'none';
        }
    });

    // Attachment file picker
    if (attachBtn && attachmentInput) {
        attachBtn.addEventListener('click', () => attachmentInput.click());

        attachmentInput.addEventListener('change', () => {
            const files = Array.from(attachmentInput.files);
            if (files.length > 5) {
                alert('You can attach a maximum of 5 files at once.');
                attachmentInput.value = '';
                return;
            }
            const oversized = files.filter(f => f.size > 25 * 1024 * 1024);
            if (oversized.length > 0) {
                alert(`File(s) too large: ${oversized.map(f => f.name).join(', ')}. Max size is 25MB per file.`);
                attachmentInput.value = '';
                return;
            }

            // Show preview chips
            attachmentPreview.innerHTML = files.map((f, i) => `
                <div class="att-preview-chip" data-index="${i}">
                    <i class="bi ${f.type.startsWith('image/') ? 'bi-image' : f.type.startsWith('video/') ? 'bi-camera-video' : 'bi-file-earmark-pdf'}"></i>
                    <span title="${f.name}">${f.name}</span>
                    <span class="remove-att" data-index="${i}">✕</span>
                </div>
            `).join('');
            attachmentPreview.style.display = files.length > 0 ? 'flex' : 'none';

            attachmentPreview.querySelectorAll('.remove-att').forEach(btn => {
                btn.addEventListener('click', () => {
                    attachmentInput.value = '';
                    attachmentPreview.innerHTML = '';
                    attachmentPreview.style.display = 'none';
                });
            });
        });
    }
    
    if (replyForm) {
        let typingTimer;
        messageInput.addEventListener('input', () => {
            socket.emit('typing', { ticketNumber, sender: 'user' });
            clearTimeout(typingTimer);
            typingTimer = setTimeout(() => {
                socket.emit('stopTyping', { ticketNumber, sender: 'user' });
            }, 2000);
        });
        
        replyForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = messageInput.value.trim();
            const files = attachmentInput ? attachmentInput.files : [];
            if (!text && (!files || files.length === 0)) return;
            
            messageInput.value = '';
            if (attachmentPreview) { attachmentPreview.innerHTML = ''; attachmentPreview.style.display = 'none'; }
            socket.emit('stopTyping', { ticketNumber, sender: 'user' });

            const sendBtn = replyForm.querySelector('.send-btn');
            if (sendBtn) { sendBtn.disabled = true; sendBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>'; }

            try {
                const formData = new FormData();
                formData.append('_csrf', '<%= csrfToken %>');
                if (text) formData.append('message', text);
                if (files && files.length > 0) {
                    Array.from(files).forEach(f => formData.append('attachments', f));
                }
                const response = await fetch('/tickets/' + ticketNumber + '/reply', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 
                        'Accept': 'application/json',
                        'x-csrf-token': '<%= csrfToken %>' 
                    },
                    body: formData
                });
                if (!response.ok) {
                    throw new Error('Failed to send message: ' + response.statusText);
                }
                if (attachmentInput) attachmentInput.value = '';
            } catch (err) {
                console.error('Failed to send message:', err);
                alert('Failed to send message. Please try again.');
            } finally {
                if (sendBtn) { sendBtn.disabled = false; sendBtn.innerHTML = '<i class="bi bi-send-fill" style="margin-right: 2px; margin-top: 2px;"></i>'; }
            }
        });
        
        // Enter to send (Shift+Enter for newline)
        messageInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                replyForm.dispatchEvent(new Event('submit'));
            }
        });
    }
</script>
</body>
</html>
