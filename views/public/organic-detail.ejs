<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <%- include('../partials/dynamic-styles') %>
    <style>
        /* ── Mobile-first product detail layout ── */
        .product-detail-header .badge {
            font-size: 0.75rem;
            margin-right: 0.35rem;
        }
        .product-detail-header h1 {
            font-size: 1.25rem;
            line-height: 1.3;
        }

        @media (min-width: 992px) {
            .product-detail-header h1 { font-size: 1.75rem; }
            .mobile-only { display: none !important; }
            .carousel-sticky-wrap { position: static; }
        }
        @media (max-width: 991.98px) {
            .desktop-only { display: none !important; }
            .carousel-sticky-wrap {
                position: sticky;
                top: 0;
                z-index: 10;
                background: #fff;
                padding-bottom: 0.25rem;
            }
        }
        @media (max-width: 575.98px) {
            .breadcrumb { font-size: 0.78rem; }
        }

        /* Force panel headings to black regardless of admin theme color */
        .detail-panel h5,
        .detail-panel h5.fw-bold,
        .inquiry-section h5,
        .inquiry-section h5.fw-bold {
            color: #1a1a1a !important;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <% if (success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <section class="py-3 py-lg-5">
        <div class="container">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/organic-products">Organic Products</a></li>
                    <li class="breadcrumb-item active text-truncate" style="max-width:160px;"><%= product.title %></li>
                </ol>
            </nav>

            <!-- MOBILE: Title & badges shown ABOVE the image -->
            <div class="product-detail-header mobile-only mb-3">
                <span class="badge bg-success"><i class="bi bi-award"></i> Organic Certified</span>
                <span class="badge bg-swadesi"><%= product.category %></span>
                <% if (product.inStock) { %>
                    <span class="badge bg-success">In Stock</span>
                <% } else { %>
                    <span class="badge bg-secondary">Out of Stock</span>
                <% } %>
                <h1 class="fw-bold mt-2 mb-1"><%= product.title %></h1>
                <p class="text-muted small mb-0"><%= product.shortDescription %></p>
            </div>

            <div class="row g-4">

                <!-- LEFT: Image / Carousel -->
                <div class="col-12 col-lg-6">
                    <div class="carousel-sticky-wrap">
                        <%- include('../partials/media-carousel', { gallery: product.gallery, featuredImage: product.featuredImage }) %>
                    </div>
                </div>

                <!-- RIGHT: Info panel -->
                <div class="col-12 col-lg-6">

                    <!-- DESKTOP ONLY: Header inside right column -->
                    <div class="desktop-only mb-3">
                        <span class="badge bg-success mb-2"><i class="bi bi-award"></i> Organic Certified</span>
                        <span class="badge bg-swadesi mb-2"><%= product.category %></span>
                        <% if (product.inStock) { %>
                            <span class="badge bg-success mb-2">In Stock</span>
                        <% } else { %>
                            <span class="badge bg-secondary mb-2">Out of Stock</span>
                        <% } %>
                        <h1 class="fw-bold mb-2"><%= product.title %></h1>
                        <p class="text-muted mb-4"><%= product.shortDescription %></p>
                    </div>

                    <!-- Health Benefits -->
                    <% if (product.benefits && product.benefits.length > 0) { %>
                        <div class="detail-panel mb-3">
                            <div class="card-body">
                                <h5 class="fw-bold mb-3" style="color:#000000 !important">Health Benefits</h5>
                                <ul class="list-unstyled mb-0">
                                    <% product.benefits.forEach(benefit => { %>
                                        <li class="mb-2"><i class="bi bi-heart-fill text-danger"></i> <%= benefit %></li>
                                    <% }); %>
                                </ul>
                            </div>
                        </div>
                    <% } %>

                    <!-- Product Description -->
                    <div class="detail-panel mb-3">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3" style="color:#000000 !important">Product Description</h5>
                            <p class="mb-0" style="white-space: pre-wrap;"><%= product.fullDescription %></p>
                        </div>
                    </div>

                    <!-- Inquiry Form -->
                    <div class="inquiry-section card border-swadesi shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3" style="color:#000000 !important">
                                <i class="bi bi-chat-dots text-swadesi"></i> Submit Inquiry
                            </h5>
                            <form action="/organic-products/inquiry" method="POST" id="inquiryForm">
                                <input type="hidden" name="productId" value="<%= product._id %>">

                                <div class="mb-3">
                                    <label class="form-label">Name *</label>
                                    <input type="text" class="form-control" name="name" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Mobile Number *</label>
                                    <input type="tel" class="form-control" name="mobile" pattern="[0-9]{10}" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Email *</label>
                                    <input type="email" class="form-control" name="email" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Your Requirement *</label>
                                    <textarea class="form-control" name="requirement" rows="4" required></textarea>
                                </div>

                                <button type="submit" class="btn btn-swadesi w-100" id="submitBtn">
                                    <i class="bi bi-send"></i> Submit Inquiry
                                </button>
                            </form>
                        </div>
                    </div>

                </div><!-- /right col -->
            </div><!-- /row -->

        </div>
    </section>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
    <script>
        document.getElementById('inquiryForm').addEventListener('submit', function() {
            document.getElementById('submitBtn').innerHTML = '<span class="spinner-border spinner-border-sm"></span> Submitting...';
            document.getElementById('submitBtn').disabled = true;
        });
    </script>
</body>
</html>
