<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-new.css">
    <%- include('../partials/dynamic-styles') %>
    <%- include('../partials/seo-meta') %>
    <style>
        /* Scoped overrides to make form labels and text black instead of yellow */
        .card.shadow-lg,
        .card.shadow-lg label,
        .card.shadow-lg div,
        .card.shadow-lg p,
        .card.shadow-lg span,
        .card.shadow-lg .form-text,
        .card.shadow-lg .form-label {
            color: #212529 !important;
        }
        .card.shadow-lg input,
        .card.shadow-lg select,
        .card.shadow-lg textarea {
            color: #212529 !important;
            border-color: #ced4da !important;
        }
        .card.shadow-lg input:focus,
        .card.shadow-lg select:focus,
        .card.shadow-lg textarea:focus {
            border-color: #000000 !important;
            box-shadow: 0 0 0 0.25rem rgba(0, 0, 0, 0.1) !important;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar-new') %>

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mt-2">
        <div class="container">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/tech-packages">Tech Packages</a></li>
                <li class="breadcrumb-item active">Inquiry</li>
            </ol>
        </div>
    </nav>

    <!-- Page Header -->
    <div class="page-header" style="background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%); padding: 30px 0;">
        <div class="container">
            <h1 class="mb-2">Tech Package Inquiry</h1>
            <p class="lead mb-0">Send us your inquiry about our tech solutions</p>
        </div>
    </div>

    <!-- Inquiry Form -->
    <section class="py-4">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="card shadow-lg">
                        <div class="card-body p-4">
                            <% if (locals.messages && messages.error) { %>
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <%= messages.error %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            <% } %>
                            <% if (locals.messages && messages.success) { %>
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <%= messages.success %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            <% } %>

                            <form action="/tech-packages/inquiry-submit" method="POST" novalidate data-inquiry-autofill="true">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="mb-3">
                                    <label for="name" class="form-label">Full Name *</label>
                                    <input type="text" class="form-control" id="name" name="name" placeholder="Enter your full name" autocomplete="name" required>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="email" class="form-label">Email *</label>
                                        <div class="input-group">
                                            <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email" autocomplete="email" required
                                                <% if (isUserLoggedIn && userEmail) { %>
                                                    value="<%= userEmail %>" readonly
                                                <% } %>
                                            >
                                            <% if (isUserLoggedIn && userEmail) { %>
                                                <button class="btn btn-outline-dark" type="button" id="editEmailBtn">
                                                    <i class="bi bi-pencil-square"></i> Edit
                                                </button>
                                            <% } %>
                                        </div>
                                        <% if (isUserLoggedIn && userEmail) { %>
                                            <div class="form-text text-muted" style="font-size: 0.75rem;">Your registered email is auto-filled. Click Edit to change the communication email for this inquiry.</div>
                                        <% } %>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="mobile" class="form-label">Mobile Number *</label>
                                        <input type="tel" class="form-control" id="mobile" name="mobile" placeholder="Enter your mobile number" autocomplete="tel" required>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="product" class="form-label">Select Tech Package *</label>
                                    <select class="form-select" id="product" name="productId" required>
                                        <option value="">-- Select a tech package --</option>
                                        <% if (products && products.length > 0) { %>
                                            <% products.forEach(product => { %>
                                                <option value="<%= product._id %>" data-title="<%= product.title %>" data-category="<%= product.category %>" data-price="<%= product.price && product.price.displayText ? product.price.displayText : '' %>" data-description="<%= product.shortDescription || '' %>" data-type="tech" <%= selectedProductId === product._id.toString() ? 'selected' : '' %>><%= product.title %> - <%= product.price.displayText || ('₹' + product.price) %></option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>

                                <input type="hidden" name="productTitle" value="">
                                <input type="hidden" name="productCategory" value="">
                                <input type="hidden" name="productPrice" value="">
                                <input type="hidden" name="productType" value="tech">
                                <input type="hidden" name="packageName" value="">

                                <div class="mb-3">
                                    <label for="requirement" class="form-label">Your Requirement / Message *</label>
                                    <textarea class="form-control" id="requirement" name="requirement" rows="5" placeholder="Please describe your requirement in detail..." autocomplete="off" required></textarea>
                                </div>

                                <div class="d-grid gap-2 d-sm-flex justify-content-between">
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="bi bi-send"></i> Submit Inquiry
                                    </button>
                                    <a href="/tech-packages" class="btn btn-outline-secondary btn-lg">
                                        <i class="bi bi-arrow-left"></i> Back to Packages
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

        <%- include('../partials/footer-new') %>

        <div id="inquiry-prefill-data" data-prefill="<%= JSON.stringify(inquiryPrefill || {}) %>" style="display: none;"></div>
        <script>
            const prefillEl = document.getElementById('inquiry-prefill-data');
            window.__INQUIRY_PREFILL__ = prefillEl ? JSON.parse(prefillEl.dataset.prefill) : {};
        </script>
        <script src="/js/inquiry-autofill.js"></script>
        <% if (isUserLoggedIn && userEmail) { %>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const editEmailBtn = document.getElementById('editEmailBtn');
                const emailInput = document.getElementById('email');
                if (editEmailBtn && emailInput) {
                    editEmailBtn.addEventListener('click', function() {
                        if (emailInput.hasAttribute('readonly')) {
                            emailInput.removeAttribute('readonly');
                            emailInput.focus();
                            editEmailBtn.innerHTML = '<i class="bi bi-check-lg"></i> Lock';
                            editEmailBtn.classList.remove('btn-outline-dark');
                            editEmailBtn.classList.add('btn-dark');
                        } else {
                            emailInput.setAttribute('readonly', 'readonly');
                            editEmailBtn.innerHTML = '<i class="bi bi-pencil-square"></i> Edit';
                            editEmailBtn.classList.remove('btn-dark');
                            editEmailBtn.classList.add('btn-outline-dark');
                        }
                    });
                }
            });
        </script>
        <% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
