<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-new.css">
    <%- include('../partials/dynamic-styles') %>
    <% if (typeof seo !== 'undefined') { %>
        <%- include('../partials/seo-meta') %>
    <% } %>

    <%
    let isDarkTheme = false; 
    let btnTextColor = '#111111'; // Default dark text for bright buttons (like yellow)
    if (typeof siteSettings !== 'undefined' && siteSettings.colors) {
        // Method 1: Check background color explicitly
        let bgValue = siteSettings.colors.bodyBackgroundColor || siteSettings.colors.background || '';
        bgValue = bgValue.trim();
        
        // Method 2: Check text color (if text is bright, theme is dark)
        let textValue = siteSettings.colors.bodyText || '#000000';
        textValue = textValue.trim();

        // Calculate body background brightness
        if (bgValue.startsWith('#')) {
            let hex = bgValue.replace('#', '');
            if (hex.length === 3) hex = hex.split('').map(char => char + char).join('');
            if (hex.length === 6) {
                const r = parseInt(hex.substr(0, 2), 16);
                const g = parseInt(hex.substr(2, 2), 16);
                const b = parseInt(hex.substr(4, 2), 16);
                const brightness = ((r * 299) + (g * 587) + (b * 114)) / 1000;
                isDarkTheme = brightness < 128;
            }
        } else if (textValue.startsWith('#')) {
            let hex = textValue.replace('#', '');
            if (hex.length === 3) hex = hex.split('').map(char => char + char).join('');
            if (hex.length === 6) {
                const r = parseInt(hex.substr(0, 2), 16);
                const g = parseInt(hex.substr(2, 2), 16);
                const b = parseInt(hex.substr(4, 2), 16);
                const brightness = ((r * 299) + (g * 587) + (b * 114)) / 1000;
                isDarkTheme = brightness > 128; // Bright text means dark theme
            }
        }

        // Calculate accent color brightness for button text contrast
        let accentValue = siteSettings.colors.accent || '#FFD700';
        accentValue = accentValue.trim();
        if (accentValue.startsWith('#')) {
            let hex = accentValue.replace('#', '');
            if (hex.length === 3) hex = hex.split('').map(char => char + char).join('');
            if (hex.length === 6) {
                const r = parseInt(hex.substr(0, 2), 16);
                const g = parseInt(hex.substr(2, 2), 16);
                const b = parseInt(hex.substr(4, 2), 16);
                const brightness = ((r * 299) + (g * 587) + (b * 114)) / 1000;
                if (brightness < 128) {
                    btnTextColor = '#ffffff'; // Dark button needs white text
                }
            }
        }
    }
    %>

    <style>
        :root {
            --profile-card-bg: <%= isDarkTheme ? 'rgba(255, 255, 255, 0.04)' : 'rgba(255, 255, 255, 1)' %>;
            --profile-card-border: <%= isDarkTheme ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.06)' %>;
            --profile-input-bg: <%= isDarkTheme ? 'rgba(0, 0, 0, 0.2)' : 'rgba(0, 0, 0, 0.02)' %>;
            --profile-input-border: <%= isDarkTheme ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)' %>;
            --profile-shadow: <%= isDarkTheme ? '0 10px 40px rgba(0, 0, 0, 0.2)' : '0 10px 40px rgba(0, 0, 0, 0.05)' %>;
            --profile-hover-bg: <%= isDarkTheme ? 'rgba(255, 255, 255, 0.06)' : 'rgba(0, 0, 0, 0.04)' %>;
            --profile-divider: <%= isDarkTheme ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.08)' %>;
            
            /* Fallback accent if siteSettings doesn't have one */
            --accent-color: <%= (typeof siteSettings !== 'undefined' && siteSettings.colors && siteSettings.colors.accent) ? siteSettings.colors.accent : '#FFD700' %>;
            --btn-text-color: <%= btnTextColor %>;
        }

        .profile-container {
            max-width: 1140px;
            margin: 0 auto;
            padding: 40px 15px;
            color: #ffffff !important; /* Force white text for the profile section */
        }

        .profile-container h1, 
        .profile-container h2, 
        .profile-container h3, 
        .profile-container h4, 
        .profile-container h5, 
        .profile-container h6,
        .profile-container p,
        .profile-container span,
        .profile-container div {
            color: #ffffff !important;
        }

        .profile-card {
            background: var(--profile-card-bg);
            border: 1px solid var(--profile-card-border);
            border-radius: 20px;
            box-shadow: var(--profile-shadow);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            overflow: hidden;
        }

        .avatar-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--accent-color);
            color: var(--btn-text-color); /* Dynamically use white or black depending on accent brightness */
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 800;
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
            border: 2px solid rgba(255, 255, 255, 0.1);
        }

        .profile-nav {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .profile-nav .nav-link {
            display: flex;
            align-items: center;
            padding: 0.85rem 1.2rem;
            border-radius: 12px;
            font-weight: 500;
            transition: all 0.3s ease;
            margin-bottom: 0.3rem;
            color: #ffffff !important; /* Force white text for normal links */
            /* opacity removed for max visibility */
        }

        .profile-nav .nav-link:hover, 
        .profile-nav .nav-link.active {
            background: var(--profile-hover-bg);
            color: #ffffff !important; /* Keep text white for maximum visibility */
            transform: translateX(4px);
        }

        .profile-nav .nav-link:hover i,
        .profile-nav .nav-link.active i {
            color: #ffffff !important;
        }

        .profile-nav .nav-link::after,
        .profile-nav .nav-link::before {
            display: none !important; /* Prevent global navbar underlines from appearing here */
        }

        .profile-label {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 0.5rem;
            /* opacity removed for max visibility */
        }

        .profile-input {
            background: var(--profile-input-bg) !important;
            border: 1.5px solid var(--profile-input-border) !important;
            border-radius: 12px !important;
            padding: 0.85rem 1.2rem !important;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            box-shadow: none !important;
            color: #ffffff !important; /* Force white text in inputs */
        }

        .profile-input:focus {
            border-color: var(--accent-color) !important;
            box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.1) !important;
            background: var(--profile-card-bg) !important;
        }

        .profile-input::placeholder {
            color: rgba(255, 255, 255, 0.6) !important; /* White placeholder */
            opacity: 1; /* Reset opacity since color has alpha */
        }

        .profile-btn {
            background: var(--accent-color);
            color: var(--btn-text-color) !important; /* Dynamically set based on button contrast */
            border: none;
            border-radius: 12px;
            padding: 0.85rem 1.8rem;
            font-weight: 700;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .profile-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            filter: brightness(1.05);
        }

        .section-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--profile-divider);
        }

        .theme-alert {
            border-radius: 16px;
            border: 1px solid var(--profile-card-border);
            backdrop-filter: blur(8px);
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar-new') %>
    
    <div class="profile-container">
        
        <!-- Alerts -->
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show theme-alert mb-4" role="alert" style="background: rgba(220, 53, 69, 0.1);">
                <i class="bi bi-exclamation-octagon-fill me-2"></i><%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        
        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show theme-alert mb-4" role="alert" style="background: rgba(25, 135, 84, 0.1);">
                <i class="bi bi-check-circle-fill me-2"></i><%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="row g-4">
            
            <!-- SIDEBAR DASHBOARD -->
            <div class="col-lg-3">
                <div class="profile-card p-4 h-100">
                    <div class="text-center mb-4 pt-2">
                        <div class="avatar-circle mx-auto mb-3">
                            <%= user.name.charAt(0).toUpperCase() %>
                        </div>
                        <h4 class="fw-bold mb-1"><%= user.name %></h4>
                        <p class="mb-0" style="font-size: 0.95rem;"><%= user.email %></p>
                    </div>
                    
                    <hr style="border-color: var(--profile-divider); opacity: 1;" class="my-4">
                    
                    <ul class="profile-nav">
                        <li>
                            <a href="/profile" class="nav-link active">
                                <i class="bi bi-person-circle me-3 fs-5"></i> Account Details
                            </a>
                        </li>
                        <!-- Future links could go here -->
                        <li class="mt-2">
                            <a href="/logout" class="nav-link text-danger">
                                <i class="bi bi-box-arrow-right me-3 fs-5"></i> Sign Out
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- MAIN CONTENT -->
            <div class="col-lg-9">
                <div class="row g-4">
                    
                    <!-- Personal Info Section -->
                    <div class="col-12">
                        <div class="profile-card p-4 p-md-5">
                            <div class="section-header">
                                <h3 class="fw-bold mb-0 d-flex align-items-center">
                                    <i class="bi bi-person-vcard me-3 fs-4"></i> 
                                    Personal Information
                                </h3>
                            </div>
                            
                            <form action="/profile" method="POST" id="profileForm">
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="profile-label mb-0">Email Address</label>
                                            <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1" id="btnChangeEmail" style="font-size: 0.75rem; border-color: rgba(255,255,255,0.2);">
                                                <i class="bi bi-pencil me-1"></i> Change Email
                                            </button>
                                        </div>
                                        
                                        <!-- Step 1: Current Email -->
                                        <div id="emailDisplayContainer">
                                            <input type="email" class="form-control profile-input" id="currentEmailInput" value="<%= user.email %>" readonly disabled style="cursor: not-allowed; opacity: 0.7;">
                                        </div>
                                        
                                        <!-- Step 2: OTP Verification -->
                                        <div id="emailOtpContainer" class="mt-2 p-3 border rounded-3 border-warning" style="display: none; background: rgba(255,193,7,0.1);">
                                            <label class="profile-label mb-2 text-warning"><i class="bi bi-envelope-check me-1"></i> Security Check: Enter OTP sent to your current email</label>
                                            <div class="input-group">
                                                <input type="text" class="form-control profile-input border-warning" id="emailOtpInput" placeholder="6-digit OTP" maxlength="6" style="border-radius: 12px 0 0 12px !important;">
                                                <button class="btn btn-warning fw-bold px-4 text-dark" type="button" id="btnVerifyEmailOtp" style="border-radius: 0 12px 12px 0 !important; z-index: 0;">Verify</button>
                                            </div>
                                            <small class="mt-2 d-block text-white" id="emailOtpMessage"></small>
                                        </div>
                                        
                                        <!-- Step 3: New Email Entry -->
                                        <div id="newEmailContainer" class="mt-2 p-3 border rounded-3 border-success" style="display: none; background: rgba(25,135,84,0.1);">
                                            <label class="profile-label text-success mb-2"><i class="bi bi-check-circle me-1"></i> Identity Verified! Enter your new email address</label>
                                            <div class="input-group">
                                                <input type="email" class="form-control profile-input border-success" id="newEmailInput" placeholder="new.email@example.com" style="border-radius: 12px 0 0 12px !important;">
                                                <button class="btn btn-success fw-bold px-4 text-white" type="button" id="btnSaveNewEmail" style="border-radius: 0 12px 12px 0 !important; z-index: 0;">Save Email</button>
                                            </div>
                                            <small class="mt-2 d-block text-white" id="newEmailMessage"></small>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="profile-label">Full Name *</label>
                                        <input type="text" class="form-control profile-input" name="name" value="<%= user.name %>" required>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="profile-label">Phone Number *</label>
                                        <input type="tel" class="form-control profile-input" name="phone" value="<%= user.phone %>" required>
                                    </div>
                                    
                                    <div class="col-md-12 text-end">
                                        <a href="/tickets" class="profile-btn text-decoration-none d-inline-block">
                                            <i class="bi bi-ticket-detailed me-2"></i> View My Tickets
                                        </a>
                                    </div>

                                    <div class="col-12 mt-4 pt-2 text-end">
                                        <button type="submit" class="profile-btn" id="profileSubmitBtn">
                                            <i class="bi bi-check2-circle me-2"></i> Save Changes
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Security Section -->
                    <div class="col-12">
                        <div class="profile-card p-4 p-md-5">
                            <div class="section-header">
                                <h3 class="fw-bold mb-0 d-flex align-items-center">
                                    <i class="bi bi-shield-lock me-3 fs-4"></i> 
                                    Security & Password
                                </h3>
                            </div>
                            
                            <form action="/profile/password" method="POST" id="passwordForm">
                                <div class="row g-4">
                                    <div class="col-12">
                                        <label class="profile-label">Current Password *</label>
                                        <input type="password" class="form-control profile-input" name="currentPassword" required placeholder="Enter current password">
                                    </div>

                                    <div class="col-md-6">
                                        <label class="profile-label">New Password *</label>
                                        <input type="password" class="form-control profile-input" name="newPassword" placeholder="Minimum 6 characters" minlength="6" required>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="profile-label">Confirm New Password *</label>
                                        <input type="password" class="form-control profile-input" name="confirmPassword" placeholder="Repeat new password" minlength="6" required>
                                    </div>
                                    
                                    <div class="col-12 mt-4 pt-2 text-end">
                                        <button type="submit" class="profile-btn" id="passwordSubmitBtn">
                                            <i class="bi bi-shield-check me-2"></i> Update Password
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <%- include('../partials/footer-new') %>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
    <script>
        document.getElementById('profileForm').addEventListener('submit', function() {
            var btn = document.getElementById('profileSubmitBtn');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Saving...';
            btn.disabled = true;
        });
        
        document.getElementById('passwordForm').addEventListener('submit', function() {
            var btn = document.getElementById('passwordSubmitBtn');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Updating...';
            btn.disabled = true;
        });

        // Email Change Logic
        const btnChangeEmail = document.getElementById('btnChangeEmail');
        const emailDisplayContainer = document.getElementById('emailDisplayContainer');
        const emailOtpContainer = document.getElementById('emailOtpContainer');
        const newEmailContainer = document.getElementById('newEmailContainer');
        const emailOtpInput = document.getElementById('emailOtpInput');
        const btnVerifyEmailOtp = document.getElementById('btnVerifyEmailOtp');
        const emailOtpMessage = document.getElementById('emailOtpMessage');
        const newEmailInput = document.getElementById('newEmailInput');
        const btnSaveNewEmail = document.getElementById('btnSaveNewEmail');
        const newEmailMessage = document.getElementById('newEmailMessage');

        btnChangeEmail.addEventListener('click', async () => {
            btnChangeEmail.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending OTP...';
            btnChangeEmail.disabled = true;

            try {
                const response = await fetch('/profile/email/request-otp', { method: 'POST' });
                const data = await response.json();
                
                if (data.success) {
                    btnChangeEmail.style.display = 'none';
                    emailDisplayContainer.style.display = 'none';
                    emailOtpContainer.style.display = 'block';
                    emailOtpMessage.className = 'mt-2 d-block text-white';
                    emailOtpMessage.innerText = data.message;
                    emailOtpInput.focus(); // Auto-focus the OTP field
                } else {
                    btnChangeEmail.innerHTML = '<i class="bi bi-pencil me-1"></i> Change Email';
                    btnChangeEmail.disabled = false;
                    alert(data.message || 'Failed to send OTP.');
                }
            } catch (error) {
                console.error(error);
                btnChangeEmail.innerHTML = '<i class="bi bi-pencil me-1"></i> Change Email';
                btnChangeEmail.disabled = false;
                alert('Network error while requesting OTP.');
            }
        });

        // Allow pressing Enter key to trigger Verify
        emailOtpInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault(); // Prevent main form submission
                btnVerifyEmailOtp.click();
            }
        });

        btnVerifyEmailOtp.addEventListener('click', async () => {
            const otp = emailOtpInput.value.trim();
            if (!otp) return alert('Please enter the OTP');

            btnVerifyEmailOtp.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            btnVerifyEmailOtp.disabled = true;

            try {
                const response = await fetch('/profile/email/verify-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ otp })
                });
                const data = await response.json();

                if (data.success) {
                    emailOtpContainer.style.display = 'none';
                    newEmailContainer.style.display = 'block';
                    newEmailInput.focus(); // Auto-focus new email field
                } else {
                    btnVerifyEmailOtp.innerHTML = 'Verify';
                    btnVerifyEmailOtp.disabled = false;
                    emailOtpMessage.className = 'mt-2 d-block text-danger fw-bold';
                    emailOtpMessage.innerText = data.message || 'Invalid OTP';
                }
            } catch (error) {
                console.error(error);
                btnVerifyEmailOtp.innerHTML = 'Verify';
                btnVerifyEmailOtp.disabled = false;
                emailOtpMessage.innerText = 'Network error verifying OTP.';
            }
        });

        // Allow pressing Enter key to trigger Save Email
        newEmailInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault(); // Prevent main form submission
                btnSaveNewEmail.click();
            }
        });

        btnSaveNewEmail.addEventListener('click', async () => {
            const newEmail = newEmailInput.value.trim();
            if (!newEmail) return alert('Please enter a new email address');

            btnSaveNewEmail.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            btnSaveNewEmail.disabled = true;

            try {
                const response = await fetch('/profile/email/update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ newEmail })
                });
                const data = await response.json();

                if (data.success) {
                    newEmailContainer.innerHTML = `<div class="alert alert-success border-0 bg-success bg-opacity-25 text-white mb-0"><i class="bi bi-check-circle-fill me-2"></i> ${data.message}</div>`;
                    document.getElementById('currentEmailInput').value = newEmail;
                    // Optionally, refresh page to reset UI after a few seconds
                    setTimeout(() => window.location.reload(), 2000);
                } else {
                    btnSaveNewEmail.innerHTML = 'Save Email';
                    btnSaveNewEmail.disabled = false;
                    newEmailMessage.className = 'mt-2 d-block text-danger fw-bold';
                    newEmailMessage.innerText = data.message || 'Failed to update email.';
                }
            } catch (error) {
                console.error(error);
                btnSaveNewEmail.innerHTML = 'Save Email';
                btnSaveNewEmail.disabled = false;
                newEmailMessage.innerText = 'Network error updating email.';
            }
        });
    </script>
</body>
</html>
