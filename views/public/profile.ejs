<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/css/intlTelInput.css">
    <link rel="stylesheet" href="/css/style-new.css">
    <style>
        /* Fix intl-tel-input to match our glassy theme */
        .iti { width: 100%; display: block; }
        .iti__flag-container { z-index: 5; }
        .iti__selected-flag { border-radius: 8px 0 0 8px; }
        .iti__country-list { z-index: 9999 !important; border-radius: 8px !important; border: 1px solid var(--ent-border) !important; background: var(--ent-bg-card) !important; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.2) !important; padding: 8px !important; margin-top: 4px !important; }
        .iti__country { color: var(--ent-text-main) !important; border-radius: 4px !important; padding: 8px 12px !important; }
        .iti__country.iti__highlight { background-color: var(--ent-bg-body) !important; }
        .iti__search-input { width: 100% !important; padding: 8px 12px !important; border: 1px solid var(--ent-border) !important; border-radius: 6px !important; background: var(--ent-bg-body) !important; color: var(--ent-text-main) !important; margin-bottom: 8px !important; outline: none !important; box-shadow: none !important; }
        .iti__search-input:focus { border-color: var(--ent-brand) !important; }
        #phoneInput { padding-left: 105px !important; }
    </style>
    <%- include('../partials/dynamic-styles') %>
