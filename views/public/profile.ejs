        <%- include('../partials/footer-new') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/js/intlTelInput.min.js"></script>
            <script src="/js/main.js"></script>
            
            <!-- Vanilla JS Toast Container -->
            <div id="custom-toast-container" style="position: fixed; bottom: 24px; right: 24px; z-index: 999999; display: flex; flex-direction: column; gap: 12px; pointer-events: none;"></div>

            <script>
                // Foolproof Vanilla JS Toast Logic (No external libraries required)
                function showToast(message, type = 'success') {
                    if (Array.isArray(message)) message = message[0];
                    const container = document.getElementById('custom-toast-container');
                    const toast = document.createElement('div');
                    
                    toast.style.pointerEvents = 'auto';
                    toast.style.minWidth = '280px';
                    toast.style.maxWidth = '400px';
                    toast.style.padding = '16px 20px';
                    toast.style.borderRadius = '8px';
                    toast.style.color = '#fff';
                    toast.style.fontFamily = 'Inter, sans-serif';
                    toast.style.fontSize = '14px';
                    toast.style.fontWeight = '500';
                    toast.style.boxShadow = '0 10px 15px -3px rgba(0,0,0,0.2), 0 4px 6px -2px rgba(0,0,0,0.1)';
                    toast.style.display = 'flex';
                    toast.style.alignItems = 'flex-start';
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(20px)';
                    toast.style.transition = 'all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                    toast.style.cursor = 'pointer';
                    
                    if (type === 'success') {
                        toast.style.background = '#10b981'; // Emerald 500
                        toast.innerHTML = `<i class="bi bi-check-circle-fill" style="margin-right:12px; font-size:1.2rem; line-height: 1;"></i> <div style="flex:1;">${message}</div>`;
                    } else if (type === 'error') {
                        toast.style.background = '#ef4444'; // Red 500
                        toast.innerHTML = `<i class="bi bi-exclamation-triangle-fill" style="margin-right:12px; font-size:1.2rem; line-height: 1;"></i> <div style="flex:1;">${message}</div>`;
                    } else {
                        toast.style.background = '#3b82f6'; // Blue 500
                        toast.innerHTML = `<i class="bi bi-info-circle-fill" style="margin-right:12px; font-size:1.2rem; line-height: 1;"></i> <div style="flex:1;">${message}</div>`;
                    }
                    
                    container.appendChild(toast);
                    
                    // Trigger animation
                    requestAnimationFrame(() => {
                        toast.style.opacity = '1';
                        toast.style.transform = 'translateY(0)';
                    });
                    
                    // Remove on click
                    toast.onclick = () => {
                        toast.style.opacity = '0';
                        toast.style.transform = 'translateY(10px) scale(0.95)';
                        setTimeout(() => toast.remove(), 400);
                    };
                    
                    // Auto remove after 4.5 seconds
                    setTimeout(() => {
                        if(toast.parentElement) {
                            toast.style.opacity = '0';
                            toast.style.transform = 'translateY(10px) scale(0.95)';
                            setTimeout(() => { if(toast.parentElement) toast.remove(); }, 400);
                        }
                    }, 4500);
                }

                // Safely intercept and show flash messages by reading the inline alerts
                document.addEventListener('DOMContentLoaded', () => {
                    const successAlert = document.querySelector('.alert-success');
                    if (successAlert && successAlert.innerText.trim()) {
                        showToast(successAlert.innerText.trim(), 'success');
                        successAlert.style.display = 'none'; // Hide the inline alert
                    }

                    const errorAlert = document.querySelector('.alert-danger');
                    if (errorAlert && errorAlert.innerText.trim()) {
                        showToast(errorAlert.innerText.trim(), 'error');
                        errorAlert.style.display = 'none'; // Hide the inline alert
                    }
                });

                // Tab Switching Logic
                const tabLinks = document.querySelectorAll('.tab-link');
                const tabContents = document.querySelectorAll('.ent-tab-content');
                const pageTitle = document.getElementById('pageTitle');
                const pageDesc = document.getElementById('pageDesc');

                tabLinks.forEach(link => {
                    link.addEventListener('click', (e) => {
                        e.preventDefault();
                        
                        // Remove active class from all links and tabs
                        tabLinks.forEach(l => l.classList.remove('active'));
                        tabContents.forEach(c => c.classList.remove('active'));
                        
                        // Add active class to clicked link and corresponding tab
                        link.classList.add('active');
                        const targetId = link.getAttribute('data-target');
                        document.getElementById(targetId).classList.add('active');

                        // Update Page Header Context
                        if (targetId === 'account-tab') {
                            pageTitle.innerText = 'Account Settings';
                            pageDesc.innerText = 'Manage your profile details, email address, and security preferences.';
                        } else if (targetId === 'tickets-tab') {
                            pageTitle.innerText = 'Support Tickets';
                            pageDesc.innerText = 'View and track the status of your inquiries and requests.';
                        }
                        
                        // Mobile: Hide menu when tab is selected
                        if (window.innerWidth <= 768) {
                            document.querySelector('.ent-layout').classList.remove('mobile-menu-active');
                        }
                    });
                });

                // Mobile Back Button Logic
                document.getElementById('mobileBackBtn').addEventListener('click', () => {
                    document.querySelector('.ent-layout').classList.add('mobile-menu-active');
                });

                // Auto-open tab if present in URL
                const urlParams = new URLSearchParams(window.location.search);
                const tabParam = urlParams.get('tab');
                if (tabParam === 'tickets') {
                    const ticketTabBtn = document.querySelector('[data-target="tickets-tab"]');
                    if (ticketTabBtn) ticketTabBtn.click();
                }

                const emojiRegex = /[\u{1F300}-\u{1F5FF}\u{1F900}-\u{1F9FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}\u{1F191}-\u{1F251}\u{1F004}\u{1F0CF}\u{1F170}-\u{1F171}\u{1F17E}-\u{1F17F}\u{1F18E}\u{3030}\u{2B50}\u{2B55}\u{2934}-\u{2935}\u{2B05}-\u{2B07}\u{2B1B}-\u{2B1C}\u{3297}\u{3299}\u{303D}\u{00A9}\u{00AE}\u{2122}\u{23F3}\u{24C2}\u{23E9}-\u{23EF}\u{25B6}\u{23F8}-\u{23FA}]/u;
                const urlRegex = /(https?:\/\/[^\s]+)|(www\.[^\s]+)/ig;
                const htmlTagRegex = /<\/?\w+((\s+\w+(\s*=\s*(?:".*?"|'.*?'|[^'">\s]+))?)+\s*|\s*)\/?>/gi;

                // Initialize International Phone Input
                const phoneInputField = document.querySelector("#phoneInput");
                const iti = window.intlTelInput(phoneInputField, {
                    initialCountry: "in",
                    separateDialCode: true,
                    dropdownContainer: document.body, // This pulls the dropdown out of the card so it can't be cut off
                    utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/js/utils.js",
                });

                document.getElementById('profileSubmitBtn').addEventListener('click', function (e) {
                    const phoneInputVal = phoneInputField.value;
                    const nameInputElem = document.querySelector('input[name="name"]');
                    const nameInput = nameInputElem.value;
                    
                    if (urlRegex.test(nameInput)) {
                        e.preventDefault();
                        showToast('URLs and links are strictly prohibited.', 'error');
                        return;
                    }

                    if (htmlTagRegex.test(nameInput) || htmlTagRegex.test(phoneInputVal)) {
                        e.preventDefault();
                        showToast('HTML tags, images, and file injections are strictly prohibited.', 'error');
                        return;
                    }
                    
                    if (emojiRegex.test(nameInput) || emojiRegex.test(phoneInputVal)) {
                        e.preventDefault();
                        showToast('Emojis are strictly prohibited.', 'error');
                        return;
                    }

                    // Strict Phone Validation using intl-tel-input (Checks length and format for the selected country)
                    if (!iti.isValidNumber()) {
                        e.preventDefault();
                        showToast('Please enter a valid phone number for the selected country.', 'error');
                        return;
                    }
                    
                    // Replace the input value with the full international number right before submitting
                    phoneInputField.value = iti.getNumber();
                });

                document.getElementById('passwordSubmitBtn').addEventListener('click', function (e) {
                    const currentPassword = document.querySelector('input[name="currentPassword"]').value;
                    const newPassword = document.querySelector('input[name="newPassword"]').value;
                    const confirmPassword = document.querySelector('input[name="confirmPassword"]').value;
                    
                    if (htmlTagRegex.test(currentPassword) || htmlTagRegex.test(newPassword) || htmlTagRegex.test(confirmPassword)) {
                        e.preventDefault();
                        showToast('HTML tags and injections are strictly prohibited.', 'error');
                        return;
                    }

                    if (urlRegex.test(currentPassword) || urlRegex.test(newPassword) || urlRegex.test(confirmPassword)) {
                        e.preventDefault();
                        showToast('URLs and links are strictly prohibited.', 'error');
                        return;
                    }

                    if (emojiRegex.test(currentPassword) || emojiRegex.test(newPassword) || emojiRegex.test(confirmPassword)) {
                        e.preventDefault();
                        showToast('Emojis are strictly prohibited.', 'error');
                        return;
                    }
                });

                // Email Change Logic
                const btnChangeEmail = document.getElementById('btnChangeEmail');
                const emailDisplayContainer = document.getElementById('emailDisplayContainer');
                const emailOtpContainer = document.getElementById('emailOtpContainer');
                const newEmailContainer = document.getElementById('newEmailContainer');
                const emailOtpInput = document.getElementById('emailOtpInput');
                const btnVerifyEmailOtp = document.getElementById('btnVerifyEmailOtp');
                const emailOtpMessage = document.getElementById('emailOtpMessage');
                const newEmailInput = document.getElementById('newEmailInput');
                const btnSaveNewEmail = document.getElementById('btnSaveNewEmail');
                const newEmailMessage = document.getElementById('newEmailMessage');

                btnChangeEmail.addEventListener('click', async () => {
                    btnChangeEmail.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending OTP...';
                    btnChangeEmail.disabled = true;

                    try {
                        const response = await fetch('/profile/email/request-otp', { 
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: { 'x-csrf-token': '<%= csrfToken %>' }
                        });
                        const data = await response.json();

                        if (data.success) {
                            btnChangeEmail.style.display = 'none';
                            emailDisplayContainer.style.display = 'none';
                            emailOtpContainer.style.display = 'block';
                            emailOtpMessage.className = 'mt-2 d-block text-success';
                            emailOtpMessage.innerText = data.message;
                            emailOtpInput.focus(); // Auto-focus the OTP field
                            showToast(data.message, 'info');
                        } else {
                            btnChangeEmail.innerHTML = '<i class="bi bi-pencil me-1"></i> Change Email';
                            btnChangeEmail.disabled = false;
                            showToast(data.message || 'Failed to send OTP.', 'error');
                        }
                    } catch (error) {
                        console.error(error);
                        btnChangeEmail.innerHTML = '<i class="bi bi-pencil me-1"></i> Change Email';
                        btnChangeEmail.disabled = false;
                        showToast('Network error while requesting OTP.', 'error');
                    }
                });

                // Allow pressing Enter key to trigger Verify
                emailOtpInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault(); // Prevent main form submission
                        btnVerifyEmailOtp.click();
                    }
                });

                btnVerifyEmailOtp.addEventListener('click', async () => {
                    const otp = emailOtpInput.value.trim();
                    if (!otp) return showToast('Please enter the OTP', 'error');

                    btnVerifyEmailOtp.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                    btnVerifyEmailOtp.disabled = true;

                    try {
                        const response = await fetch('/profile/email/verify-otp', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: { 
                                'Content-Type': 'application/json',
                                'x-csrf-token': '<%= csrfToken %>' 
                            },
                            body: JSON.stringify({ otp })
                        });
                        const data = await response.json();

                        if (data.success) {
                            emailOtpContainer.style.display = 'none';
                            newEmailContainer.style.display = 'block';
                            newEmailInput.focus(); // Auto-focus new email field
                        } else {
                            btnVerifyEmailOtp.innerHTML = 'Verify';
                            btnVerifyEmailOtp.disabled = false;
                            emailOtpMessage.className = 'mt-2 d-block text-danger fw-bold';
                            emailOtpMessage.innerText = data.message || 'Invalid OTP';
                        }
                    } catch (error) {
                        console.error(error);
                        btnVerifyEmailOtp.innerHTML = 'Verify';
                        btnVerifyEmailOtp.disabled = false;
                        emailOtpMessage.innerText = 'Network error verifying OTP.';
                    }
                });

                // Allow pressing Enter key to trigger Save Email
                newEmailInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault(); // Prevent main form submission
                        btnSaveNewEmail.click();
                    }
                });

                btnSaveNewEmail.addEventListener('click', async () => {
                    const newEmail = newEmailInput.value.trim();
                    if (!newEmail) return showToast('Please enter a new email address', 'error');

                    btnSaveNewEmail.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                    btnSaveNewEmail.disabled = true;

                    try {
                        const response = await fetch('/profile/email/update', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: { 
                                'Content-Type': 'application/json',
                                'x-csrf-token': '<%= csrfToken %>' 
                            },
                            body: JSON.stringify({ newEmail })
                        });
                        const data = await response.json();

                        if (data.success) {
                            newEmailContainer.innerHTML = `<div class="alert alert-success border-0 bg-success bg-opacity-25 text-white mb-0"><i class="bi bi-check-circle-fill me-2"></i> ${data.message}</div>`;
                            document.getElementById('currentEmailInput').value = newEmail;
                            // Optionally, refresh page to reset UI after a few seconds
                            setTimeout(() => window.location.reload(), 2000);
                        } else {
                            btnSaveNewEmail.innerHTML = 'Save Email';
                            btnSaveNewEmail.disabled = false;
                            newEmailMessage.className = 'mt-2 d-block text-danger fw-bold';
                            newEmailMessage.innerText = data.message || 'Failed to update email.';
                        }
                    } catch (error) {
                        console.error(error);
                        btnSaveNewEmail.innerHTML = 'Save Email';
                        btnSaveNewEmail.disabled = false;
                        newEmailMessage.innerText = 'Network error updating email.';
                    }
                });

                // Avatar Upload Logic with Real-time AI NSFW Scanning
                const btnUploadAvatar = document.getElementById('btnUploadAvatar');
                const avatarInput = document.getElementById('avatarInput');
                const avatarScanStatus = document.getElementById('avatarScanStatus');
                const avatarPreviewContainer = document.getElementById('avatarPreviewContainer');

                let nsfwModel = null;

                btnUploadAvatar.addEventListener('click', () => {
                    avatarInput.click();
                });

                avatarInput.addEventListener('change', async (e) => {
                    const file = e.target.files[0];
                    if (!file) return;

                    if (file.size > 20 * 1024 * 1024) {
                        showToast('Image is too large. Max size is 20MB.', 'error');
                        avatarInput.value = '';
                        return;
                    }

                    let skipAI = false;
                    try {
                        avatarScanStatus.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Loading AI Scanner...';
                        if (!nsfwModel) {
                            // Let it hit the default CDN, if it fails, it will be caught.
                            nsfwModel = await nsfwjs.load();
                        }
                    } catch (modelErr) {
                        console.warn("AI model failed to load. Skipping frontend NSFW check.", modelErr);
                        skipAI = true;
                    }

                    if (!skipAI && nsfwModel) {
                        try {
                            avatarScanStatus.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Scanning image for explicit content...';
                            
                            const imgElement = new Image();
                            imgElement.src = URL.createObjectURL(file);
                            await new Promise((resolve, reject) => {
                                imgElement.onload = resolve;
                                imgElement.onerror = reject;
                            });

                            const predictions = await nsfwModel.classify(imgElement);
                            const isVulgar = predictions.some(p => (p.className === 'Porn' || p.className === 'Hentai' || p.className === 'Sexy') && p.probability > 0.6);

                            if (isVulgar) {
                                showToast('Upload rejected: Image violates content policies.', 'error');
                                avatarScanStatus.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-x-circle"></i> Inappropriate content detected.</span>';
                                avatarInput.value = '';
                                return;
                            }
                        } catch (scanErr) {
                            console.warn("AI scan failed, skipping.", scanErr);
                        }
                    }

                    avatarScanStatus.innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> Image is safe. Uploading...</span>';
                    
                    try {
                        const formData = new FormData();
                        formData.append('avatar', file);

                        const response = await fetch('/profile/avatar', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: {
                                'x-csrf-token': '<%= csrfToken %>'
                            },
                            body: formData
                        });

                        const data = await response.json();
                        if (data.success) {
                            avatarPreviewContainer.innerHTML = `<img src="${data.url}" alt="Avatar" style="width:100%; height:100%; object-fit:cover; border-radius:50%;">`;
                            avatarScanStatus.innerHTML = '';
                            showToast(data.message, 'success');
                        } else {
                            throw new Error(data.message);
                        }

                    } catch (error) {
                        console.error('Upload Error:', error);
                        avatarScanStatus.innerHTML = '';
                        showToast(error.message || 'Error uploading image.', 'error');
                        avatarInput.value = '';
                    }
                });
            </script>
            
            <!-- NSFWJS Dependencies -->
            <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.10.0/dist/tf.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/nsfwjs@2.4.2/dist/nsfwjs.min.js"></script>
</body>

</html>