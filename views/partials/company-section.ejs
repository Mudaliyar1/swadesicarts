<%
  const visibleCompanies = Array.isArray(companies)
    ? companies.filter(company => company && company.isVisible !== false)
    : [];
%>
<% if (visibleCompanies.length > 0) { %>
<style>
    .company-section .company-card {
        width: 100%;
        border: 0;
        background: linear-gradient(135deg, #f7f8fa 0%, #e6e9ee 100%);
        border-radius: 16px;
        padding: 1rem 0.9rem;
        box-shadow: 0 8px 22px rgba(30, 41, 59, 0.08);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        text-align: center;
        color: var(--dark);
        border: 1px solid rgba(148, 163, 184, 0.25);
    }

    .company-section .company-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px rgba(30, 41, 59, 0.14);
    }

    .company-section .company-logo-wrap {
        width: 84px;
        height: 84px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 0.75rem;
        overflow: hidden;
        border-radius: 999px;
        background: linear-gradient(135deg, #ffffff 0%, #edf1f5 100%);
        border: 1px solid rgba(148, 163, 184, 0.18);
        box-shadow: 0 6px 14px rgba(30, 41, 59, 0.08);
    }

    .company-section .company-logo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 999px;
        transition: transform 0.25s ease;
    }

    .company-section .company-card:hover .company-logo {
        transform: scale(1.05);
    }

    .company-section .company-name {
        font-weight: 700;
        font-size: 0.92rem;
        color: var(--dark);
        margin-bottom: 0;
    }

    .company-section .company-card:hover .company-name {
        color: var(--primary);
    }

    .company-modal .modal-content {
        border: 0;
        border-radius: 22px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18);
        overflow: hidden;
        background: var(--site-background, linear-gradient(135deg, #2f80ed 0%, #56ccf2 100%));
        background-size: cover;
    }

    .company-modal .modal-header {
        border-bottom: 0;
        padding: 1.5rem 1.5rem 0;
        background: transparent;
        position: relative;
        justify-content: center;
    }

    .company-modal .modal-body {
        padding-top: 0.75rem;
        background: transparent;
    }

    .company-modal-logo {
        width: 170px;
        height: 170px;
        object-fit: cover;
        border-radius: 999px;
        border: 2px solid rgba(255, 255, 255, 0.7);
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
        background: #fff;
        padding: 8px;
    }

    .company-modal-title {
        text-align: center;
        width: 100%;
        font-weight: 800;
        margin-bottom: 0;
        color: #ffffff;
    }

    .company-modal-copy {
        padding-left: 0.5rem;
        color: #ffffff;
    }

    .company-modal-copy p {
        color: rgba(255, 255, 255, 0.92);
    }

    @media (max-width: 767.98px) {
        .company-modal-logo {
            width: 140px;
            height: 140px;
        }

        .company-modal-copy {
            padding-left: 0;
            margin-top: 1rem;
        }
    }
</style>

<section class="company-section py-5">
    <div class="container">
        <div class="section-header slide-up">
            <h2>Companies We Worked With</h2>
            <p>Trusted collaborations that strengthen our delivery and credibility</p>
        </div>

        <div class="row g-3 g-md-4 justify-content-center">
            <% visibleCompanies.forEach(company => { %>
                <div class="col-6 col-md-4 col-lg-3 scroll-animate">
                    <button
                        type="button"
                        class="company-card"
                        data-bs-toggle="modal"
                        data-bs-target="#companyModal"
                        data-company-name="<%= company.name %>"
                        data-company-logo="<%= company.logo && company.logo.url ? company.logo.url : '' %>"
                        data-company-short-description="<%= company.shortDescription || '' %>"
                        data-company-full-description="<%= company.fullDescription || '' %>"
                        data-company-website-url="<%= company.websiteUrl || '' %>"
                        data-company-featured="<%= company.isFeatured ? 'yes' : 'no' %>"
                        aria-label="Open details for <%= company.name %>">
                        <div class="company-logo-wrap">
                            <% if (company.logo && company.logo.url) { %>
                                <img src="<%= company.logo.url %>" alt="<%= company.name %> logo" class="company-logo">
                            <% } else { %>
                                <div class="d-flex align-items-center justify-content-center w-100 h-100 rounded-4 bg-light">
                                    <i class="bi bi-building text-muted" style="font-size: 2.5rem;"></i>
                                </div>
                            <% } %>
                        </div>
                        <h6 class="company-name"><%= company.name %></h6>
                    </button>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<div class="modal fade company-modal" id="companyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header px-4 pt-4">
                <h5 class="modal-title fw-bold company-modal-title" id="companyModalTitle">Company Details</h5>
                <button type="button" class="btn-close btn-close-white position-absolute end-0 top-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pb-4">
                <p class="text-muted mb-2 small d-none" id="companyModalFeaturedPill">
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Featured Partner</span>
                </p>
                <div class="row align-items-start g-3 g-md-4">
                    <div class="col-md-4 text-center">
                        <img id="companyModalLogo" src="" alt="Company logo" class="company-modal-logo img-fluid d-none">
                    </div>
                    <div class="col-md-8 company-modal-copy">
                        <p class="mb-3" id="companyModalDescription"></p>
                        <div class="d-flex flex-wrap gap-2 justify-content-md-end justify-content-start">
                            <a id="companyModalWebsiteBtn" href="#" target="_blank" rel="noopener" class="btn btn-swadesi d-none">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Visit Website
                            </a>
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('show.bs.modal', function (event) {
    if (!event.target || event.target.id !== 'companyModal') return;

    const trigger = event.relatedTarget;
    if (!trigger) return;

    const name = trigger.getAttribute('data-company-name') || 'Company';
    const logo = trigger.getAttribute('data-company-logo') || '';
    const shortDescription = trigger.getAttribute('data-company-short-description') || '';
    const fullDescription = trigger.getAttribute('data-company-full-description') || '';
    const websiteUrl = trigger.getAttribute('data-company-website-url') || '';
    const featured = trigger.getAttribute('data-company-featured') === 'yes';

    const titleEl = document.getElementById('companyModalTitle');
    const logoEl = document.getElementById('companyModalLogo');
    const descriptionEl = document.getElementById('companyModalDescription');
    const websiteBtn = document.getElementById('companyModalWebsiteBtn');
    const featuredPill = document.getElementById('companyModalFeaturedPill');

    if (titleEl) titleEl.textContent = name;

    if (logoEl) {
        if (logo) {
            logoEl.src = logo;
            logoEl.alt = `${name} logo`;
            logoEl.classList.remove('d-none');
        } else {
            logoEl.classList.add('d-none');
        }
    }

    if (descriptionEl) {
        descriptionEl.textContent = fullDescription || shortDescription || 'No description available.';
    }

    if (websiteBtn) {
        if (websiteUrl) {
            websiteBtn.href = websiteUrl;
            websiteBtn.classList.remove('d-none');
        } else {
            websiteBtn.classList.add('d-none');
        }
    }

    if (featuredPill) {
        featuredPill.classList.toggle('d-none', !featured);
    }
});
</script>
<% } %>