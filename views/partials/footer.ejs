<footer class="footer bg-dark text-white mt-5">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-4 mb-4">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-cart3"></i> Swadesi Carts
                </h5>
                <p class="text-white-50">Your trusted partner for seasonal products, tech services, and organic products. Quality and authenticity guaranteed.</p>
            </div>
            <div class="col-lg-2 col-md-6 mb-4">
                <h6 class="fw-bold mb-3">Quick Links</h6>
                <ul class="list-unstyled">
                    <li class="mb-2"><a href="/" class="text-white-50 text-decoration-none hover-accent">Home</a></li>
                    <li class="mb-2"><a href="/about" class="text-white-50 text-decoration-none hover-accent">About Us</a></li>
                    <li class="mb-2"><a href="/contact" class="text-white-50 text-decoration-none hover-accent">Contact</a></li>
                </ul>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <h6 class="fw-bold mb-3">Our Products</h6>
                <ul class="list-unstyled">
                    <li class="mb-2"><a href="/seasonal-products" class="text-white-50 text-decoration-none hover-accent">Seasonal Products</a></li>
                    <li class="mb-2"><a href="/tech-packages" class="text-white-50 text-decoration-none hover-accent">Tech Services</a></li>
                    <li class="mb-2"><a href="/organic-products" class="text-white-50 text-decoration-none hover-accent">Organic Products</a></li>
                </ul>
            </div>
            <div class="col-lg-3 col-md-12 mb-4">
                <h6 class="fw-bold mb-3">Contact Info</h6>
                <ul class="list-unstyled text-white-50">
                    <li class="mb-2"><i class="bi bi-envelope"></i> info@swadesicarts.com</li>
                    <li class="mb-2"><i class="bi bi-phone"></i> +91 1234567890</li>
                </ul>
            </div>
        </div>
        <hr class="border-secondary">
        <div class="text-center text-white-50">
            <p class="mb-2">&copy; <%= new Date().getFullYear() %> Swadesi Carts. All rights reserved.</p>
            <div class="d-flex justify-content-center flex-wrap gap-3 mt-2" style="font-size: 0.85rem;">
                <% if (typeof activePolicies !== 'undefined' && activePolicies && activePolicies.length > 0) { %>
                    <% activePolicies.forEach(policy => { %>
                        <a href="/<%= policy.slug %>" class="text-white-50 text-decoration-none hover-accent"><%= policy.title %></a>
                    <% }); %>
                <% } else { %>
                    <a href="/privacy-policy" class="text-white-50 text-decoration-none hover-accent">Privacy Policy</a>
                    <a href="/terms-and-conditions" class="text-white-50 text-decoration-none hover-accent">Terms & Conditions</a>
                    <a href="/cookie-policy" class="text-white-50 text-decoration-none hover-accent">Cookie Policy</a>
                    <a href="/disclaimer" class="text-white-50 text-decoration-none hover-accent">Disclaimer</a>
                    <a href="/refund-policy" class="text-white-50 text-decoration-none hover-accent">Refund Policy</a>
                    <a href="/cancellation-policy" class="text-white-50 text-decoration-none hover-accent">Cancellation Policy</a>
                    <a href="/shipping-policy" class="text-white-50 text-decoration-none hover-accent">Shipping Policy</a>
                    <a href="/dmca-policy" class="text-white-50 text-decoration-none hover-accent">DMCA Policy</a>
                <% } %>
            </div>
        </div>
    </div>
</footer>
