<footer>
    <div class="container">
        <div class="row g-4">
            <!-- BRAND COLUMN -->
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="footer-brand-wrapper mb-3">
                    <% if (siteSettings && siteSettings.logo && siteSettings.logo.url) { %>
                        <img src="<%= siteSettings.logo.url %>" alt="Swadesi Carts" class="footer-logo mb-2" style="max-height: 45px; object-fit: contain;">
                    <% } else { %>
                        <span class="footer-brand-text">Swadesi<span>Carts</span></span>
                    <% } %>
                </div>
                <p class="footer-tagline">
                    Sourcing the purity and trust of Bharat's finest organic and seasonal products, built for the world.
                </p>
                <% if (siteSettings && siteSettings.socialMedia) { %>
                    <div class="social-links mt-3">
                        <% if (siteSettings.socialMedia.facebook) { %>
                            <a href="<%= siteSettings.socialMedia.facebook %>" target="_blank" aria-label="Facebook">
                                <i class="bi bi-facebook"></i>
                            </a>
                        <% } %>
                        <% if (siteSettings.socialMedia.twitter) { %>
                            <a href="<%= siteSettings.socialMedia.twitter %>" target="_blank" aria-label="Twitter">
                                <i class="bi bi-twitter"></i>
                            </a>
                        <% } %>
                        <% if (siteSettings.socialMedia.instagram) { %>
                            <a href="<%= siteSettings.socialMedia.instagram %>" target="_blank" aria-label="Instagram">
                                <i class="bi bi-instagram"></i>
                            </a>
                        <% } %>
                        <% if (siteSettings.socialMedia.linkedin) { %>
                            <a href="<%= siteSettings.socialMedia.linkedin %>" target="_blank" aria-label="LinkedIn">
                                <i class="bi bi-linkedin"></i>
                            </a>
                        <% } %>
                        <% if (siteSettings.socialMedia.youtube) { %>
                            <a href="<%= siteSettings.socialMedia.youtube %>" target="_blank" aria-label="YouTube">
                                <i class="bi bi-youtube"></i>
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- QUICK LINKS -->
            <div class="col-lg-3 col-md-6 mb-4">
                <h5>Quick Links</h5>
                <ul class="footer-links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/contact">Contact</a></li>
                    <li><a href="/seasonal-products">Seasonal</a></li>
                </ul>
            </div>

            <!-- OUR PRODUCTS -->
            <div class="col-lg-3 col-md-6 mb-4">
                <h5>Our Products</h5>
                <ul class="footer-links">
                    <li><a href="/seasonal-products">Seasonal Products</a></li>
                    <li><a href="/tech-packages">Tech Services</a></li>
                    <li><a href="/organic-products">Organic Products</a></li>
                </ul>
            </div>

            <!-- CONTACT INFO -->
            <div class="col-lg-3 col-md-6 mb-4">
                <h5>Contact Info</h5>
                <ul class="footer-contact-info">
                    <li>
                        <i class="bi bi-envelope"></i>
                        <a href="mailto:<%= siteSettings && siteSettings.footer ? siteSettings.footer.email : 'info@swadesicarts.com' %>">
                            <%= siteSettings && siteSettings.footer ? siteSettings.footer.email : 'info@swadesicarts.com' %>
                        </a>
                    </li>
                    <li>
                        <i class="bi bi-telephone"></i>
                        <a href="tel:<%= siteSettings && siteSettings.footer ? siteSettings.footer.phone : '+91-000-0000000' %>">
                            <%= siteSettings && siteSettings.footer ? siteSettings.footer.phone : '+91-000-0000000' %>
                        </a>
                    </li>
                    <li>
                        <i class="bi bi-geo-alt"></i>
                        <span><%= siteSettings && siteSettings.footer ? siteSettings.footer.address : 'India' %></span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2026 Swadesi Carts. All rights reserved. | Quality and authenticity guaranteed.</p>
        </div>
    </div>
</footer>
