<!-- ==========================================
     MODERN 2026 ADMIN SIDEBAR (UNIFIED)
     ========================================== -->
<style>
    :root {
        --admin-bg: #f8fafc;
        --admin-sidebar-bg: #1e1e2f;
        --admin-sidebar-hover: rgba(255, 255, 255, 0.08);
        --admin-sidebar-active: linear-gradient(135deg, var(--primary, #4C1E4F) 0%, var(--primary-light, #6B2E6F) 100%);
        --admin-text: #94a3b8;
        --admin-text-active: #ffffff;
    }

    /* DESKTOP SIDEBAR */
    .admin-sidebar-2026 {
        background-color: var(--admin-sidebar-bg) !important;
        background-image: 
            radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.02), transparent 40%),
            radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.02), transparent 40%);
        box-shadow: 4px 0 24px rgba(0,0,0,0.1);
        border-right: 1px solid rgba(255,255,255,0.05);
        color: var(--admin-text);
        width: 280px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1040;
    }

    .admin-sidebar-2026 .sidebar-header {
        padding: 1.8rem 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-sidebar-2026 .sidebar-header h5 {
        color: #fff;
        font-weight: 800;
        letter-spacing: 0.5px;
        margin: 0;
        font-size: 1.25rem;
        background: linear-gradient(135deg, #fff, var(--accent, #FFD700));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .admin-sidebar-2026 .sidebar-nav {
        padding: 1.5rem 1rem;
        list-style: none;
        margin: 0;
        overflow-y: auto;
        flex-grow: 1;
    }

    .admin-sidebar-2026 .sidebar-nav::-webkit-scrollbar {
        width: 4px;
    }
    .admin-sidebar-2026 .sidebar-nav::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
    }

    .admin-sidebar-2026 .sidebar-nav li {
        margin-bottom: 0.4rem;
    }

    .admin-sidebar-2026 .sidebar-nav a {
        display: flex;
        align-items: center;
        padding: 0.8rem 1.2rem;
        color: var(--admin-text);
        text-decoration: none;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .admin-sidebar-2026 .sidebar-nav a i {
        margin-right: 14px;
        font-size: 1.2rem;
        transition: all 0.3s ease;
        opacity: 0.8;
    }

    .admin-sidebar-2026 .sidebar-nav a:hover {
        background: var(--admin-sidebar-hover);
        color: #fff;
        transform: translateX(4px);
    }
    
    .admin-sidebar-2026 .sidebar-nav a:hover i {
        opacity: 1;
        color: var(--accent, #FFD700);
    }

    .admin-sidebar-2026 .sidebar-nav a.active {
        background: var(--admin-sidebar-active);
        color: var(--admin-text-active);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        font-weight: 600;
    }

    .admin-sidebar-2026 .sidebar-nav a.active i {
        opacity: 1;
        color: #fff;
    }

    .admin-sidebar-2026 .sidebar-footer {
        padding: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(0,0,0,0.1);
    }

    .admin-sidebar-2026 .sidebar-footer a {
        display: flex;
        align-items: center;
        padding: 0.8rem 1rem;
        color: var(--admin-text);
        text-decoration: none;
        border-radius: 12px;
        transition: all 0.3s ease;
        font-weight: 500;
    }

    .admin-sidebar-2026 .sidebar-footer a:hover {
        background: rgba(255,255,255,0.05);
        color: #fff;
    }

    .admin-sidebar-2026 .sidebar-footer a i {
        margin-right: 12px;
        font-size: 1.1rem;
    }

    /* MOBILE HEADER */
    .admin-mobile-header {
        background: var(--admin-sidebar-bg) !important;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .admin-mobile-header .navbar-brand {
        font-weight: 800;
        background: linear-gradient(135deg, #fff, var(--accent, #FFD700));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* MOBILE OFFCANVAS */
    .admin-offcanvas-2026 {
        background-color: var(--admin-sidebar-bg) !important;
        border-right: 1px solid rgba(255,255,255,0.05);
    }
    
    .admin-offcanvas-2026 .offcanvas-header {
        border-bottom: 1px solid rgba(255,255,255,0.05);
        padding: 1.5rem;
    }

    .admin-offcanvas-2026 .offcanvas-title {
        font-weight: 800;
        background: linear-gradient(135deg, #fff, var(--accent, #FFD700));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>

