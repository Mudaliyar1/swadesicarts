<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    <nav class="navbar navbar-dark bg-swadesi d-lg-none">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <span class="navbar-brand mb-0">Edit Product</span>
            <a href="/admin/logout" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right"></i></a>
        </div>
    </nav>

    <div class="admin-sidebar d-none d-lg-flex flex-column" id="sidebarDesktop">
        <div class="sidebar-header">
            <h5 class="mb-0"><i class="bi bi-speedometer2"></i> <span class="sidebar-text">Admin Panel</span></h5>
        </div>
        <ul class="sidebar-nav flex-grow-1">
            <li><a href="/admin/dashboard" title="Dashboard"><i class="bi bi-speedometer2"></i><span class="sidebar-text">Dashboard</span></a></li>
            <li><a href="/admin/seasonal-products" title="Seasonal Products"><i class="bi bi-calendar3"></i><span class="sidebar-text">Seasonal Products</span></a></li>
            <li><a href="/admin/tech-packages" class="active" title="Tech Packages"><i class="bi bi-laptop"></i><span class="sidebar-text">Tech Packages</span></a></li>
            <li><a href="/admin/organic-products" title="Organic Products"><i class="bi bi-flower2"></i><span class="sidebar-text">Organic Products</span></a></li>
            <li><a href="/admin/stories" title="Stories"><i class="bi bi-images"></i><span class="sidebar-text">Stories</span></a></li>
            <li><a href="/admin/companies"><i class="bi bi-building"></i><span class="sidebar-text">Companies</span></a></li>
            <li><a href="/admin/inquiries" title="Inquiries"><i class="bi bi-chat-dots"></i><span class="sidebar-text">Inquiries</span></a></li>
            <li><a href="/admin/visitors" title="Visitors"><i class="bi bi-person-lines-fill"></i><span class="sidebar-text">Visitors</span></a></li>
            <li><a href="/admin/admins" title="Admin Users"><i class="bi bi-people"></i><span class="sidebar-text">Admin Users</span></a></li>
            <li><a href="/admin/settings" title="Website Settings"><i class="bi bi-gear"></i><span class="sidebar-text">Website Settings</span></a></li>
        </ul>
        <div class="sidebar-footer">
            <a href="/" target="_blank" title="View Website"><i class="bi bi-globe"></i><span class="sidebar-text">View Website</span></a>
            <a href="/admin/logout" title="Logout"><i class="bi bi-box-arrow-right"></i><span class="sidebar-text">Logout</span></a>
        </div>
        <button class="sidebar-toggle d-none d-lg-block" id="sidebarToggle"><i class="bi bi-chevron-left"></i></button>
    </div>

    <div class="offcanvas offcanvas-start bg-swadesi text-white" tabindex="-1" id="sidebar">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">Admin Panel</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <ul class="sidebar-nav-mobile">
                <li><a href="/admin/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                <li><a href="/admin/seasonal-products"><i class="bi bi-calendar3"></i> Seasonal Products</a></li>
                <li><a href="/admin/tech-packages"><i class="bi bi-laptop"></i> Tech Packages</a></li>
                <li><a href="/admin/organic-products"><i class="bi bi-flower2"></i> Organic Products</a></li>
                <li><a href="/admin/stories"><i class="bi bi-images"></i> Stories</a></li>
                <li><a href="/admin/companies"><i class="bi bi-building"></i> Companies</a></li>
                <li><a href="/admin/media"><i class="bi bi-images"></i> Media Management</a></li>
                <li><a href="/admin/inquiries"><i class="bi bi-chat-dots"></i> Inquiries</a></li>
                <li><a href="/admin/visitors"><i class="bi bi-person-lines-fill"></i> Visitors</a></li>
                <li><a href="/admin/admins"><i class="bi bi-people"></i> Admin Users</a></li>
                <li><a href="/admin/settings"><i class="bi bi-gear"></i> Website Settings</a></li>
                <li><a href="/" target="_blank"><i class="bi bi-globe"></i> View Website</a></li>
                <li><a href="/admin/logout"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
            </ul>
        </div>
    </div>

    <div class="admin-content">
        <div class="container-fluid p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">Edit Tech Package</h2>
                <a href="/admin/tech-packages" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form action="/admin/tech-packages/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Title *</label>
                                <input type="text" class="form-control" name="title" value="<%= product.title %>" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Category *</label>
                                <input type="text" class="form-control" name="category" value="<%= product.category %>" required>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="form-label">Short Description *</label>
                                <textarea class="form-control" name="shortDescription" rows="2" maxlength="200" required><%= product.shortDescription %></textarea>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="form-label">Full Description *</label>
                                <textarea class="form-control" name="fullDescription" rows="6" required><%= product.fullDescription %></textarea>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="form-label">Features</label>
                                <div id="features-container">
                                    <% if (product.features && product.features.length > 0) { %>
                                        <% product.features.forEach(feature => { %>
                                        <div class="input-group mb-2">
                                            <input type="text" class="form-control" name="features[]" value="<%= feature %>">
                                            <button type="button" class="btn btn-danger" onclick="removeFeature(this)"><i class="bi bi-trash"></i></button>
                                        </div>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="input-group mb-2">
                                            <input type="text" class="form-control" name="features[]" placeholder="e.g., Free Domain & Hosting">
                                            <button type="button" class="btn btn-danger" onclick="removeFeature(this)"><i class="bi bi-trash"></i></button>
                                        </div>
                                    <% } %>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addFeature()"><i class="bi bi-plus-circle"></i> Add Feature</button>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Price (₹)</label>
                                <input type="number" class="form-control" name="priceAmount" value="<%= product.price && product.price.amount ? product.price.amount : '' %>">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Featured Image</label>
                                <% if (product.featuredImage && product.featuredImage.url) { %>
                                    <img src="<%= product.featuredImage.url %>" class="img-fluid mb-2 rounded" style="max-height: 200px;">
                                <% } %>
                                <input type="file" class="form-control" id="featuredImage" name="featuredImage" accept="image/*" onchange="previewFeaturedImage(event)">
                                <small class="text-muted">Leave empty to keep current image</small>
                                <div id="featuredPreview"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Add More Gallery Images/Videos</label>
                                <input type="file" class="form-control" id="gallery" name="gallery" accept="image/*,video/*" multiple onchange="previewGalleryFiles(event)">
                                <small class="text-muted d-block mt-2">Add more images and videos to existing gallery. All will be visible on the product detail page.</small>
                                <div id="galleryPreview" class="media-preview-container" style="display: none;">
                                    <p class="text-muted mb-2"><strong>New files to upload:</strong></p>
                                    <div id="previewGrid" class="media-preview-grid"></div>
                                </div>
                            </div>
                            <% if (product.gallery && product.gallery.length > 0) { %>
                            <div class="col-12 mb-3">
                                <label class="form-label">Current Gallery</label>
                                <div class="gallery-grid">
                                    <% product.gallery.forEach(media => { %>
                                    <div class="gallery-item">
                                        <% if (media.type === 'video') { %>
                                            <video src="<%= media.url %>" controls></video>
                                        <% } else { %>
                                            <img src="<%= media.url %>">
                                        <% } %>
                                        <button type="button" class="delete-btn" onclick="deleteGalleryItem('<%= product._id %>', '<%= media._id %>', 'tech-packages')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                    <% }); %>
                                </div>
                            </div>
                            <% } %>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Order</label>
                                <input type="number" class="form-control" name="order" value="<%= product.order %>">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Availability</label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="isAvailable" <%= product.isAvailable ? 'checked' : '' %>>
                                    <label class="form-check-label">Available for purchase</label>
                                </div>
                            </div>
                            <!-- SEO & GEO Section -->
                            <div class="col-12 mb-3 mt-2" id="seo-section">
                                <div style="background: linear-gradient(135deg, #f0f9ff 0%, #e8f5e9 100%); border: 1px solid #b3d9ff; border-radius: 10px; padding: 1.25rem;">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                        <h6 style="color: #1565c0; margin-bottom: 0; font-weight: 700;"><i class="bi bi-search me-2"></i>SEO & GEO Keyword Optimization</h6>
                                        <button type="button" class="btn btn-sm btn-outline-primary" id="seoAutoFillBtn" onclick="seoAutoFill()">
                                            <i class="bi bi-magic me-1"></i> Auto-Generate SEO & GEO
                                        </button>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-12 mb-2">
                                            <label class="form-label fw-semibold">URL Slug</label>
                                            <input type="text" class="form-control" name="slug" value="<%= product.slug || '' %>">
                                            <small class="text-muted">Lowercase letters, numbers, and hyphens only.</small>
                                        </div>
                                        <div class="col-12 mb-2">
                                            <label class="form-label fw-semibold">SEO Title <span class="text-muted fw-normal">(max 60 chars)</span></label>
                                            <input type="text" class="form-control" name="seoTitle" maxlength="70" value="<%= product.seoTitle || '' %>" placeholder="Keyword-rich title for search engines">
                                        </div>
                                        <div class="col-12 mb-2">
                                            <label class="form-label fw-semibold">SEO Meta Description <span class="text-muted fw-normal">(max 160 chars)</span></label>
                                            <textarea class="form-control" name="seoMetaDescription" rows="2" maxlength="160" placeholder="Compelling description for search result snippets"><%= product.seoMetaDescription || '' %></textarea>
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label fw-semibold">SEO Keywords</label>
                                            <input type="text" class="form-control" name="seoKeywords" value="<%= product.seoKeywords || '' %>" placeholder="web development, website design, affordable tech services">
                                            <small class="text-muted">Comma-separated.</small>
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label fw-semibold">GEO / Local Keywords</label>
                                            <input type="text" class="form-control" name="geoKeywords" value="<%= product.geoKeywords || '' %>" placeholder="web development Hyderabad, IT services India">
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label fw-semibold">Long-tail Keywords</label>
                                            <input type="text" class="form-control" name="longTailKeywords" value="<%= product.longTailKeywords || '' %>" placeholder="cheap website development for small business India">
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label fw-semibold">AI Search Phrases</label>
                                            <input type="text" class="form-control" name="aiSearchPhrases" value="<%= product.aiSearchPhrases || '' %>" placeholder="best affordable web development company India">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- GEO & AI Discoverability Section -->
                            <div class="col-12 mb-3 mt-2" id="geo-section">
                                <div style="background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%); border: 1px solid #c5e1a5; border-radius: 10px; padding: 1.25rem;">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                        <h6 style="color: #2e7d32; margin-bottom: 0; font-weight: 700;"><i class="bi bi-robot me-2"></i>GEO & Generative AI Discoverability (llms.txt)</h6>
                                        <button type="button" class="btn btn-sm btn-outline-success" id="geoAutoFillBtn" onclick="geoAutoFill()">
                                            <i class="bi bi-magic me-1"></i> Auto-Generate GEO / AI Fields
                                        </button>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-12 mb-2">
                                            <label class="form-label fw-semibold">GEO Summary <span class="text-muted fw-normal">(geographic sourcing/availability for LLMs)</span></label>
                                            <textarea class="form-control" name="geoSummary" rows="2" placeholder="Summary of location, availability, and target audience"><%= product.geoSummary || '' %></textarea>
                                        </div>
                                        <div class="col-12 mb-2">
                                            <label class="form-label fw-semibold">AI Description <span class="text-muted fw-normal">(optimized overview for LLM retrieval)</span></label>
                                            <textarea class="form-control" name="aiDescription" rows="3" placeholder="Descriptive overview structured for LLM retrieval and search indexing"><%= product.aiDescription || '' %></textarea>
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label fw-semibold">AI Keywords <span class="text-muted fw-normal">(comma-separated query terms)</span></label>
                                            <input type="text" class="form-control" name="aiKeywords" value="<%= product.aiKeywords || '' %>" placeholder="swadesi carts, custom software, business IT package">
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label fw-semibold">AI Category Description</label>
                                            <input type="text" class="form-control" name="aiCategoryDescription" value="<%= product.aiCategoryDescription || '' %>" placeholder="e.g. IT services, software development packages and consulting">
                                        </div>
                                        <div class="col-12 mb-2">
                                            <label class="form-label fw-semibold">Entity Description <span class="text-muted fw-normal">(machine-readable structured entity mapping)</span></label>
                                            <textarea class="form-control" name="entityDescription" rows="4" placeholder="Entity extraction representation (Entity, Type, Provider, etc.)"><%= product.entityDescription || '' %></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-swadesi"><i class="bi bi-check-circle"></i> Update Package</button>
                                <a href="/admin/tech-packages" class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/seo-autofill.js"></script>
    <script src="/js/geo-autofill.js"></script>
    <script src="/js/admin.js"></script>
    <script>
        function addFeature() {
            const container = document.getElementById('features-container');
            const div = document.createElement('div');
            div.className = 'input-group mb-2';
            div.innerHTML = `
                <input type="text" class="form-control" name="features[]" placeholder="Enter feature">
                <button type="button" class="btn btn-danger" onclick="removeFeature(this)"><i class="bi bi-trash"></i></button>
            `;
            container.appendChild(div);
        }
        
        function removeFeature(btn) {
            btn.parentElement.remove();
        }

        function previewFeaturedImage(event) {
            const input = event.target;
            const preview = document.getElementById('featuredPreview');
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    preview.innerHTML = `
                        <div class="mt-2">
                            <img src="${e.target.result}" class="img-fluid rounded" style="max-height: 200px;">
                        </div>
                    `;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewGalleryFiles(event) {
            const input = event.target;
            const preview = document.getElementById('galleryPreview');
            const grid = document.getElementById('previewGrid');
            
            grid.innerHTML = '';
            
            if (input.files && input.files.length > 0) {
                preview.style.display = 'block';
                
                Array.from(input.files).forEach((file, index) => {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const isVideo = file.type.startsWith('video/');
                        const item = document.createElement('div');
                        item.className = 'media-preview-item';
                        
                        if (isVideo) {
                            item.innerHTML = `
                                <video src="${e.target.result}"></video>
                                <span class="video-badge"><i class="bi bi-play-circle"></i> VIDEO</span>
                            `;
                        } else {
                            item.innerHTML = `
                                <img src="${e.target.result}" alt="Gallery preview">
                            `;
                        }
                        
                        grid.appendChild(item);
                    };
                    reader.readAsDataURL(file);
                });
            } else {
                preview.style.display = 'none';
            }
        }
    </script>
</body>
</html>
