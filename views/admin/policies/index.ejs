<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    
    <%- include('../../partials/admin-sidebar') %>

    <div class="admin-content">
        <div class="container-fluid p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold mb-1"><i class="bi bi-shield-check"></i> Legal & Policy Management</h2>
                    <p class="text-muted mb-0">Manage trust pages, privacy guidelines, terms, and legal agreements</p>
                </div>
                <a href="/admin/policies/create" class="btn btn-primary" style="border-radius: 10px; padding: 10px 20px; font-weight: 500;">
                    <i class="bi bi-plus-circle-fill me-2"></i> Create Policy Page
                </a>
            </div>

            <% if (success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
                <div class="card-body p-0">
                    <% if (!policies || policies.length === 0) { %>
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-file-earmark-lock-fill" style="font-size: 3.5rem; opacity: 0.3;"></i>
                            <p class="mt-3 mb-0 fw-medium">No policy pages found in database.</p>
                            <p class="text-muted small">Create a new policy page to start.</p>
                        </div>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table align-middle table-hover mb-0" style="font-size: 0.95rem;">
                                <thead class="table-light text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    <tr>
                                        <th class="px-4 py-3">Title</th>
                                        <th class="py-3">Slug</th>
                                        <th class="py-3">Status</th>
                                        <th class="py-3">SEO Health</th>
                                        <th class="py-3">GEO Config</th>
                                        <th class="py-3">Last Updated</th>
                                        <th class="px-4 py-3 text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% policies.forEach(policy => { %>
                                        <tr>
                                            <td class="px-4">
                                                <div class="fw-semibold text-dark"><%= policy.title %></div>
                                            </td>
                                            <td>
                                                <code>/<%= policy.slug %></code>
                                            </td>
                                            <td>
                                                <span class="badge status-badge <%= policy.status === 'published' ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-warning-subtle text-warning border border-warning-subtle' %> px-2.5 py-1.5" id="badge-<%= policy._id %>" style="border-radius: 6px; font-size: 0.8rem; font-weight: 600;">
                                                    <%= policy.status === 'published' ? 'Published' : 'Draft' %>
                                                </span>
                                            </td>
                                            <td>
                                                <% if (policy.seoTitle && policy.seoDescription) { %>
                                                    <span class="text-success" title="SEO tags configured"><i class="bi bi-shield-fill-check fs-5"></i></span>
                                                <% } else { %>
                                                    <span class="text-warning" title="Missing description or keywords"><i class="bi bi-shield-fill-exclamation fs-5"></i></span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (policy.geoSummary) { %>
                                                    <span class="text-info" title="GEO optimization completed"><i class="bi bi-globe-central-south-asia fs-5"></i></span>
                                                <% } else { %>
                                                    <span class="text-secondary opacity-50" title="GEO summary missing"><i class="bi bi-globe-americas fs-5"></i></span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="small text-muted"><%= new Date(policy.updatedAt).toLocaleDateString(undefined, { dateStyle: 'medium' }) %></div>
                                                <div class="x-small text-muted" style="font-size: 0.75rem;"><%= new Date(policy.updatedAt).toLocaleTimeString([], { timeStyle: 'short' }) %></div>
                                            </td>
                                            <td class="px-4 text-end">
                                                <div class="btn-group gap-1">
                                                    <% if (policy.status === 'published') { %>
                                                        <a href="/<%= policy.slug %>" target="_blank" class="btn btn-sm btn-outline-secondary" title="Preview Public Page" style="border-radius: 6px;">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                    <% } else { %>
                                                        <button class="btn btn-sm btn-outline-secondary" disabled title="Publish first to preview" style="border-radius: 6px;">
                                                            <i class="bi bi-eye-slash"></i>
                                                        </button>
                                                    <% } %>
                                                    <a href="/admin/policies/edit/<%= policy._id %>" class="btn btn-sm btn-outline-primary" title="Edit Content & Metadata" style="border-radius: 6px;">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-warning toggle-status-btn" data-id="<%= policy._id %>" title="Toggle Publish/Draft" style="border-radius: 6px;">
                                                        <i class="bi bi-arrow-left-right"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger delete-policy-btn" data-id="<%= policy._id %>" data-title="<%= policy.title %>" title="Delete Policy" style="border-radius: 6px;">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Policy</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="mb-0">Are you sure you want to permanently delete the policy page <strong id="deletePolicyTitle"></strong>? This action cannot be undone.</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Cancel</button>
                    <form id="deleteForm" method="POST" action="">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-danger" style="border-radius: 8px;">Delete Policy</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

            // Handle AJAX Toggle Status
            document.querySelectorAll('.toggle-status-btn').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const id = btn.getAttribute('data-id');
                    const badge = document.getElementById(`badge-${id}`);
                    
                    try {
                        btn.disabled = true;
                        const response = await fetch(`/admin/policies/toggle-status/${id}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'x-csrf-token': csrfToken
                            }
                        });
                        
                        const result = await response.json();
                        if (result.success) {
                            if (result.newStatus === 'published') {
                                badge.textContent = 'Published';
                                badge.className = 'badge status-badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5';
                            } else {
                                badge.textContent = 'Draft';
                                badge.className = 'badge status-badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1.5';
                            }
                        } else {
                            alert('Error: ' + result.message);
                        }
                    } catch (error) {
                        console.error('Error toggling status:', error);
                        alert('Failed to update status. Please try again.');
                    } finally {
                        btn.disabled = false;
                    }
                });
            });

            // Handle Delete Modal
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            const deleteForm = document.getElementById('deleteForm');
            const deletePolicyTitle = document.getElementById('deletePolicyTitle');

            document.querySelectorAll('.delete-policy-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = btn.getAttribute('data-id');
                    const title = btn.getAttribute('data-title');
                    
                    deletePolicyTitle.textContent = title;
                    deleteForm.action = `/admin/policies/delete/${id}`;
                    deleteModal.show();
                });
            });
        });
    </script>
</body>
</html>
