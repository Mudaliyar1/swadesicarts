<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    
    <%- include('../../partials/admin-sidebar') %>

    <div class="admin-content">
        <div class="container-fluid p-4">
            <h2 class="fw-bold mb-4">Inquiries Management</h2>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <form method="GET" class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select">
                                <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All</option>
                                <option value="new" <%= filters.status === 'new' ? 'selected' : '' %>>New</option>
                                <option value="contacted" <%= filters.status === 'contacted' ? 'selected' : '' %>>Contacted</option>
                                <option value="closed" <%= filters.status === 'closed' ? 'selected' : '' %>>Closed</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Product Type</label>
                            <select name="productType" class="form-select">
                                <option value="all" <%= filters.productType === 'all' ? 'selected' : '' %>>All</option>
                                <option value="seasonal" <%= filters.productType === 'seasonal' ? 'selected' : '' %>>Seasonal</option>
                                <option value="tech" <%= filters.productType === 'tech' ? 'selected' : '' %>>Tech</option>
                                <option value="organic" <%= filters.productType === 'organic' ? 'selected' : '' %>>Organic</option>
                                <option value="general" <%= filters.productType === 'general' ? 'selected' : '' %>>General</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">From Date</label>
                            <input type="date" name="fromDate" class="form-control" value="<%= filters.fromDate || '' %>">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">To Date</label>
                            <input type="date" name="toDate" class="form-control" value="<%= filters.toDate || '' %>">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-swadesi w-100">
                                <i class="bi bi-filter"></i> Filter
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <% if (inquiries.length === 0) { %>
                        <p class="text-center text-muted py-4">No inquiries found</p>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Name</th>
                                        <th>Contact</th>
                                        <th>Type</th>
                                        <th>Product</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% inquiries.forEach(inquiry => { %>
                                    <tr>
                                        <td><%= new Date(inquiry.createdAt).toLocaleDateString() %></td>
                                        <td><%= inquiry.name %></td>
                                        <td>
                                            <%= inquiry.mobile %><br>
                                            <small class="text-muted"><%= inquiry.email %></small>
                                        </td>
                                        <td><span class="badge bg-secondary"><%= inquiry.productType %></span></td>
                                        <td>
                                            <% if (inquiry.productType === 'general') { %>
                                                <span class="text-muted">General Inquiry</span>
                                            <% } else { %>
                                                <%= inquiry.productTitle || 'N/A' %>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (inquiry.status === 'new') { %>
                                                <span class="badge bg-danger">New</span>
                                            <% } else if (inquiry.status === 'contacted') { %>
                                                <span class="badge bg-warning">Contacted</span>
                                            <% } else { %>
                                                <span class="badge bg-success">Closed</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/admin/inquiries/<%= inquiry._id %>" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="/admin/inquiries/<%= inquiry._id %>/pdf" class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-file-pdf"></i>
                                            </a>
                                            <button onclick="confirmDelete('<%= inquiry._id %>', 'inquiry', '/admin/inquiries/<%= inquiry._id %>')" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin.js"></script>
</body>
</html>
