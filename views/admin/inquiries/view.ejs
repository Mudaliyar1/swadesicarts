<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    
    <%- include('../../partials/admin-sidebar') %>

    <div class="admin-content">
        <div class="container-fluid p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <h2 class="fw-bold mb-0">Inquiry Details</h2>
                <div class="d-flex gap-2 flex-wrap">
                    <% if (productUrl) { %>
                        <a href="<%= productUrl %>" target="_blank" class="btn btn-success">
                            <i class="bi bi-eye"></i> View Product
                        </a>
                    <% } %>
                    <a href="/admin/inquiries/<%= inquiry._id %>/pdf" class="btn btn-info">
                        <i class="bi bi-file-pdf"></i> Download PDF
                    </a>
                    <a href="/admin/inquiries" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Inquiry Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Date Received</label>
                                    <p class="fw-bold"><%= new Date(inquiry.createdAt).toLocaleString() %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Product Type</label>
                                    <p><span class="badge bg-secondary"><%= inquiry.productType %></span></p>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="text-muted small">Related Product/Package</label>
                                <% if (inquiry.productType === 'general') { %>
                                    <p class="fw-bold">General Inquiry</p>
                                <% } else if (product) { %>
                                    <!-- PRODUCT CARD -->
                                    <div class="border rounded-3 overflow-hidden mt-2" style="background: #f8f9fa;">
                                        <div class="d-flex gap-0">
                                            <!-- Product Image -->
                                            <div style="width: 120px; min-width: 120px; height: 120px; overflow: hidden; background: #e9ecef;">
                                                <% if (product.featuredImage && product.featuredImage.url) { %>
                                                    <img src="<%= product.featuredImage.url %>" alt="<%= product.title %>" style="width: 100%; height: 100%; object-fit: cover;">
                                                <% } else { %>
                                                    <div class="d-flex align-items-center justify-content-center h-100">
                                                        <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <!-- Product Info -->
                                            <div class="p-3 flex-grow-1">
                                                <div class="d-flex align-items-start justify-content-between gap-2">
                                                    <div>
                                                        <h6 class="fw-bold mb-1"><%= product.title %></h6>
                                                        <span class="badge bg-secondary mb-1"><%= product.category %></span>
                                                        <span class="badge ms-1" style="background: <%= inquiry.productType === 'tech' ? '#0d6efd' : inquiry.productType === 'organic' ? '#198754' : '#fd7e14' %>;">
                                                            <%= inquiry.productType.toUpperCase() %>
                                                        </span>
                                                        <div class="mt-1">
                                                            <% if (product.price) { %>
                                                                <% if (inquiry.productType === 'tech' && product.price.displayText) { %>
                                                                    <small class="text-success fw-bold"><%= product.price.displayText %></small>
                                                                <% } else { %>
                                                                    <small class="text-success fw-bold">₹<%= product.price %><% if (product.priceUnit) { %> / <%= product.priceUnit %><% } %></small>
                                                                <% } %>
                                                            <% } %>
                                                            <% if (product.inStock !== undefined) { %>
                                                                <small class="ms-2 badge <%= product.inStock ? 'bg-success' : 'bg-warning' %>">
                                                                    <%= product.inStock ? 'In Stock' : 'Out of Stock' %>
                                                                </small>
                                                            <% } %>
                                                        </div>
                                                        <% if (product.shortDescription) { %>
                                                            <p class="text-muted small mt-1 mb-0" style="font-size: 0.8rem; line-height: 1.4;"><%= product.shortDescription.substring(0, 80) %><%= product.shortDescription.length > 80 ? '...' : '' %></p>
                                                        <% } %>
                                                    </div>
                                                </div>
                                                <div class="d-flex gap-2 mt-2">
                                                    <% if (productUrl) { %>
                                                        <a href="<%= productUrl %>" target="_blank" class="btn btn-sm btn-outline-success">
                                                            <i class="bi bi-eye"></i> View Live
                                                        </a>
                                                    <% } %>
                                                    <% if (adminEditUrl) { %>
                                                        <a href="<%= adminEditUrl %>" class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-pencil"></i> Edit Product
                                                        </a>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <p class="fw-bold"><%= inquiry.productTitle || 'N/A' %></p>
                                <% } %>
                            </div>

                            <hr>

                            <h6 class="fw-bold mb-3">Customer Details</h6>
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="text-muted small">Name</label>
                                    <p class="fw-bold"><%= inquiry.name %></p>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small">Mobile</label>
                                    <p class="fw-bold"><%= inquiry.mobile %></p>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small">Email</label>
                                    <p class="fw-bold"><%= inquiry.email %></p>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="text-muted small">Requirement</label>
                                <p style="white-space: pre-wrap;"><%= inquiry.requirement %></p>
                            </div>

                            <% if (inquiry.adminNotes) { %>
                            <div class="alert alert-info">
                                <strong>Admin Notes:</strong><br>
                                <%= inquiry.adminNotes %>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Update Status</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Current Status</label>
                                <% if (inquiry.status === 'new') { %>
                                    <p><span class="badge bg-danger fs-6">New</span></p>
                                <% } else if (inquiry.status === 'contacted') { %>
                                    <p><span class="badge bg-warning fs-6">Contacted</span></p>
                                <% } else { %>
                                    <p><span class="badge bg-success fs-6">Closed</span></p>
                                <% } %>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Change Status To</label>
                                <select class="form-select" id="statusSelect">
                                    <option value="new" <%= inquiry.status === 'new' ? 'selected' : '' %>>New</option>
                                    <option value="contacted" <%= inquiry.status === 'contacted' ? 'selected' : '' %>>Contacted</option>
                                    <option value="closed" <%= inquiry.status === 'closed' ? 'selected' : '' %>>Closed</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Admin Notes</label>
                                <textarea class="form-control" id="adminNotes" rows="4"><%= inquiry.adminNotes || '' %></textarea>
                            </div>

                            <button onclick="updateInquiryStatus('<%= inquiry._id %>', document.getElementById('statusSelect').value)" class="btn btn-swadesi w-100">
                                <i class="bi bi-check-circle"></i> Update Status
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin.js"></script>
</body>
</html>
