<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Reviews - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
    <style>
        .filter-card {
            background-color: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 16px;
        }
        .table-card {
            background-color: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 16px;
            overflow: hidden;
        }
        .bulk-action-bar {
            background-color: #f8fafc;
            border-bottom: 1px solid rgba(0, 0, 0, 0.08);
            padding: 12px 24px;
            display: none;
            align-items: center;
            justify-content: space-between;
        }
    </style>
</head>
<body class="admin-body">
    <%- include('../../partials/admin-sidebar') %>
    <div class="admin-content">
        <div class="container-fluid p-4">
            
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">Customer Reviews Management</h2>
                    <p class="text-muted mb-0">Moderate ratings, comments, and visibility of reviews on product pages</p>
                </div>
            </div>

            <!-- Notifications -->
            <% if (success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <% if (error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- Search and Filter Panel -->
            <div class="card filter-card shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="reviewSearch" class="form-label fw-semibold text-secondary small">Search Reviews</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" id="reviewSearch" class="form-control bg-light border-start-0 text-dark" placeholder="Search by user or comment...">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label for="filterRating" class="form-label fw-semibold text-secondary small">Rating</label>
                            <select id="filterRating" class="form-select bg-light text-dark">
                                <option value="all">All Stars</option>
                                <option value="5">5 Stars</option>
                                <option value="4">4 Stars</option>
                                <option value="3">3 Stars</option>
                                <option value="2">2 Stars</option>
                                <option value="1">1 Star</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="filterType" class="form-label fw-semibold text-secondary small">Product Type</label>
                            <select id="filterType" class="form-select bg-light text-dark">
                                <option value="all">All Types</option>
                                <option value="ORGANIC">Organic</option>
                                <option value="SEASONAL">Seasonal</option>
                                <option value="TECH">Tech</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="filterVisibility" class="form-label fw-semibold text-secondary small">Visibility</label>
                            <select id="filterVisibility" class="form-select bg-light text-dark">
                                <option value="all">All Visibility</option>
                                <option value="visible">Visible Only</option>
                                <option value="hidden">Hidden Only</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table Card Container -->
            <div class="card table-card shadow-sm">
                <!-- Bulk Actions Control Strip -->
                <div class="bulk-action-bar" id="bulkMenuBar">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill text-primary"></i>
                        <span class="fw-semibold text-dark small" id="selectedCountText">0 reviews selected</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-warning fw-bold px-3 py-1.5 rounded-3" onclick="triggerBulkAction('hide')">
                            <i class="bi bi-eye-slash"></i> Hide Selected
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success fw-bold px-3 py-1.5 rounded-3" onclick="triggerBulkAction('show')">
                            <i class="bi bi-eye"></i> Show Selected
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger fw-bold px-3 py-1.5 rounded-3" onclick="triggerBulkAction('delete')">
                            <i class="bi bi-trash"></i> Delete Selected
                        </button>
                    </div>
                </div>

                <!-- Hidden Bulk Form -->
                <form id="bulkActionForm" action="/admin/reviews/bulk-action" method="POST" style="display: none;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="action" id="bulkActionVal">
                    <div id="bulkSelectedInputsContainer"></div>
                </form>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="reviewsTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4" style="width: 40px;">
                                        <input type="checkbox" class="form-check-input" id="selectAllCheckbox">
                                    </th>
                                    <th>User</th>
                                    <th>Rating</th>
                                    <th>Comment</th>
                                    <th>Product Type</th>
                                    <th>Visibility</th>
                                    <th>Date</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (reviews.length === 0) { %>
                                    <tr>
                                        <td colspan="8" class="text-center py-5">
                                            <i class="bi bi-star text-muted fs-1 d-block mb-3"></i>
                                            <h5 class="text-muted">No reviews found</h5>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% reviews.forEach(r => { %>
                                        <tr class="review-row" 
                                            data-username="<%= r.userName.toLowerCase() %>" 
                                            data-comment="<%= r.comment.toLowerCase() %>" 
                                            data-rating="<%= r.rating %>" 
                                            data-type="<%= r.productType.toUpperCase() %>" 
                                            data-visibility="<%= r.isHidden ? 'hidden' : 'visible' %>">
                                            <td class="ps-4">
                                                <input type="checkbox" class="form-check-input review-row-checkbox" value="<%= r._id %>">
                                            </td>
                                            <td class="fw-medium text-dark"><%= r.userName %></td>
                                            <td>
                                                <span class="text-warning">
                                                    <% for(let i = 1; i <= 5; i++) { %>
                                                        <i class="bi bi-star<%= i <= r.rating ? '-fill' : '' %>"></i>
                                                    <% } %>
                                                </span>
                                                <span class="visually-hidden"><%= r.rating %></span>
                                            </td>
                                            <td>
                                                <div class="text-muted small text-truncate" style="max-width: 250px;">
                                                    <%= r.comment %>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary px-2.5 py-1 text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.3px;"><%= r.productType %></span>
                                            </td>
                                            <td>
                                                <% if (r.isHidden) { %>
                                                    <span class="badge bg-danger rounded-pill px-3">Hidden</span>
                                                <% } else { %>
                                                    <span class="badge bg-success rounded-pill px-3">Visible</span>
                                                <% } %>
                                            </td>
                                            <td class="small text-muted"><%= new Date(r.createdAt).toLocaleDateString() %></td>
                                            <td class="text-end pe-4">
                                                <div class="d-flex justify-content-end gap-2">
                                                    <!-- View Details Button -->
                                                    <button type="button" class="btn btn-sm btn-outline-primary px-2.5 py-1 rounded-3 view-review-btn" 
                                                            data-username="<%= r.userName %>" 
                                                            data-rating="<%= r.rating %>" 
                                                            data-comment="<%= r.comment %>" 
                                                            data-type="<%= r.productType.toUpperCase() %>" 
                                                            data-visibility="<%= r.isHidden ? 'Hidden' : 'Visible' %>" 
                                                            data-date="<%= new Date(r.createdAt).toLocaleString() %>">
                                                        <i class="bi bi-eye"></i> View
                                                    </button>

                                                    <!-- Toggle Visibility Button -->
                                                    <form action="/admin/reviews/<%= r._id %>/toggle-hide" method="POST" class="d-inline">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-sm <%= r.isHidden ? 'btn-outline-success' : 'btn-outline-warning' %> px-2.5 py-1 rounded-3" 
                                                                title="<%= r.isHidden ? 'Unhide/Show Review' : 'Hide Review' %>">
                                                            <i class="bi <%= r.isHidden ? 'bi-eye-fill' : 'bi-eye-slash-fill' %>"></i>
                                                            <%= r.isHidden ? 'Show' : 'Hide' %>
                                                        </button>
                                                    </form>
                                                    
                                                    <!-- Delete Button -->
                                                    <form action="/admin/reviews/<%= r._id %>?_method=DELETE" method="POST" class="d-inline"
                                                          onsubmit="return confirm('Are you sure you want to delete this review permanently? This action cannot be undone.');">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger px-2.5 py-1 rounded-3" title="Delete Review">
                                                            <i class="bi bi-trash"></i> Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Review Details Popup Modal -->
    <div class="modal fade" id="viewReviewModal" tabindex="-1" aria-labelledby="viewReviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 550px;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; background: #ffffff !important; overflow: hidden; font-family: 'Inter', sans-serif;">
                <div class="modal-header border-bottom px-4 py-3" style="border-color: rgba(0, 0, 0, 0.08) !important; background-color: #fafafa !important;">
                    <h5 class="modal-title fw-bold text-dark" id="viewReviewModalLabel" style="font-family: 'Poppins', sans-serif; letter-spacing: -0.3px;">
                        Customer Review Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-4 text-dark">
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <span class="text-secondary small fw-semibold d-block">User Name</span>
                            <span class="fw-bold" id="modalUsername" style="font-size: 1.05rem;"></span>
                        </div>
                        <div class="col-6">
                            <span class="text-secondary small fw-semibold d-block">Rating</span>
                            <div class="text-warning fs-6" id="modalStars"></div>
                        </div>
                        <div class="col-6">
                            <span class="text-secondary small fw-semibold d-block">Product Type</span>
                            <span class="badge bg-secondary px-2.5 py-1 text-uppercase" id="modalType" style="font-size: 0.72rem;"></span>
                        </div>
                        <div class="col-6">
                            <span class="text-secondary small fw-semibold d-block">Visibility</span>
                            <span class="badge px-3 py-1 rounded-pill" id="modalVisibility" style="font-size: 0.75rem;"></span>
                        </div>
                        <div class="col-12">
                            <span class="text-secondary small fw-semibold d-block">Submitted On</span>
                            <span class="text-secondary small" id="modalDate"></span>
                        </div>
                    </div>
                    <div class="p-3 bg-light rounded-3 border" style="border-color: rgba(0,0,0,0.06) !important;">
                        <span class="text-secondary small fw-semibold d-block mb-2">Comment/Review Content</span>
                        <p class="mb-0 text-dark" id="modalComment" style="font-size: 0.9rem; line-height: 1.5; white-space: pre-wrap; word-wrap: break-word; word-break: break-word;"></p>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3" style="border-color: rgba(0, 0, 0, 0.08) !important; background-color: #fafafa !important;">
                    <button type="button" class="btn btn-dark btn-sm fw-bold px-4 py-2 rounded-3" data-bs-dismiss="modal" style="background-color: #111111 !important; color: #ffffff !important; border: none !important;">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // ─── Filter & Search Logic ───
            const searchInput = document.getElementById('reviewSearch');
            const ratingFilter = document.getElementById('filterRating');
            const typeFilter = document.getElementById('filterType');
            const visibilityFilter = document.getElementById('filterVisibility');
            const rows = document.querySelectorAll('.review-row');

            function applyFilters() {
                const searchVal = searchInput.value.toLowerCase().trim();
                const ratingVal = ratingFilter.value;
                const typeVal = typeFilter.value;
                const visibilityVal = visibilityFilter.value;

                rows.forEach(row => {
                    const username = row.getAttribute('data-username');
                    const comment = row.getAttribute('data-comment');
                    const rating = row.getAttribute('data-rating');
                    const type = row.getAttribute('data-type');
                    const visibility = row.getAttribute('data-visibility');

                    const matchesSearch = username.includes(searchVal) || comment.includes(searchVal);
                    const matchesRating = ratingVal === 'all' || rating === ratingVal;
                    const matchesType = typeVal === 'all' || type === typeVal;
                    const matchesVisibility = visibilityVal === 'all' || visibility === visibilityVal;

                    if (matchesSearch && matchesRating && matchesType && matchesVisibility) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                        // Uncheck hidden rows so they aren't accidentally bulk acted
                        const checkbox = row.querySelector('.review-row-checkbox');
                        if (checkbox && checkbox.checked) {
                            checkbox.checked = false;
                        }
                    }
                });
                updateBulkMenuBar();
            }

            searchInput.addEventListener('input', applyFilters);
            ratingFilter.addEventListener('change', applyFilters);
            typeFilter.addEventListener('change', applyFilters);
            visibilityFilter.addEventListener('change', applyFilters);

            // ─── Bulk Action Logic ───
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const rowCheckboxes = document.querySelectorAll('.review-row-checkbox');
            const bulkMenuBar = document.getElementById('bulkMenuBar');
            const selectedCountText = document.getElementById('selectedCountText');

            function updateBulkMenuBar() {
                // Get checked checkboxes that belong to visible rows
                const visibleCheckboxes = Array.from(rowCheckboxes).filter(cb => {
                    const row = cb.closest('tr');
                    return row.style.display !== 'none';
                });
                const checkedVisible = visibleCheckboxes.filter(cb => cb.checked);

                if (checkedVisible.length > 0) {
                    bulkMenuBar.style.display = 'flex';
                    selectedCountText.textContent = `${checkedVisible.length} review${checkedVisible.length > 1 ? 's' : ''} selected`;
                    // Update main selectAll checkbox status
                    selectAllCheckbox.checked = visibleCheckboxes.length === checkedVisible.length;
                    selectAllCheckbox.indeterminate = checkedVisible.length > 0 && checkedVisible.length < visibleCheckboxes.length;
                } else {
                    bulkMenuBar.style.display = 'none';
                    selectAllCheckbox.checked = false;
                    selectAllCheckbox.indeterminate = false;
                }
            }

            // Click select all
            selectAllCheckbox.addEventListener('change', function() {
                const checked = selectAllCheckbox.checked;
                rowCheckboxes.forEach(cb => {
                    const row = cb.closest('tr');
                    // Only toggle checkboxes for visible rows
                    if (row.style.display !== 'none') {
                        cb.checked = checked;
                    }
                });
                updateBulkMenuBar();
            });

            // Click individual rows checkbox
            rowCheckboxes.forEach(cb => {
                cb.addEventListener('change', updateBulkMenuBar);
            });

            window.triggerBulkAction = function(action) {
                const checkedIds = Array.from(rowCheckboxes)
                    .filter(cb => cb.checked && cb.closest('tr').style.display !== 'none')
                    .map(cb => cb.value);

                if (checkedIds.length === 0) return;

                const confirmMsg = `Are you sure you want to ${action} the ${checkedIds.length} selected reviews?`;
                if (!confirm(confirmMsg)) return;

                // Populate form inputs
                document.getElementById('bulkActionVal').value = action;
                const container = document.getElementById('bulkSelectedInputsContainer');
                container.innerHTML = ''; // clear

                checkedIds.forEach(id => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'reviewIds';
                    input.value = id;
                    container.appendChild(input);
                });

                document.getElementById('bulkActionForm').submit();
            };

            // ─── View Review Details Modal ───
            const viewModalEl = document.getElementById('viewReviewModal');
            if (viewModalEl) {
                const viewModal = new bootstrap.Modal(viewModalEl);
                const modalUsername = document.getElementById('modalUsername');
                const modalStars = document.getElementById('modalStars');
                const modalType = document.getElementById('modalType');
                const modalVisibility = document.getElementById('modalVisibility');
                const modalDate = document.getElementById('modalDate');
                const modalComment = document.getElementById('modalComment');

                document.querySelectorAll('.view-review-btn').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const user = btn.getAttribute('data-username');
                        const rating = parseInt(btn.getAttribute('data-rating')) || 5;
                        const comment = btn.getAttribute('data-comment');
                        const type = btn.getAttribute('data-type');
                        const visibility = btn.getAttribute('data-visibility');
                        const date = btn.getAttribute('data-date');

                        modalUsername.textContent = user;
                        modalType.textContent = type;
                        modalDate.textContent = date;
                        modalComment.textContent = comment;

                        // Star ratings builder
                        modalStars.innerHTML = '';
                        for (let i = 1; i <= 5; i++) {
                            const starIcon = document.createElement('i');
                            starIcon.className = `bi bi-star${i <= rating ? '-fill' : ''} me-0.5`;
                            modalStars.appendChild(starIcon);
                        }

                        // Visibility label builder
                        modalVisibility.textContent = visibility;
                        if (visibility === 'Visible') {
                            modalVisibility.className = 'badge bg-success rounded-pill px-3 py-1';
                        } else {
                            modalVisibility.className = 'badge bg-danger rounded-pill px-3 py-1';
                        }

                        viewModal.show();
                    });
                });
            }
        });
    </script>
</body>
</html>
