<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Support Tickets - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    <%- include('../../partials/admin-sidebar') %>
    <div class="admin-content">
        <div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="h3 mb-0 text-gray-800"><i class="bi bi-headset text-primary me-2"></i>Support Tickets</h2>
    </div>

    <% if (locals.success && locals.success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= locals.success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (locals.error && locals.error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= locals.error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Filter Form -->
    <div class="card shadow mb-4">
      <div class="card-body">
        <form action="/admin/tickets" method="GET">
          <div class="row g-3 align-items-end">
            <!-- Search -->
            <div class="col-12 col-md-6 col-lg-3">
              <label for="search" class="form-label text-muted small fw-bold mb-1">Search Keyword</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" id="search" class="form-control border-start-0 ps-0" placeholder="ID, Name, Email..." value="<%= locals.currentSearch || '' %>">
              </div>
            </div>
            
            <!-- Status -->
            <div class="col-12 col-md-6 col-lg-3">
              <label for="status" class="form-label text-muted small fw-bold mb-1">Status</label>
              <select name="status" id="status" class="form-select">
                <option value="all" <%= currentStatus === 'all' ? 'selected' : '' %>>All Statuses</option>
                <option value="open" <%= currentStatus === 'open' ? 'selected' : '' %>>Open</option>
                <option value="pending" <%= currentStatus === 'pending' ? 'selected' : '' %>>Pending</option>
                <option value="resolved" <%= currentStatus === 'resolved' ? 'selected' : '' %>>Resolved</option>
                <option value="closed" <%= currentStatus === 'closed' ? 'selected' : '' %>>Closed</option>
              </select>
            </div>

            <!-- Start Date -->
            <div class="col-12 col-md-6 col-lg-2">
              <label for="startDate" class="form-label text-muted small fw-bold mb-1">From Date</label>
              <input type="date" name="startDate" id="startDate" class="form-control" value="<%= locals.currentStartDate || '' %>">
            </div>

            <!-- End Date -->
            <div class="col-12 col-md-6 col-lg-2">
              <label for="endDate" class="form-label text-muted small fw-bold mb-1">To Date</label>
              <input type="date" name="endDate" id="endDate" class="form-control" value="<%= locals.currentEndDate || '' %>">
            </div>

            <!-- Actions -->
            <div class="col-12 col-lg-2 d-flex gap-2">
              <button type="submit" class="btn btn-primary flex-grow-1 fw-bold"><i class="bi bi-funnel-fill me-1"></i> Filter</button>
              <a href="/admin/tickets" class="btn btn-outline-secondary fw-bold" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="card shadow mb-4">
      <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Ticket Directory</h6>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Ticket #</th>
                <th>Status</th>
                <th>Name</th>
                <th>Email</th>
                <th>Subject</th>
                <th>Last Update</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (tickets && tickets.length > 0) { %>
                <% tickets.forEach(ticket => { %>
                  <tr>
                    <td><span class="badge bg-secondary"><%= ticket.ticketNumber %></span></td>
                    <td>
                        <span class="badge bg-<%= ticket.status === 'open' ? 'primary' : (ticket.status === 'pending' ? 'warning text-dark' : (ticket.status === 'resolved' ? 'success' : 'secondary')) %>">
                            <%= ticket.status.toUpperCase() %>
                        </span>
                    </td>
                    <td><%= ticket.user ? ticket.user.name : ticket.name %></td>
                    <td><%= ticket.user ? ticket.user.email : ticket.email %></td>
                    <td>
                      <div style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        <%= ticket.subject %>
                      </div>
                    </td>
                    <td><%= ticket.updatedAt.toLocaleDateString() %> <%= ticket.updatedAt.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></td>
                    <td>
                      <a href="/admin/tickets/<%= ticket.ticketNumber %>" class="btn btn-sm btn-primary">
                        <i class="bi bi-eye"></i> View & Reply
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    No tickets found matching the selected filter.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin.js"></script>
</body>
</html>
