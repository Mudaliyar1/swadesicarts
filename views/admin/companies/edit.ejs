<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    
    <%- include('../../partials/admin-sidebar') %>

    <div class="admin-content">
        <div class="container-fluid p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold mb-1"><i class="bi bi-building"></i> Edit Company</h2>
                    <p class="text-muted mb-0">Update the company card shown on the homepage</p>
                </div>
                <a href="/admin/companies" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
            </div>

            <% if (error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form action="/admin/companies/edit/<%= company._id %>" method="POST" enctype="multipart/form-data">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Company Name *</label>
                                <input type="text" class="form-control" name="name" value="<%= company.name %>" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Website URL</label>
                                <input type="url" class="form-control" name="websiteUrl" value="<%= company.websiteUrl || '' %>" placeholder="https://example.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Current Logo</label>
                                <div class="border rounded-4 p-3 bg-light text-center mb-3">
                                    <% if (company.logo && company.logo.url) { %>
                                        <img src="<%= company.logo.url %>" alt="<%= company.name %> logo" style="max-width: 220px; max-height: 120px; object-fit: contain;">
                                    <% } else { %>
                                        <div class="text-muted">No logo uploaded</div>
                                    <% } %>
                                </div>
                                <label class="form-label fw-bold">Replace Logo</label>
                                <input type="file" class="form-control" name="logo" accept="image/*" onchange="previewLogo(event)">
                                <small class="text-muted">Leave blank to keep the current logo.</small>
                                <div id="logoPreview" class="mt-3"></div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch mt-4 pt-2">
                                    <input class="form-check-input" type="checkbox" id="isFeatured" name="isFeatured" <%= company.isFeatured ? 'checked' : '' %>>
                                    <label class="form-check-label fw-bold" for="isFeatured">Featured Status</label>
                                </div>
                                <div class="form-check form-switch mt-3">
                                    <input class="form-check-input" type="checkbox" id="isVisible" name="isVisible" <%= company.isVisible ? 'checked' : '' %>>
                                    <label class="form-check-label fw-bold" for="isVisible">Visible on Website</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Short Description</label>
                                <textarea class="form-control" name="shortDescription" rows="3"><%= company.shortDescription || '' %></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Full Description</label>
                                <textarea class="form-control" name="fullDescription" rows="6"><%= company.fullDescription || '' %></textarea>
                            </div>
                            <div class="col-12 d-flex gap-2 justify-content-end">
                                <a href="/admin/companies" class="btn btn-outline-secondary">Cancel</a>
                                <button type="submit" class="btn btn-swadesi"><i class="bi bi-check-circle"></i> Update Company</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin.js"></script>
    <script>
        function previewLogo(event) {
            const input = event.target;
            const preview = document.getElementById('logoPreview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.innerHTML = `<img src="${e.target.result}" alt="Logo preview" style="max-width: 220px; max-height: 120px; object-fit: contain; border: 1px solid #e9ecef; border-radius: 12px; padding: 12px; background: #fff;">`;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>
</html>