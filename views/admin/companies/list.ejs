<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    
    <%- include('../../partials/admin-sidebar') %>

    <div class="admin-content">
        <div class="container-fluid p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold mb-1"><i class="bi bi-building"></i> Companies We Worked With</h2>
                    <p class="text-muted mb-0">Manage trusted partners shown on the homepage</p>
                </div>
                <a href="/admin/companies/create" class="btn btn-swadesi">
                    <i class="bi bi-plus-circle"></i> Add Company
                </a>
            </div>

            <% if (success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <% if (!companies || companies.length === 0) { %>
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-building" style="font-size: 3rem; opacity: 0.4;"></i>
                            <p class="mt-3 mb-0">No companies added yet. Click "Add Company" to create one.</p>
                        </div>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table align-middle table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Logo</th>
                                        <th>Name</th>
                                        <th>Website</th>
                                        <th>Featured</th>
                                        <th>Visible</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% companies.forEach(company => { %>
                                        <tr>
                                            <td style="width: 90px;">
                                                <% if (company.logo && company.logo.url) { %>
                                                    <img src="<%= company.logo.url %>" alt="<%= company.name %> logo" style="width: 64px; height: 64px; object-fit: contain; border-radius: 14px; background: #fff; padding: 8px; border: 1px solid #eef2f7;">
                                                <% } else { %>
                                                    <div style="width: 64px; height: 64px; border-radius: 14px; background: #f1f3f5; display: flex; align-items: center; justify-content: center;">
                                                        <i class="bi bi-building text-muted"></i>
                                                    </div>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="fw-bold"><%= company.name %></div>
                                                <% if (company.shortDescription) { %>
                                                    <div class="text-muted small"><%= company.shortDescription %></div>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (company.websiteUrl) { %>
                                                    <a href="<%= company.websiteUrl %>" target="_blank" rel="noopener"><%= company.websiteUrl.replace(/^https?:\/\//i, '') %></a>
                                                <% } else { %>
                                                    <span class="text-muted">No website</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <span class="badge <%= company.isFeatured ? 'bg-warning text-dark' : 'bg-secondary' %>"><%= company.isFeatured ? 'Featured' : 'Normal' %></span>
                                            </td>
                                            <td>
                                                <span class="badge <%= company.isVisible ? 'bg-success' : 'bg-secondary' %>"><%= company.isVisible ? 'Visible' : 'Hidden' %></span>
                                            </td>
                                            <td><%= new Date(company.createdAt).toLocaleDateString() %></td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="/admin/companies/edit/<%= company._id %>" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                                    <button type="button" class="btn btn-outline-warning toggle-featured-btn" data-id="<%= company._id %>" title="Toggle Featured">
                                                        <i class="bi bi-star<%= company.isFeatured ? '-fill' : '' %>"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-info toggle-visibility-btn" data-id="<%= company._id %>" title="Toggle Visibility">
                                                        <i class="bi bi-eye<%= company.isVisible ? '-slash' : '' %>"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger delete-btn" data-id="<%= company._id %>" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin.js"></script>
    <script>
        document.querySelectorAll('.delete-btn').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                if (!confirm('Delete this company? This will remove the logo from Cloudinary too.')) {
                    return;
                }

                try {
                    const response = await fetch(`/admin/companies/delete/${this.dataset.id}`, {
                        method: 'DELETE'
                    });
                    const data = await response.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Error deleting company');
                    }
                } catch (error) {
                    console.error(error);
                    alert('Error deleting company');
                }
            });
        });

        document.querySelectorAll('.toggle-visibility-btn').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                try {
                    const response = await fetch(`/admin/companies/${this.dataset.id}/toggle-visibility`, {
                        method: 'POST'
                    });
                    const data = await response.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Error updating visibility');
                    }
                } catch (error) {
                    console.error(error);
                    alert('Error updating visibility');
                }
            });
        });

        document.querySelectorAll('.toggle-featured-btn').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                try {
                    const response = await fetch(`/admin/companies/${this.dataset.id}/toggle-featured`, {
                        method: 'POST'
                    });
                    const data = await response.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Error updating featured status');
                    }
                } catch (error) {
                    console.error(error);
                    alert('Error updating featured status');
                }
            });
        });
    </script>
</body>
</html>