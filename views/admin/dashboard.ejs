<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    
    <%- include('../partials/admin-sidebar') %>

    <div class="admin-content">
        <div class="container-fluid p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">Dashboard</h2>
                <span class="text-muted">Welcome, <%= adminName %></span>
            </div>

            <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #4C1E4F, #6B2E6F); color: #fff;">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h5 class="fw-bold mb-1 text-white">Website Editor</h5>
                        <p class="mb-0 text-white-50">Open the live preview editor to select any element and restyle it across the site.</p>
                    </div>
                    <a href="/admin/site-editor" class="btn btn-light fw-semibold"><i class="bi bi-cursor"></i> Open Editor</a>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1 small">Seasonal Products</p>
                                    <h3 class="fw-bold mb-0"><%= stats.seasonalProducts %></h3>
                                </div>
                                <div class="stat-icon bg-primary">
                                    <i class="bi bi-calendar3"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1 small">Tech Packages</p>
                                    <h3 class="fw-bold mb-0"><%= stats.techPackages %></h3>
                                </div>
                                <div class="stat-icon bg-info">
                                    <i class="bi bi-laptop"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1 small">Organic Products</p>
                                    <h3 class="fw-bold mb-0"><%= stats.organicProducts %></h3>
                                </div>
                                <div class="stat-icon bg-success">
                                    <i class="bi bi-flower2"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm stat-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="text-muted mb-1 small">Total Inquiries</p>
                                    <h3 class="fw-bold mb-0"><%= stats.totalInquiries %></h3>
                                </div>
                                <div class="stat-icon bg-warning">
                                    <i class="bi bi-chat-dots"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <a href="/admin/stories" style="text-decoration: none;">
                        <div class="card border-0 shadow-sm stat-card" style="height: 100%; cursor: pointer; transition: all 0.3s ease;">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 small">Stories</p>
                                        <h3 class="fw-bold mb-0"><%= stats.stories || 0 %></h3>
                                    </div>
                                    <div class="stat-icon bg-danger">
                                        <i class="bi bi-images"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Inquiry Stats -->
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h6 class="text-muted mb-2">New Inquiries</h6>
                            <h2 class="fw-bold text-danger"><%= stats.newInquiries %></h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h6 class="text-muted mb-2">Contacted</h6>
                            <h2 class="fw-bold text-warning"><%= stats.contactedInquiries %></h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h6 class="text-muted mb-2">Closed</h6>
                            <h2 class="fw-bold text-success"><%= stats.closedInquiries %></h2>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Inquiries -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0 fw-bold">Recent Inquiries</h5>
                </div>
                <div class="card-body p-0">
                    <% if (recentInquiries.length === 0) { %>
                        <p class="text-center text-muted py-4">No inquiries yet</p>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Product Type</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentInquiries.forEach(inquiry => { %>
                                    <tr>
                                        <td><%= inquiry.name %></td>
                                        <td><span class="badge bg-secondary"><%= inquiry.productType %></span></td>
                                        <td>
                                            <% if (inquiry.status === 'new') { %>
                                                <span class="badge bg-danger">New</span>
                                            <% } else if (inquiry.status === 'contacted') { %>
                                                <span class="badge bg-warning">Contacted</span>
                                            <% } else { %>
                                                <span class="badge bg-success">Closed</span>
                                            <% } %>
                                        </td>
                                        <td><%= new Date(inquiry.createdAt).toLocaleDateString() %></td>
                                        <td>
                                            <a href="/admin/inquiries/<%= inquiry._id %>" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin.js"></script>
</body>
</html>
