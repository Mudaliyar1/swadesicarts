<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    
    <%- include('../../partials/admin-sidebar') %>

    <div class="admin-content">
        <div class="container-fluid p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">Organic Products</h2>
                <a href="/admin/organic-products/create" class="btn btn-swadesi"><i class="bi bi-plus-circle"></i> Add Product</a>
            </div>

            <% if (success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Advanced Filters and Search -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <form action="/admin/organic-products" method="GET" id="filterForm" class="row g-2 align-items-center">
                        <input type="hidden" name="page" value="1">
                        
                        <div class="col-md-3">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" class="form-control border-start-0 border-end-0 ps-0" placeholder="Search products..." value="<%= query.search %>">
                                <button type="submit" class="btn btn-swadesi"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div class="col-md-2 col-6">
                            <select name="category" class="form-select" onchange="this.form.submit()">
                                <option value="all">All Categories</option>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
                                <% }); %>
                            </select>
                        </div>

                        <div class="col-md-2 col-6">
                            <select name="status" class="form-select" onchange="this.form.submit()">
                                <option value="">All Statuses</option>
                                <option value="visible" <%= query.status === 'visible' ? 'selected' : '' %>>Visible Only</option>
                                <option value="hidden" <%= query.status === 'hidden' ? 'selected' : '' %>>Hidden Only</option>
                                <option value="inStock" <%= query.status === 'inStock' ? 'selected' : '' %>>In Stock</option>
                                <option value="outOfStock" <%= query.status === 'outOfStock' ? 'selected' : '' %>>Out of Stock</option>
                            </select>
                        </div>

                        <div class="col-md-2 col-6">
                            <select name="sortBy" class="form-select" onchange="this.form.submit()">
                                <option value="order" <%= query.sortBy === 'order' ? 'selected' : '' %>>Sort by Order</option>
                                <option value="title" <%= query.sortBy === 'title' ? 'selected' : '' %>>Sort by Name</option>
                                <option value="price" <%= query.sortBy === 'price' ? 'selected' : '' %>>Sort by Price</option>
                                <option value="date" <%= query.sortBy === 'date' ? 'selected' : '' %>>Sort by Date</option>
                            </select>
                        </div>

                        <div class="col-md-2 col-6">
                            <select name="sortOrder" class="form-select" onchange="this.form.submit()">
                                <option value="asc" <%= query.sortOrder === 'asc' ? 'selected' : '' %>>Ascending</option>
                                <option value="desc" <%= query.sortOrder === 'desc' ? 'selected' : '' %>>Descending</option>
                            </select>
                        </div>

                        <div class="col-md-1">
                            <a href="/admin/organic-products" class="btn btn-outline-secondary w-100" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Bulk Action Header -->
            <div id="bulkActionsBar" class="alert alert-secondary alert-permanent d-none justify-content-between align-items-center mb-3 py-2 px-3 border-0 shadow-sm" style="background: #eef2f3;">
                <div class="d-flex align-items-center">
                    <span id="selectedCountText" class="fw-semibold text-dark me-3">0 items selected</span>
                </div>
                <button onclick="confirmBulkDelete('/admin/organic-products/bulk-delete')" class="btn btn-danger btn-sm">
                    <i class="bi bi-trash-fill me-1"></i> Delete Selected
                </button>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th style="width: 40px;"><input type="checkbox" id="selectAllCheckbox" class="form-check-input"></th>
                                    <th>Image</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Certifications</th>
                                    <th>In Stock</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (products && products.length > 0) { %>
                                    <% products.forEach(product => { %>
                                    <tr id="row-<%= product._id %>">
                                        <td><input type="checkbox" name="selectedIds[]" value="<%= product._id %>" class="form-check-input product-select-checkbox"></td>
                                        <td>
                                            <% if (product.featuredImage && product.featuredImage.url) { %>
                                                <img src="<%= product.featuredImage.url %>" alt="<%= product.title %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px;">
                                            <% } else { %>
                                                <div class="bg-secondary" style="width: 60px; height: 60px; border-radius: 4px;"></div>
                                            <% } %>
                                        </td>
                                        <td>
                                            <strong><%= product.title %></strong><br>
                                            <small class="text-muted"><%= product.shortDescription.substring(0, 50) %>...</small>
                                        </td>
                                        <td><%= product.category %></td>
                                        <td>
                                            <% if (product.certifications && product.certifications.length > 0) { %>
                                                <small><%= product.certifications.map(c => c.name).join(', ').substring(0, 30) %><%= product.certifications.map(c => c.name).join(', ').length > 30 ? '...' : '' %></small>
                                            <% } else { %>
                                                <span class="text-muted">-</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (product.inStock) { %>
                                                <span class="badge bg-success">In Stock</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">Out of Stock</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="/organic-products/<%= product.slug %>" class="btn btn-outline-primary" target="_blank" title="View">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="/admin/organic-products/edit/<%= product._id %>" class="btn btn-outline-warning" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button onclick="confirmDelete('<%= product._id %>', 'product', '/admin/organic-products/<%= product._id %>')" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-5">
                                            <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                                            <p class="mt-3 text-muted">No organic products found. <a href="/admin/organic-products/create">Add your first product</a></p>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Pagination Footer -->
                    <% if (pagination && pagination.totalPages > 1) { %>
                        <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
                            <div class="text-muted small">
                                Showing <%= products.length %> of <%= pagination.totalProducts %> products
                            </div>
                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item <%= !pagination.hasPrevPage ? 'disabled' : '' %>">
                                        <a class="page-link" href="?<%= new URLSearchParams({...query, page: pagination.prevPage}).toString() %>">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                    
                                    <% for(let i = 1; i <= pagination.totalPages; i++) { %>
                                        <li class="page-item <%= pagination.currentPage === i ? 'active' : '' %>">
                                            <a class="page-link" href="?<%= new URLSearchParams({...query, page: i}).toString() %>"><%= i %></a>
                                        </li>
                                    <% } %>
                                    
                                    <li class="page-item <%= !pagination.hasNextPage ? 'disabled' : '' %>">
                                        <a class="page-link" href="?<%= new URLSearchParams({...query, page: pagination.nextPage}).toString() %>">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin.js?v=1.1"></script>
</body>
</html>
